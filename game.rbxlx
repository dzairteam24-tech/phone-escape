        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Builder</string>
          <string name="Source"><![CDATA[-- Builder.luau — يبني عالم اللعبة كاملًا من الكود عند بدء السيرفر:
-- لوبي «شاشة رئيسية» + محطات شحن + 15 مرحلة داخل التطبيقات.
-- البناء يتم في مجلد مؤقت ثم يُستبدل دفعة واحدة (فشل البناء لا يدمر
-- الخريطة المخبوزة الموجودة في المكان).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Builder = {}

local function block(parent, name, size, pos, rgb, mat)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = pos
	p.Anchored = true
	p.Color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	p.Material = mat or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function text(partObj, str, face, rgb)
	local faces = { face }
	if face ~= Enum.NormalId.Top and face ~= Enum.NormalId.Bottom then
		table.insert(faces, face == Enum.NormalId.Front and Enum.NormalId.Back or Enum.NormalId.Front)
	end
	local made
	for _, f in faces do
		local gui = Instance.new("SurfaceGui")
		gui.Face = f
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.Parent = partObj
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = rgb or Color3.new(1, 1, 1)
		tl.TextStrokeTransparency = 0.35
		tl.Text = str
		tl.Parent = gui
		made = made or tl
	end
	return made
end

local function boardText(partObj, title)
	local labels = {}
	for _, f in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = f
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.Parent = partObj
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = Color3.fromRGB(255, 230, 120)
		tl.Text = title
		tl.Parent = gui
		table.insert(labels, tl)
	end
	return labels
end

local function mix(a, b, t)
	return {
		math.floor(a[1] + (b[1] - a[1]) * t + 0.5),
		math.floor(a[2] + (b[2] - a[2]) * t + 0.5),
		math.floor(a[3] + (b[3] - a[3]) * t + 0.5),
	}
end

-- ===== مسار مرحلة واحدة من رموز الخطة =====
local function course(parent, stageIdx, plan, zTop, zBottom, theme)
	local z = zTop
	local n = 0
	local function starAt(x, y, zz)
		n += 1
		local s = block(parent, "Star" .. n, Vector3.new(1.7, 1.7, 1.7), Vector3.new(x, y, zz), { 255, 215, 0 }, Enum.Material.Neon)
		s.Shape = Enum.PartType.Ball
		s:SetAttribute("Star", true)
		s:SetAttribute("StarOf", stageIdx)
	end
	for _, token in plan do
		n += 1
		local kind, arg = string.match(token, "^(%a+):?(%d*)$")
		local len = tonumber(arg) or 0
		local mid = z - len / 2
		if kind == "run" then
			block(parent, "Run" .. n, Vector3.new(16, 1, len), Vector3.new(0, 0, mid), theme.floor)
		elseif kind == "gap" then
			-- هواء فوق أرضية القتل
		elseif kind == "moving" or kind == "movingy" then
			local p = block(parent, "Lift" .. n, Vector3.new(11, 1, 10), Vector3.new(0, 0, mid), theme.accent)
			p:SetAttribute("Move", true)
			p:SetAttribute("Axis", kind == "movingy" and "Y" or "X")
			p:SetAttribute("Range", kind == "movingy" and 3.2 or 7)
			p:SetAttribute("Speed", 1.1)
			p:SetAttribute("Phase", stageIdx * 1.7 + n)
		elseif kind == "vanish" then
			local seg = len / 3
			for k = 1, 3 do
				local p = block(parent, "Blink" .. n .. "_" .. k, Vector3.new(16, 0.8, seg - 1.5), Vector3.new(0, 0, z - (k - 0.5) * seg), { 255, 240, 170 }, Enum.Material.Neon)
				p:SetAttribute("Vanish", (k + stageIdx) % 3)
			end
		elseif kind == "convF" or kind == "convB" then
			local p = block(parent, "Belt" .. n, Vector3.new(16, 1, len), Vector3.new(0, 0, mid), kind == "convF" and { 90, 200, 255 } or { 255, 150, 90 })
			p:SetAttribute("Belt", kind == "convF" and -26 or 18)
		elseif kind == "bounce" then
			for _, f in { 0.3, 0.7 } do
				local iz = z - len * f
				block(parent, "Isle" .. n, Vector3.new(9, 1, 9), Vector3.new(0, 0, iz), theme.floor)
				local p = block(parent, "Pad" .. n, Vector3.new(6, 0.6, 6), Vector3.new(0, 0.8, iz), { 255, 90, 200 }, Enum.Material.Neon)
				p:SetAttribute("Bounce", 68)
			end
		elseif kind == "sweep" then
			block(parent, "SweepFloor" .. n, Vector3.new(16, 1, len), Vector3.new(0, 0, mid), theme.floor)
			block(parent, "SweepPost" .. n, Vector3.new(1.2, 3, 1.2), Vector3.new(0, 1.5, mid), { 60, 60, 70 })
			local arm = block(parent, "Spinner" .. n, Vector3.new(13, 1.1, 1.1), Vector3.new(0, 1.35, mid), { 235, 70, 60 }, Enum.Material.Neon)
			arm:SetAttribute("Sweep", true)
			arm:SetAttribute("SweepSpeed", 1.1 + stageIdx * 0.04)
			arm:SetAttribute("PivotX", 0)
			arm:SetAttribute("PivotZ", mid)
		elseif kind == "narrow" then
			block(parent, "Bridge" .. n .. "a", Vector3.new(4.5, 1, len / 2), Vector3.new(-3.5, 0, z - len / 4), theme.floor)
			block(parent, "Bridge" .. n .. "b", Vector3.new(4.5, 1, len / 2), Vector3.new(3.5, 0, z - 3 * len / 4), theme.floor)
		elseif kind == "tower" then
			for k = 1, 5 do
				block(parent, "Step" .. n .. "_" .. k, Vector3.new(9, 1, 9), Vector3.new(0, k * 2.1 - 1, z - (k - 0.5) * (len / 5)), theme.floor)
			end
		elseif kind == "split" then
			block(parent, "Safe" .. n, Vector3.new(10, 1, len), Vector3.new(-12.5, 0, mid), theme.floor)
			block(parent, "Risk" .. n, Vector3.new(5, 1, len), Vector3.new(13.5, 0, mid), theme.accent)
			for _, f in { 0.25, 0.5, 0.75 } do
				starAt(13.5, 1.6, z - len * f)
			end
		elseif kind == "mid" then
			local p = block(parent, "MidPad", Vector3.new(12, 0.6, 6), Vector3.new(0, 0.3, z - 3), { 120, 255, 140 }, Enum.Material.Neon)
			p:SetAttribute("Mid", stageIdx)
		end
		z -= len
	end
	if z > zBottom then
		block(parent, "Fill", Vector3.new(16, 1, z - zBottom), Vector3.new(0, 0, (z + zBottom) / 2), theme.floor)
	end
end

function Builder.build()
	-- إضاءة وأجواء
	local Lighting = game:GetService("Lighting")
	if not Lighting:FindFirstChild("PhoneBloom") then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "PhoneBloom"
		bloom.Intensity = 0.35
		bloom.Size = 24
		bloom.Threshold = 0.85
		bloom.Parent = Lighting
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "PhoneGrade"
		cc.Saturation = 0.14
		cc.Contrast = 0.05
		cc.Brightness = 0.02
		cc.Parent = Lighting
		local atm = Instance.new("Atmosphere")
		atm.Name = "PhoneAir"
		atm.Density = 0.16
		atm.Color = Color3.fromRGB(215, 230, 255)
		atm.Decay = Color3.fromRGB(160, 200, 255)
		atm.Parent = Lighting
		Lighting.ClockTime = 14.2
	end

	local world = Instance.new("Folder")
	world.Name = "PhoneWorld_Building"
	local icons, built = 0, 0

	-- ================= اللوبي =================
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = world
	block(lobby, "Slab", Vector3.new(150, 1, 130), Vector3.new(0, -0.7, 34), { 22, 22, 34 })

	local screen = Instance.new("Folder")
	screen.Name = "HomeScreen"
	screen.Parent = lobby
	local pitch = Config.TILE + Config.GAP
	local palette = {
		{ 255, 90, 90 }, { 255, 160, 60 }, { 255, 215, 80 }, { 120, 220, 110 },
		{ 70, 200, 190 }, { 80, 160, 255 }, { 150, 110, 255 }, { 255, 110, 190 },
	}
	for r = 1, Config.GRID_ROWS do
		local z = 84 - (r - 1) * pitch
		for c = 1, Config.GRID_COLS do
			local x = (c - (Config.GRID_COLS + 1) / 2) * pitch
			local rgb = palette[((r * 3 + c) % #palette) + 1]
			local tile = block(screen, "Icon_" .. r .. "_" .. c, Vector3.new(Config.TILE, 0.8, Config.TILE), Vector3.new(x, 0.4, z), rgb)
			tile:SetAttribute("Icon", true)
			icons += 1
			local glyph = Config.GLYPHS[((r - 1) * Config.GRID_COLS + (c - 1)) % #Config.GLYPHS + 1]
			text(tile, glyph, Enum.NormalId.Top)
			block(screen, "Face_" .. r .. "_" .. c, Vector3.new(Config.TILE - 1.3, 0.22, Config.TILE - 1.3), Vector3.new(x, 0.91, z), mix(rgb, { 255, 255, 255 }, 0.25))
		end
	end

	-- إطار الهاتف + العنوان
	block(lobby, "BezelBack", Vector3.new(150, 10, 1), Vector3.new(0, 5, 93), { 30, 30, 45 })
	block(lobby, "BezelL", Vector3.new(1, 10, 118), Vector3.new(-71, 5, 34), { 30, 30, 45 })
	block(lobby, "BezelR", Vector3.new(1, 10, 118), Vector3.new(71, 5, 34), { 30, 30, 45 })
	block(lobby, "Trim", Vector3.new(150, 1, 1.4), Vector3.new(0, 10.4, 93), { 90, 230, 255 }, Enum.Material.Neon)
	local title = block(lobby, "Title", Vector3.new(52, 8, 1), Vector3.new(0, 5.5, 92.4), { 40, 40, 55 })
	text(title, "📱 PHONE ESCAPE 📱", Enum.NormalId.Back)

	-- منطقة الظهور
	block(lobby, "HomeBar", Vector3.new(17, 0.3, 17), Vector3.new(0, 0.95, 80), { 210, 210, 220 })
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 1.4, 80)
	spawn.Anchored = true
	spawn.Color = Color3.fromRGB(255, 255, 255)
	spawn.Neutral = true
	spawn.Transparency = 0.4
	spawn.Parent = lobby

	-- لافتات إرشاد
	block(lobby, "SignPost", Vector3.new(0.5, 5, 0.5), Vector3.new(0, 2.5, 30), { 90, 90, 100 })
	local s1 = block(lobby, "Sign1", Vector3.new(20, 4, 0.6), Vector3.new(0, 5.6, 30), { 50, 160, 90 })
	text(s1, "1️⃣ STEP ON APPS = +1 ⚡", Enum.NormalId.Back)
	local s2 = block(lobby, "Sign2", Vector3.new(15, 4, 0.6), Vector3.new(49, 4.5, 82), { 60, 120, 220 })
	text(s2, "🔌 CHARGE HERE ➡", Enum.NormalId.Back)
	local s3 = block(lobby, "Sign3", Vector3.new(20, 4, 0.6), Vector3.new(0, 5.6, -8), { 220, 90, 160 })
	text(s3, "🚪 STAGE 1 — LEVEL 1", Enum.NormalId.Back)

	-- لوحتا الصدارة بجانب بوابة المرحلة 1
	local bl = block(lobby, "BoardTopLevel", Vector3.new(19, 12, 1), Vector3.new(-24, 6.5, -15), { 90, 50, 140 })
	local levelLabels = boardText(bl, "🏆 TOP LEVEL 🏆")
	local bw = block(lobby, "BoardTopWins", Vector3.new(19, 12, 1), Vector3.new(24, 6.5, -15), { 90, 50, 140 })
	local winsLabels = boardText(bw, "🏆 TOP WINS 🏆")

	-- كشك الأدوات (زينة)
	block(lobby, "StallBase", Vector3.new(24, 1, 20), Vector3.new(-56, 0.9, 58), { 120, 80, 170 })
	local stall = block(lobby, "Stall", Vector3.new(18, 8, 12), Vector3.new(-56, 5.4, 60), { 170, 120, 230 })
	block(lobby, "StallRoof", Vector3.new(21, 1, 15), Vector3.new(-56, 9.8, 60), { 90, 50, 160 })
	text(stall, "🛍️ ITEMS", Enum.NormalId.Front)

	-- قوس العالم 2 (إعلان «قريبًا»)
	block(lobby, "ArchL", Vector3.new(3, 13, 3), Vector3.new(50, 6.5, 62), { 90, 90, 100 })
	block(lobby, "ArchR", Vector3.new(3, 13, 3), Vector3.new(62, 6.5, 62), { 90, 90, 100 })
	local arch = block(lobby, "ArchTop", Vector3.new(15, 3, 3), Vector3.new(56, 13.5, 62), { 90, 90, 100 })
	text(arch, "🌍 WORLD 2 — SOON", Enum.NormalId.Front)
	local teaser = block(lobby, "W2Teaser", Vector3.new(10, 0.5, 10), Vector3.new(40, 1.0, 62), { 120, 120, 140 }, Enum.Material.Neon)
	text(teaser, "🔒 WORLD 2\nSOCIAL APPS — SOON", Enum.NormalId.Top)

	-- فقاعات زينة
	local bub = { { 255, 110, 180 }, { 110, 220, 255 }, { 170, 255, 110 }, { 255, 190, 90 } }
	for i, pos in { { -66, 26 }, { 66, 26 }, { -66, 84 }, { 66, 84 } } do
		block(lobby, "Pole" .. i, Vector3.new(0.6, 10, 0.6), Vector3.new(pos[1], 5, pos[2]), { 245, 245, 245 })
		local head = block(lobby, "Bubble" .. i, Vector3.new(5.4, 1.4, 5.4), Vector3.new(pos[1], 10.6, pos[2]), bub[i], Enum.Material.Neon)
		head.Shape = Enum.PartType.Cylinder
		head.Orientation = Vector3.new(0, 0, 90)
	end

	-- منصة محطات الشحن (يمين)
	block(lobby, "StationDeck", Vector3.new(17, 1, 118), Vector3.new(58, 0.25, 26), { 45, 45, 60 })
	local stations = Instance.new("Folder")
	stations.Name = "Stations"
	stations.Parent = lobby
	for i, chg in Config.CHARGERS do
		local z = 74 - (i - 1) * 16
		local pad = block(stations, "Station_" .. i, Vector3.new(13, 0.25, 13), Vector3.new(58, 0.9, z),
			i == #Config.CHARGERS and { 255, 200, 40 } or { 80, 80, 100 }, Enum.Material.Neon)
		pad:SetAttribute("Station", i)
		local price = chg.cost == 0 and "FREE" or "🏆 " .. Format.num(chg.cost)
		text(pad, "🔌 " .. chg.name .. "\n+" .. Format.num(chg.rate) .. "⚡/s\n" .. price, Enum.NormalId.Top)
	end

	-- ================= المراحل =================
	local stages = Instance.new("Folder")
	stages.Name = "Stages"
	stages.Parent = world
	for i, def in Config.STAGES do
		local theme = Config.THEMES[(i - 1) % #Config.THEMES + 1]
		local gateZ = -Config.STAGE_GAP_Z * (i - 1) - 20
		local topZ = gateZ - 6
		local bottomZ = topZ - 84
		local sf = Instance.new("Folder")
		sf.Name = "Stage_" .. i
		sf.Parent = stages
		built += 1
		if def.boss then
			sf:SetAttribute("Boss", true)
		end

		local gateRgb = def.boss and { 255, 200, 40 } or theme.accent
		local gate = block(sf, "Gate", Vector3.new(26, 15, 2), Vector3.new(0, 7.5, gateZ), gateRgb)
		gate:SetAttribute("StageGate", i)
		gate:SetAttribute("Need", def.req)
		text(gate, "🔋 LEVEL " .. def.req .. "\n" .. def.name, Enum.NormalId.Back)
		block(sf, "PostL", Vector3.new(3, 19, 3), Vector3.new(-14.5, 9.5, gateZ), gateRgb)
		block(sf, "PostR", Vector3.new(3, 19, 3), Vector3.new(14.5, 9.5, gateZ), gateRgb)

		course(sf, i, def.plan, topZ, bottomZ, theme)

		if def.boss then
			for nCell, spot in { { -6, 22 }, { 6, 47 }, { 0, 70 } } do
				local cell = block(sf, "Cell_" .. nCell, Vector3.new(2.2, 3, 1.2), Vector3.new(spot[1], 1.8, topZ - spot[2]), { 90, 255, 120 }, Enum.Material.Neon)
				cell.CanCollide = false
				cell:SetAttribute("Cell", true)
				text(cell, "🔋", Enum.NormalId.Front, Color3.fromRGB(20, 80, 20))
			end
		end

		local begin = block(sf, "Begin", Vector3.new(16, 0.6, 6), Vector3.new(0, 0.3, topZ - 3), { 120, 255, 140 }, Enum.Material.Neon)
		begin:SetAttribute("Begin", i)
		local finish = block(sf, "Finish", Vector3.new(16, 0.8, 10), Vector3.new(0, 0.4, bottomZ - 5), { 255, 214, 40 }, Enum.Material.Neon)
		finish:SetAttribute("Finish", i)
		text(finish, "🏆 +" .. Format.num(def.wins) .. " WINS", Enum.NormalId.Top, Color3.fromRGB(80, 60, 0))

		local kill = block(sf, "KillFloor", Vector3.new(60, 1, 100), Vector3.new(0, -8, (topZ + bottomZ) / 2), { 255, 70, 40 }, Enum.Material.Neon)
		kill:SetAttribute("Kill", true)

		local nextGateZ = -Config.STAGE_GAP_Z * i - 20
		if i < #Config.STAGES then
			block(sf, "Walkway", Vector3.new(16, 1, (bottomZ - 10) - nextGateZ), Vector3.new(0, 0, (bottomZ - 10 + nextGateZ) / 2), theme.floor)
		else
			local fin = block(sf, "EndPlatform", Vector3.new(30, 1, 24), Vector3.new(0, 0, bottomZ - 22), { 255, 215, 0 }, Enum.Material.Neon)
			text(fin, "🏆 YOU ESCAPED THE PHONE! 🏆", Enum.NormalId.Top, Color3.fromRGB(80, 60, 0))
		end
	end

	local voidKill = block(world, "VoidKill", Vector3.new(500, 1, 500), Vector3.new(0, -12, -Config.STAGE_GAP_Z * #Config.STAGES / 2), { 255, 70, 40 }, Enum.Material.Neon)
	voidKill.Transparency = 0.6
	voidKill:SetAttribute("Kill", true)

	-- استبدال آمن: الخريطة القديمة تُحذف فقط بعد اكتمال الجديدة
	local old = workspace:FindFirstChild("PhoneWorld")
	if old then
		old:Destroy()
	end
	world.Name = "PhoneWorld"
	world.Parent = workspace

	print(("[Phone] world ready: %d icons, %d stages"):format(icons, built))
	return { levelLabels = levelLabels, winsLabels = winsLabels }
end

return Builder
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Main.server.luau — نقطة الانطلاق: الريموتات، بناء العالم، تشغيل
-- الأنظمة (بعزل كامل: فشل نظام لا يوقف الباقي)، ولوحتا الصدارة.
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rules = require(Shared.Rules)
local Format = require(Shared.Format)

-- ===== الريموتات =====
local folder = Instance.new("Folder")
folder.Name = "PhoneRemotes"
local function mk(class, name)
	local r = Instance.new(class)
	r.Name = name
	r.Parent = folder
	return r
end
local R = {
	Toast = mk("RemoteEvent", "Toast"),
	StageCleared = mk("RemoteEvent", "StageCleared"),
	SetCap = mk("RemoteEvent", "SetCap"),
	Teleport = mk("RemoteEvent", "Teleport"),
	GetState = mk("RemoteFunction", "GetState"),
	BuyCase = mk("RemoteFunction", "BuyCase"),
	BuySignal = mk("RemoteFunction", "BuySignal"),
	BuyItem = mk("RemoteFunction", "BuyItem"),
	UnlockCharger = mk("RemoteFunction", "UnlockCharger"),
	UpgradeCharger = mk("RemoteFunction", "UpgradeCharger"),
	BuyLink = mk("RemoteFunction", "BuyLink"),
	UpgradePhone = mk("RemoteFunction", "UpgradePhone"),
	OSUpdate = mk("RemoteFunction", "OSUpdate"),
	RedeemCode = mk("RemoteFunction", "RedeemCode"),
	ClaimGift = mk("RemoteFunction", "ClaimGift"),
	GetQuests = mk("RemoteFunction", "GetQuests"),
	ClaimQuest = mk("RemoteFunction", "ClaimQuest"),
	Spin = mk("RemoteFunction", "Spin"),
}
folder.Parent = ReplicatedStorage

local ctx = {
	remotes = R,
	toast = function(player, text)
		R.Toast:FireClient(player, text)
	end,
}

local Server = script.Parent
local Builder = require(Server.Builder)
local Store = require(Server.Store)
local Play = require(Server.Play)
local Shop = require(Server.Shop)

-- ===== بناء العالم (فشل البناء يظهر لافتة حمراء بدل عالم فارغ) =====
local boards
local okBuild, buildResult = pcall(Builder.build)
if okBuild then
	boards = buildResult
else
	warn("[Phone] world build FAILED: " .. tostring(buildResult))
	local sign = Instance.new("Part")
	sign.Name = "BUILD_ERROR"
	sign.Size = Vector3.new(70, 14, 1)
	sign.Position = Vector3.new(0, 12, 80)
	sign.Anchored = true
	sign.Color = Color3.fromRGB(200, 30, 30)
	sign.TopSurface = Enum.SurfaceType.Smooth
	sign.Parent = workspace
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.Parent = sign
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextScaled = true
	tl.Font = Enum.Font.GothamBold
	tl.TextColor3 = Color3.new(1, 1, 1)
	tl.Text = "WORLD BUILD ERROR:\n" .. tostring(buildResult)
	tl.Parent = gui
end

-- ===== تشغيل الأنظمة بعزل =====
local function boot(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn(("[Phone] %s failed to start:\n%s"):format(name, debug.traceback(tostring(err))))
	end
end
boot("Store", function()
	Store.init(function(player, data)
		Shop.onJoin(player, data)
	end)
end)
boot("Play", function()
	Play.init(ctx)
end)
boot("Shop", function()
	Shop.init(ctx)
end)

-- ===== لوحتا الصدارة العالميتان =====
local odsLevel = DataStoreService:GetOrderedDataStore("PhoneTopLevel_v1")
local odsWins = DataStoreService:GetOrderedDataStore("PhoneTopWins_v1")
local nameStore = DataStoreService:GetDataStore("PhoneBoardNames_v1")

local function writeBoard(labels, title, rows)
	if not labels then
		return
	end
	local lines = { title }
	for i, row in rows do
		table.insert(lines, i .. ". " .. row.name .. " — " .. row.value)
	end
	if #rows == 0 then
		table.insert(lines, "—")
	end
	local text = table.concat(lines, "\n")
	for _, tl in labels do
		tl.Text = text
	end
end

local function topRows(ods, sessionValue)
	local rows = {}
	local ok, pages = pcall(function()
		return ods:GetSortedAsync(false, 10)
	end)
	if ok and pages then
		for _, entry in pages:GetCurrentPage() do
			local userId = tonumber(string.sub(entry.key, 2))
			local name = "Player"
			if userId then
				local okName, saved = pcall(function()
					return nameStore:GetAsync("u" .. userId)
				end)
				if okName and saved then
					name = saved
				end
			end
			table.insert(rows, { name = name, value = Format.num(entry.value) })
		end
		return rows
	end
	local session = {}
	for player in Store.profiles do
		table.insert(session, { name = player.DisplayName, raw = sessionValue(player) })
	end
	table.sort(session, function(a, b)
		return a.raw > b.raw
	end)
	for i = 1, math.min(10, #session) do
		table.insert(rows, { name = session[i].name, value = Format.num(session[i].raw) })
	end
	return rows
end

task.spawn(function()
	while true do
		for player, data in Store.profiles do
			pcall(function()
				nameStore:SetAsync("u" .. player.UserId, player.DisplayName)
				odsWins:SetAsync("u" .. player.UserId, math.floor(data.wins))
				odsLevel:SetAsync("u" .. player.UserId, (Rules.level(data.lifetime)))
			end)
		end
		if boards then
			writeBoard(boards.levelLabels, "🏆 TOP LEVEL 🏆", topRows(odsLevel, function(p)
				return (Rules.level(Store.profiles[p].lifetime))
			end))
			writeBoard(boards.winsLabels, "🏆 TOP WINS 🏆", topRows(odsWins, function(p)
				return Store.profiles[p].wins
			end))
		end
		task.wait(60)
	end
end)

print("[Phone] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Play</string>
          <string name="Source"><![CDATA[-- Play.luau — حلقة اللعب: الخطو على الأيقونات، محطات الشحن، بوابات
-- المستوى، جولات المراحل (نجوم/سقوط/ميداليات)، وميكانيكية البطارية.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Format = require(Shared.Format)

local Store = require(script.Parent.Store)

local Play = {}
Play.passGain = {} -- [Player] = مضاعف الباسات (يملؤه Shop)
Play.passWins = {} -- [Player] = مضاعف Wins من الباسات
Play.hooks = {} -- { icons=fn(player), stages=fn(player), charge=fn(player, seconds) }

local ctx -- { remotes, toast }
local frac = {} -- كسور الشحن المتراكمة
local iconCd = {} -- [Player] = { [part] = clock }
local lockToastAt = {} -- [Player] = clock (تنبيه محطة مقفلة)
local gateToastAt = {} -- [Player] = { [stage] = clock }
local checkpoints = {} -- [Player] = CFrame
local armed = {} -- [Player] = { [stage] = true }
local runs = {} -- [Player] = { stage, t0, falls, stars=set, battery?, warned50, warned25 }
local cellCd = {} -- [Player] = { [part] = clock }
local bossStages = {} -- [stage] = true
local LOBBY_SPAWN = nil -- يُضبط في init من SpawnLocation

local function toast(player, text)
	if ctx and ctx.toast then
		ctx.toast(player, text)
	end
end

-- ===== المضاعفات =====
local function ownsPass(data, key)
	return data.pass and data.pass[key] == true
end

function Play.caseMult(player)
	local data = Store.profiles[player]
	if not data then
		return 1
	end
	return Rules.bestMult(data.cases, Config.CASES, function(key)
		return ownsPass(data, key)
	end)
end

function Play.signalMult(player)
	local data = Store.profiles[player]
	if not data then
		return 1
	end
	return Rules.bestMult(data.signals, Config.SIGNALS, function(key)
		return ownsPass(data, key)
	end)
end

function Play.cableMult(player)
	local data = Store.profiles[player]
	if not data then
		return 1
	end
	local best = 1
	for _, cable in Config.CABLES do
		if ownsPass(data, cable.pass) and cable.mult > best then
			best = cable.mult
		end
	end
	return best
end

function Play.stack(player)
	local data = Store.profiles[player]
	if not data then
		return 1
	end
	local m = Rules.gainStack(Play.caseMult(player), Play.signalMult(player), Rules.itemsMult(data.items), data.phones, data.ascends, Play.passGain[player] or 1)
	if data.boostUntil and data.boostUntil > os.time() then
		m *= data.boostMult or 1
	end
	return m
end

-- كسب شحن عبر الحلقة (يمر بكل المضاعفات)
function Play.gain(player, base)
	local data = Store.profiles[player]
	if not data then
		return
	end
	frac[player] = (frac[player] or 0) + base * Play.stack(player)
	local whole = math.floor(frac[player])
	if whole > 0 then
		frac[player] -= whole
		data.charge += whole
		data.lifetime += whole
		Store.sync(player)
	end
end

-- منح مباشر (أكواد/هدايا/منتجات): يعدّ في التراكمي أيضًا
function Play.grant(player, amount)
	local data = Store.profiles[player]
	if not data then
		return
	end
	data.charge += amount
	data.lifetime += amount
	Store.sync(player)
end

function Play.batteryOf(player)
	local run = runs[player]
	if run and run.battery then
		return math.max(0, math.floor(run.battery))
	end
	return nil
end

function Play.resetRun(player)
	runs[player] = nil
	armed[player] = {}
	checkpoints[player] = nil
end

local function hrpOf(player)
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

function Play.sendTo(player, cf)
	local hrp = hrpOf(player)
	if hrp then
		hrp.CFrame = cf
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	checkpoints[player] = cf
end

function Play.toLobby(player)
	Play.sendTo(player, LOBBY_SPAWN or CFrame.new(0, 3, 80))
end

function Play.respawn(player)
	local run = runs[player]
	if run then
		run.falls += 1
	end
	local hrp = hrpOf(player)
	if hrp then
		hrp.CFrame = checkpoints[player] or LOBBY_SPAWN
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end

-- ===== إتمام مرحلة =====
local function claim(player, stageIdx, withRun)
	local data = Store.profiles[player]
	local def = Config.STAGES[stageIdx]
	if not (data and def) then
		return
	end
	local reward = def.wins * (Play.passWins[player] or 1)
	local extra = ""
	local run = runs[player]
	if withRun and run and run.stage == stageIdx then
		local starCount = 0
		for _ in run.stars do
			starCount += 1
		end
		local elapsed = os.clock() - run.t0
		local pct, medal = Rules.runBonus(starCount, run.falls, elapsed, stageIdx)
		if pct > 0 then
			reward = math.floor(reward * (1 + pct / 100))
			local bits = {}
			if starCount > 0 then
				table.insert(bits, "⭐x" .. starCount)
			end
			if run.falls == 0 then
				table.insert(bits, "flawless")
			end
			if medal ~= "" then
				table.insert(bits, (medal == "gold" and "🥇" or medal == "silver" and "🥈" or "🥉") .. string.format(" %.1fs", elapsed))
			end
			extra = " (" .. table.concat(bits, " • ") .. " +" .. pct .. "%)"
		end
		local key = "s" .. stageIdx
		if not data.best[key] or elapsed < data.best[key] then
			data.best[key] = math.floor(elapsed * 10) / 10
		end
		runs[player] = nil
	end
	data.wins += reward
	if stageIdx > data.stage then
		data.stage = stageIdx
	end
	Store.sync(player)
	toast(player, "🏆 Stage " .. stageIdx .. " — " .. def.name .. " cleared! +" .. Format.num(reward) .. " Wins" .. extra)
	if ctx and ctx.remotes then
		ctx.remotes.StageCleared:FireClient(player, stageIdx)
	end
	if Play.hooks.stages then
		Play.hooks.stages(player)
	end
end

-- تخطي مدفوع: يمنح الجائزة الأساسية بلا بونص جولة
function Play.claimSkip(player, stageIdx)
	claim(player, stageIdx, false)
end

function Play.clearStageReward(stageIdx)
	local def = Config.STAGES[stageIdx]
	return def and def.wins or 0
end

-- ===== التهيئة =====
function Play.init(context)
	ctx = context
	local world = workspace:WaitForChild("PhoneWorld")
	LOBBY_SPAWN = CFrame.new(0, 3, 80)
	local lobby = world:FindFirstChild("Lobby")
	local spawnLoc = lobby and lobby:FindFirstChild("Spawn")
	if spawnLoc then
		LOBBY_SPAWN = CFrame.new(spawnLoc.Position + Vector3.new(0, 2, 0))
	end
	local stagesFolder = world:FindFirstChild("Stages")
	if stagesFolder then
		for _, sf in stagesFolder:GetChildren() do
			local idx = tonumber(string.match(sf.Name, "Stage_(%d+)"))
			if idx and sf:GetAttribute("Boss") then
				bossStages[idx] = true
			end
		end
	end

	local movers, spinners, blinks, belts, stars = {}, {}, {}, {}, {}
	local flashBusy = {}
	local function flash(partObj)
		if flashBusy[partObj] then
			return
		end
		flashBusy[partObj] = true
		local c, m = partObj.Color, partObj.Material
		partObj.Color = Color3.fromRGB(190, 255, 200)
		partObj.Material = Enum.Material.Neon
		task.delay(0.25, function()
			if partObj.Parent then
				partObj.Color = c
				partObj.Material = m
			end
			flashBusy[partObj] = nil
		end)
	end

	local bounceAt = {}
	for _, d in world:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("Move") then
				table.insert(movers, { part = d, base = d.CFrame, axis = d:GetAttribute("Axis") or "X", range = d:GetAttribute("Range") or 7, speed = d:GetAttribute("Speed") or 1.1, phase = d:GetAttribute("Phase") or 0 })
			end
			if d:GetAttribute("Sweep") then
				table.insert(spinners, { part = d, y = d.Position.Y, px = d:GetAttribute("PivotX") or d.Position.X, pz = d:GetAttribute("PivotZ") or d.Position.Z, speed = d:GetAttribute("SweepSpeed") or 1.2 })
			end
			if d:GetAttribute("Vanish") ~= nil then
				table.insert(blinks, { part = d, phase = d:GetAttribute("Vanish") })
			end
			if d:GetAttribute("Belt") then
				table.insert(belts, { part = d, z = d:GetAttribute("Belt") })
			end
			if d:GetAttribute("Star") then
				local ofStage = d:GetAttribute("StarOf")
				table.insert(stars, { part = d, base = d.Position, phase = math.random() * 6 })
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local run = player and runs[player]
					if run and run.stage == ofStage and not run.stars[d] then
						run.stars[d] = true
						toast(player, "⭐ Star! (+25% stage bonus)")
					end
				end)
			end
			if d:GetAttribute("Cell") then
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local run = player and runs[player]
					if run and run.battery and run.battery < 100 then
						cellCd[player] = cellCd[player] or {}
						local now = os.clock()
						if now - (cellCd[player][d] or 0) > 8 then
							cellCd[player][d] = now
							run.battery = math.min(100, run.battery + Config.BATTERY_CELL)
							toast(player, "🔋 +" .. Config.BATTERY_CELL .. "% (" .. math.floor(run.battery) .. "%)")
						end
					end
				end)
			end
			if d:GetAttribute("Bounce") then
				local power = d:GetAttribute("Bounce")
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local root = hit.Parent and hit.Parent:FindFirstChild("HumanoidRootPart")
					if player and root then
						local key = player.UserId .. d:GetDebugId()
						local now = os.clock()
						if now - (bounceAt[key] or 0) > 0.35 then
							bounceAt[key] = now
							local v = root.AssemblyLinearVelocity
							root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
						end
					end
				end)
			end
			if d:GetAttribute("Begin") then
				local idx = d:GetAttribute("Begin")
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if not player then
						return
					end
					checkpoints[player] = d.CFrame + Vector3.new(0, 3, 0)
					armed[player] = armed[player] or {}
					armed[player][idx] = true
					local run = runs[player]
					if not run or run.stage ~= idx then
						runs[player] = { stage = idx, t0 = os.clock(), falls = 0, stars = {} }
						if bossStages[idx] then
							runs[player].battery = 100
							toast(player, "🔋 Power-save stage! Grab 🔋 cells — 0% sends you back!")
						end
					end
				end)
			elseif d:GetAttribute("Mid") then
				local idx = d:GetAttribute("Mid")
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						checkpoints[player] = d.CFrame + Vector3.new(0, 3, 0)
						armed[player] = armed[player] or {}
						armed[player][idx] = true
					end
				end)
			elseif d:GetAttribute("Finish") then
				local idx = d:GetAttribute("Finish")
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player and armed[player] and armed[player][idx] then
						armed[player][idx] = false
						claim(player, idx, true)
					end
				end)
			elseif d:GetAttribute("Kill") then
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						Play.respawn(player)
					end
				end)
			end
		end
	end
	Play._flash = flash

	-- حلقة الميكانيكيات المتحركة
	local lastCycle = -1
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, m in movers do
			local off = math.sin(t * m.speed + m.phase) * m.range
			m.part.CFrame = m.axis == "Y" and (m.base * CFrame.new(0, off, 0)) or (m.base * CFrame.new(off, 0, 0))
		end
		for _, s in spinners do
			s.part.CFrame = CFrame.new(s.px, s.y, s.pz) * CFrame.Angles(0, t * s.speed, 0)
		end
		local cycle = math.floor(t / 1.1) % 3
		if cycle ~= lastCycle then
			lastCycle = cycle
			for _, b in blinks do
				local solid = b.phase == cycle
				b.part.CanCollide = solid
				b.part.Transparency = solid and 0 or 0.65
			end
		end
		for _, s in stars do
			s.part.Position = s.base + Vector3.new(0, math.sin(t * 2 + s.phase) * 0.3, 0)
		end
		if #belts > 0 then
			for _, player in Players:GetPlayers() do
				local root = hrpOf(player)
				if root then
					for _, belt in belts do
						local bp, bs = belt.part.Position, belt.part.Size
						if math.abs(root.Position.X - bp.X) < bs.X / 2 + 0.5
							and math.abs(root.Position.Z - bp.Z) < bs.Z / 2 + 0.5
							and root.Position.Y > bp.Y and root.Position.Y < bp.Y + 3.2 then
							local v = root.AssemblyLinearVelocity
							root.AssemblyLinearVelocity = Vector3.new(v.X, v.Y, belt.z)
						end
					end
				end
			end
		end
	end)

	-- حلقة اللعب: فحص ما تحت اللاعب + البوابات + البطارية
	RunService.Heartbeat:Connect(function(dt)
		local w = workspace:FindFirstChild("PhoneWorld")
		if not w then
			return
		end
		for _, player in Players:GetPlayers() do
			local data = Store.profiles[player]
			local root = hrpOf(player)
			if not (data and root) then
				continue
			end
			-- ما تحت اللاعب
			local params = OverlapParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { w }
			local hits = workspace:GetPartBoundsInBox(CFrame.new(root.Position - Vector3.new(0, 2.6, 0)), Vector3.new(3.4, 2.2, 3.4), params)
			local now = os.clock()
			iconCd[player] = iconCd[player] or {}
			for _, hit in hits do
				if hit:GetAttribute("Icon") then
					if now - (iconCd[player][hit] or 0) >= Config.STEP_COOLDOWN then
						iconCd[player][hit] = now
						local link = Config.LINKS[data.linkIdx] or Config.LINKS[1]
						Play.gain(player, link.amount)
						flash(hit)
						if Play.hooks.icons then
							Play.hooks.icons(player)
						end
					end
				elseif hit:GetAttribute("Station") then
					local idx = hit:GetAttribute("Station")
					local chg = Config.CHARGERS[idx]
					if chg then
						if table.find(data.chargers, idx) then
							Play.gain(player, Rules.chargerRate(chg, data.chargerLv[idx] or 0) * Play.cableMult(player) * dt)
							if Play.hooks.charge then
								Play.hooks.charge(player, dt)
							end
						elseif now - (lockToastAt[player] or 0) > 4 then
							lockToastAt[player] = now
							toast(player, "🔒 Buy the " .. chg.name .. " station in the Chargers panel")
						end
					end
				end
			end
			-- سرعة المشي من الشحن
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				local eff = data.charge
				if data.cap and data.cap > 0 then
					eff = math.min(eff, data.cap)
				end
				hum.WalkSpeed = math.min(16 + math.sqrt(math.max(eff, 0)) / 4, 250)
			end
			-- البوابات: عبور بلا مستوى كافٍ = ارتداد
			local level = Rules.level(data.lifetime)
			for i, def in Config.STAGES do
				local gateZ = -Config.STAGE_GAP_Z * (i - 1) - 20
				if root.Position.Z < gateZ - 1.5 and root.Position.Z > gateZ - 30 then
					if i > data.stage and level < def.req then
						root.CFrame = CFrame.new(root.Position.X, root.Position.Y, gateZ + 4)
						root.AssemblyLinearVelocity = Vector3.zero
						gateToastAt[player] = gateToastAt[player] or {}
						if now - (gateToastAt[player][i] or 0) > 3 then
							gateToastAt[player][i] = now
							toast(player, "🧱 Stage " .. i .. " needs Level " .. def.req .. "!")
						end
					end
					break
				end
			end
			-- البطارية
			local run = runs[player]
			if run and run.battery then
				run.battery -= Config.BATTERY_DRAIN * dt
				if run.battery <= 50 and not run.warned50 then
					run.warned50 = true
					toast(player, "🪫 Battery at 50%! Find a 🔋 cell!")
				end
				if run.battery <= 25 and not run.warned25 then
					run.warned25 = true
					toast(player, "🪫⚠️ Battery at 25%!")
				end
				if run.battery <= 0 then
					runs[player] = nil
					toast(player, "🔋 Battery empty! Back to the checkpoint!")
					Play.respawn(player)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		frac[player] = nil
		iconCd[player] = nil
		lockToastAt[player] = nil
		gateToastAt[player] = nil
		checkpoints[player] = nil
		armed[player] = nil
		runs[player] = nil
		cellCd[player] = nil
		Play.passGain[player] = nil
		Play.passWins[player] = nil
	end)
end

return Play
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[-- Shop.luau — المتاجر والباسات والترقيات والأنظمة اليومية.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Format = require(Shared.Format)

local Store = require(script.Parent.Store)
local Play = require(script.Parent.Play)

local Shop = {}
local ctx
local auraOf = {} -- [Player] = Part

local function toast(player, text)
	if ctx and ctx.toast then
		ctx.toast(player, text)
	end
end

local function ownsPassAsync(player, id)
	if id <= 0 then
		return false
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
	end)
	return ok and owns == true
end

local function bestItem(owned, ladder, data)
	local bestIdx, bestMult = 0, 1
	for _, idx in owned do
		local item = ladder[idx]
		if item and item.mult > bestMult then
			bestIdx, bestMult = idx, item.mult
		end
	end
	for idx, item in ladder do
		if item.pass and data.pass[item.pass] and item.mult > bestMult then
			bestIdx, bestMult = idx, item.mult
		end
	end
	return bestIdx, bestMult
end

function Shop.refreshVisuals(player)
	local data = Store.profiles[player]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (data and root) then
		return
	end
	local old = root:FindFirstChild("GlowTrail")
	if old then
		old:Destroy()
	end
	local caseIdx = bestItem(data.cases, Config.CASES, data)
	local caseItem = Config.CASES[caseIdx]
	if caseItem then
		local a0 = root:FindFirstChild("TrailTop")
		if not a0 then
			a0 = Instance.new("Attachment")
			a0.Name = "TrailTop"
			a0.Position = Vector3.new(0, 1, 0.6)
			a0.Parent = root
		end
		local a1 = root:FindFirstChild("TrailBottom")
		if not a1 then
			a1 = Instance.new("Attachment")
			a1.Name = "TrailBottom"
			a1.Position = Vector3.new(0, -1, 0.6)
			a1.Parent = root
		end
		local trail = Instance.new("Trail")
		trail.Name = "GlowTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(Color3.fromRGB(caseItem.color[1], caseItem.color[2], caseItem.color[3]))
		trail.Lifetime = 0.6
		trail.MinLength = 0.1
		trail.Parent = root
	end
	if auraOf[player] then
		auraOf[player]:Destroy()
		auraOf[player] = nil
	end
	local sigIdx = bestItem(data.signals, Config.SIGNALS, data)
	local sigItem = Config.SIGNALS[sigIdx]
	if sigItem then
		local sphere = Instance.new("Part")
		sphere.Name = "SignalAura"
		sphere.Shape = Enum.PartType.Ball
		sphere.Size = Vector3.new(6, 6, 6)
		sphere.Transparency = 0.75
		sphere.Color = Color3.fromRGB(sigItem.color[1], sigItem.color[2], sigItem.color[3])
		sphere.Material = Enum.Material.Neon
		sphere.CanCollide = false
		sphere.Anchored = true
		sphere.Parent = workspace
		auraOf[player] = sphere
	end
end

function Shop.applyPasses(player)
	local data = Store.profiles[player]
	if not data then
		return
	end
	local gain = 1
	for key, id in Config.PASSES do
		if ownsPassAsync(player, id) then
			data.pass[key] = true
		end
	end
	if data.pass.doubleCharge then
		gain *= 2
	end
	if data.pass.vip then
		gain *= 3
		data.pass.cableGold = true
	end
	Play.passGain[player] = gain
	Play.passWins[player] = data.pass.doubleWins and 2 or 1
	Shop.refreshVisuals(player)
end

-- ===== المهام اليومية =====
local function today()
	return math.floor(os.time() / 86400)
end

local function ensureQuestDay(data)
	if data.questDay ~= today() then
		data.questDay = today()
		data.questProg = {}
		data.questDone = {}
	end
end

local function bump(player, id, amount)
	local data = Store.profiles[player]
	if not data then
		return
	end
	ensureQuestDay(data)
	if data.questDone[id] then
		return
	end
	data.questProg[id] = (data.questProg[id] or 0) + amount
end

-- ===== عند دخول لاعب (يستدعيها Main بعد تحميل البيانات) =====
function Shop.onJoin(player, data)
	ensureQuestDay(data)
	-- سلسلة الدخول اليومية
	local day = today()
	if data.loginDay ~= day then
		data.streak = (day - (data.loginDay or 0) == 1) and (data.streak or 0) + 1 or 1
		data.loginDay = day
		local c, w = Rules.daily(data.streak, data.stage)
		Play.grant(player, c)
		data.wins += w
		Store.sync(player)
		task.delay(3, function()
			toast(player, "📅 Day " .. data.streak .. " streak! +" .. Format.num(c) .. " Charge, +" .. Format.num(w) .. " Wins")
		end)
	end
	-- أرباح الغياب
	if data.lastSeen and data.lastSeen > 0 and not RunService:IsStudio() then
		local hours = (os.time() - data.lastSeen) / 3600
		if hours * 60 >= Config.OFFLINE_MIN_MIN then
			local best = 0
			for _, idx in data.chargers do
				local chg = Config.CHARGERS[idx]
				if chg then
					best = math.max(best, Rules.chargerRate(chg, data.chargerLv[idx] or 0))
				end
			end
			local earned = Rules.offline(hours, best)
			if earned > 0 then
				Play.grant(player, earned)
				task.delay(5, function()
					toast(player, "🌙 While you were away: +" .. Format.num(earned) .. " Charge!")
				end)
			end
		end
	end
	-- ترحيب بالجدد
	if data.lifetime == 0 and data.stage == 0 then
		task.delay(2, function()
			toast(player, "👋 1) Step on the APPS to gain Charge ⚡!")
		end)
		task.delay(8, function()
			toast(player, "👋 2) Clear STAGES for Wins — spend them on Cases & Signal!")
		end)
	end
	Shop.applyPasses(player)
end

local function buyLadder(player, ladder, ownedKey, idx, kindLabel)
	local data = Store.profiles[player]
	local item = ladder[idx]
	if not (data and item) then
		return false, "Invalid " .. kindLabel
	end
	if table.find(data[ownedKey], idx) then
		return false, "Already owned"
	end
	if item.pass then
		if data.pass[item.pass] then
			return false, "Already owned (pass)"
		end
		return false, "👑 Robux pass item — get it in the Shop (🛒)"
	end
	if data.wins < item.cost then
		return false, "Need " .. Format.num(item.cost) .. " Wins"
	end
	data.wins -= item.cost
	table.insert(data[ownedKey], idx)
	Store.sync(player)
	Shop.refreshVisuals(player)
	if item.pct then
		return true, "✅ " .. item.name .. " (+" .. item.pct .. "% Charge)"
	end
	return true, "✅ " .. item.name .. " (x" .. tostring(item.mult) .. ")"
end

function Shop.init(context)
	ctx = context
	local R = ctx.remotes

	Play.hooks.icons = function(player)
		bump(player, "icons", 1)
	end
	Play.hooks.stages = function(player)
		bump(player, "stages", 1)
	end
	Play.hooks.charge = function(player, seconds)
		bump(player, "charge", seconds)
	end

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.4)
			Shop.applyPasses(player)
		end)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player)
		Shop.applyPasses(player)
	end)

	R.GetState.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return {}
		end
		local level, into, band = Rules.level(data.lifetime)
		local nextPhone = Config.PHONES[data.phones + 1]
		return {
			cases = data.cases,
			signals = data.signals,
			items = data.items,
			chargers = data.chargers,
			chargerLv = data.chargerLv,
			linkIdx = data.linkIdx,
			pass = data.pass,
			caseMult = Play.caseMult(player),
			signalMult = Play.signalMult(player),
			itemMult = Rules.itemsMult(data.items),
			stack = Play.stack(player),
			level = level,
			levelInto = into,
			levelBand = band,
			phones = data.phones,
			nextPhoneReq = nextPhone and nextPhone.req or nil,
			nextPhoneName = nextPhone and nextPhone.name or nil,
			ascends = data.ascends,
			osMult = Config.OS_MULT ^ data.ascends,
			cap = data.cap,
			giftIn = math.max(0, Config.GIFT_EVERY - (os.time() - (data.lastGift or 0))),
			spinIn = math.max(0, Config.SPIN_EVERY - (os.time() - (data.lastSpin or 0))),
			boostUntil = data.boostUntil or 0,
			boostMult = data.boostMult or 1,
			battery = Play.batteryOf(player),
			stage = data.stage,
		}
	end

	R.BuyCase.OnServerInvoke = function(player, idx)
		return buyLadder(player, Config.CASES, "cases", idx, "case")
	end
	R.BuySignal.OnServerInvoke = function(player, idx)
		return buyLadder(player, Config.SIGNALS, "signals", idx, "signal")
	end
	R.BuyItem.OnServerInvoke = function(player, idx)
		local ok, msg = buyLadder(player, Config.ITEMS, "items", idx, "item")
		if ok then
			msg = "🎒 " .. msg
		end
		return ok, msg
	end

	R.UnlockCharger.OnServerInvoke = function(player, idx)
		local data = Store.profiles[player]
		local chg = Config.CHARGERS[idx]
		if not (data and chg) then
			return false, "Invalid station"
		end
		if table.find(data.chargers, idx) then
			return false, "Already unlocked"
		end
		if data.wins < chg.cost then
			return false, "Need " .. Format.num(chg.cost) .. " Wins"
		end
		data.wins -= chg.cost
		table.insert(data.chargers, idx)
		Store.sync(player)
		return true, "🔌 " .. chg.name .. " unlocked!"
	end

	R.UpgradeCharger.OnServerInvoke = function(player, idx)
		local data = Store.profiles[player]
		local chg = Config.CHARGERS[idx]
		if not (data and chg) then
			return false, "Invalid station"
		end
		if not table.find(data.chargers, idx) then
			return false, "Unlock this station first"
		end
		local lv = data.chargerLv[idx] or 0
		if lv >= Config.CHARGER_MAX_LV then
			return false, "⭐ MAX level"
		end
		local cost = Rules.chargerUpgradeCost(chg, lv)
		if data.wins < cost then
			return false, "Need " .. Format.num(cost) .. " Wins to upgrade"
		end
		data.wins -= cost
		data.chargerLv[idx] = lv + 1
		Store.sync(player)
		return true, "⬆️ " .. chg.name .. " Lv" .. (lv + 1) .. " — now +" .. Format.num(Rules.chargerRate(chg, lv + 1)) .. " Charge/s"
	end

	R.BuyLink.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		local nxt = Config.LINKS[(data.linkIdx or 1) + 1]
		if not nxt then
			return false, "🔗 MAX link owned!"
		end
		if data.wins < nxt.cost then
			return false, "Need " .. Format.num(nxt.cost) .. " Wins for the +" .. Format.num(nxt.amount) .. "⚡/step link"
		end
		data.wins -= nxt.cost
		data.linkIdx += 1
		Store.sync(player)
		return true, "🔗 Link upgraded! Now +" .. Format.num(nxt.amount) .. " Charge per step"
	end

	R.UpgradePhone.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		local nxt = Config.PHONES[data.phones + 1]
		if not nxt then
			return false, "📱 MAX phone reached!"
		end
		local level = Rules.level(data.lifetime)
		if level < nxt.req then
			return false, "📱 " .. nxt.name .. " needs Level " .. nxt.req .. " (you are " .. level .. ")"
		end
		data.charge = 0
		data.lifetime = 0
		data.stage = 0
		data.phones += 1
		Store.sync(player)
		Play.resetRun(player)
		return true, "📱 Upgraded to " .. nxt.name .. "! Gains now x" .. Format.num(Rules.phoneMult(data.phones))
	end

	R.OSUpdate.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		if data.phones < Config.OS_PHONES_NEEDED then
			return false, "🔄 OS Update needs " .. Config.OS_PHONES_NEEDED .. " phone upgrades (you have " .. data.phones .. ")"
		end
		if data.wins < Config.OS_WINS_COST then
			return false, "🔄 OS Update needs " .. Format.num(Config.OS_WINS_COST) .. " Wins"
		end
		data.wins -= Config.OS_WINS_COST
		data.phones = 0
		data.charge = 0
		data.lifetime = 0
		data.stage = 0
		data.ascends += 1
		Store.sync(player)
		Play.resetRun(player)
		Play.toLobby(player)
		return true, "🔄 OS UPDATED! Permanent x" .. Format.num(Config.OS_MULT ^ data.ascends) .. " from OS updates"
	end

	R.RedeemCode.OnServerInvoke = function(player, code)
		local data = Store.profiles[player]
		if not data or type(code) ~= "string" then
			return false, "Invalid code"
		end
		local key = string.upper(code)
		local reward = Config.CODES[key]
		if not reward then
			return false, "❌ Code not found"
		end
		if data.codes[key] then
			return false, "Already used this code"
		end
		data.codes[key] = true
		if reward.charge > 0 then
			Play.grant(player, reward.charge)
		end
		if reward.wins > 0 then
			data.wins += reward.wins
			Store.sync(player)
		end
		return true, "🎁 Code redeemed! +" .. Format.num(reward.charge) .. " Charge, +" .. Format.num(reward.wins) .. " Wins"
	end

	R.ClaimGift.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		local left = Config.GIFT_EVERY - (os.time() - (data.lastGift or 0))
		if left > 0 then
			return false, "🎁 Free gift in " .. math.ceil(left / 60) .. " min"
		end
		data.lastGift = os.time()
		local c = 1000 * (10 ^ math.floor(data.stage / 5))
		local w = 25 * (data.stage + 1)
		Play.grant(player, c)
		data.wins += w
		Store.sync(player)
		return true, "🎁 FREE! +" .. Format.num(c) .. " Charge, +" .. Format.num(w) .. " Wins"
	end

	R.Spin.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		local left = Config.SPIN_EVERY - (os.time() - (data.lastSpin or 0))
		if left > 0 then
			return false, "🎡 Free spin in " .. math.floor(left / 3600) .. "h " .. math.ceil((left % 3600) / 60) .. "m"
		end
		data.lastSpin = os.time()
		local outcome = Rules.spin(math.random(), data.stage)
		if outcome.kind == "charge" then
			Play.grant(player, outcome.amount)
			return true, "🎡 You won +" .. Format.num(outcome.amount) .. " Charge!"
		elseif outcome.kind == "wins" then
			data.wins += outcome.amount
			Store.sync(player)
			return true, "🎡 You won +" .. Format.num(outcome.amount) .. " Wins!"
		elseif outcome.kind == "boost" then
			local now = os.time()
			local active = (data.boostUntil or 0) > now and (data.boostMult or 1) or 1
			data.boostMult = math.max(active, outcome.mult)
			data.boostUntil = math.max(data.boostUntil or 0, now) + outcome.minutes * 60
			return true, "🎡 BOOST! x" .. data.boostMult .. " gains for " .. outcome.minutes .. " min!"
		end
		Play.grant(player, outcome.amount)
		return true, "🎡💎 JACKPOT! +" .. Format.num(outcome.amount) .. " Charge!"
	end

	R.GetQuests.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return {}
		end
		ensureQuestDay(data)
		local list = {}
		for _, q in Config.QUESTS do
			table.insert(list, {
				id = q.id,
				text = q.text,
				target = q.target,
				progress = math.floor(data.questProg[q.id] or 0),
				claimed = data.questDone[q.id] == true,
			})
		end
		return { streak = data.streak or 1, quests = list }
	end

	R.ClaimQuest.OnServerInvoke = function(player, id)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		ensureQuestDay(data)
		for _, q in Config.QUESTS do
			if q.id == id then
				if data.questDone[id] then
					return false, "Already claimed"
				end
				if (data.questProg[id] or 0) < q.target then
					return false, "Quest not finished yet"
				end
				data.questDone[id] = true
				if q.charge > 0 then
					Play.grant(player, q.charge)
				end
				if q.wins > 0 then
					data.wins += q.wins
					Store.sync(player)
				end
				return true, "🎖️ Quest done! +" .. Format.num(q.charge) .. " Charge, +" .. Format.num(q.wins) .. " Wins"
			end
		end
		return false, "Unknown quest"
	end

	R.SetCap.OnServerEvent:Connect(function(player, cap)
		local data = Store.profiles[player]
		if data and type(cap) == "number" then
			data.cap = math.max(0, math.floor(cap))
		end
	end)

	R.Teleport.OnServerEvent:Connect(function(player, dest)
		local data = Store.profiles[player]
		if not data then
			return
		end
		if dest == "lobby" then
			Play.toLobby(player)
		elseif dest == "stage" then
			local target = math.min(data.stage + 1, #Config.STAGES)
			local z = -Config.STAGE_GAP_Z * (target - 1) - 26
			Play.sendTo(player, CFrame.new(0, 3, z - 2))
		elseif dest == "world2" then
			toast(player, "🔒 World 2 — Social Apps — is coming in Update 1!")
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local data = player and Store.profiles[player]
		if not (player and data) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if Config.PRODUCTS.skipStage > 0 and receipt.ProductId == Config.PRODUCTS.skipStage then
			if data.stage >= #Config.STAGES then
				Play.claimSkip(player, #Config.STAGES)
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not root then
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
			local nxt = data.stage + 1
			Play.claimSkip(player, nxt)
			local z = -Config.STAGE_GAP_Z * (nxt - 1) - 26
			Play.sendTo(player, CFrame.new(0, 3, z))
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		for key, amount in Config.PACK_AMOUNTS do
			local pid = Config.PRODUCTS[key]
			if pid and pid > 0 and receipt.ProductId == pid then
				Play.grant(player, amount)
				toast(player, "⚡ +" .. Format.num(amount) .. " Charge!")
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	RunService.Heartbeat:Connect(function()
		for player, sphere in auraOf do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and sphere.Parent then
				sphere.CFrame = root.CFrame
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if auraOf[player] then
			auraOf[player]:Destroy()
			auraOf[player] = nil
		end
	end)
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[-- Store.luau — بيانات اللاعبين: تحميل/حفظ DataStore + leaderstats.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Rules"))

local Store = {}
Store.profiles = {} -- [Player] = data
Store.values = {} -- [Player] = { charge=NumberValue, wins=..., phones=..., stage=..., level=... }

local ds = DataStoreService:GetDataStore("PhoneEscape_v1")

local function defaults()
	return {
		charge = 0,
		wins = 0,
		lifetime = 0, -- الشحن التراكمي (يقود المستوى، يُصفّر بالترقية)
		stage = 0, -- أعلى مرحلة مخلّصة
		phones = 0, -- عدد ترقيات الهاتف
		ascends = 0, -- عدد تحديثات النظام
		cases = {},
		signals = {},
		items = {},
		chargers = { 1 },
		chargerLv = {},
		linkIdx = 1,
		pass = {}, -- [passKey] = true (من الباسات المشتراة)
		codes = {},
		cap = 0, -- سقف سرعة يدوي (0 = بلا سقف)
		lastGift = 0,
		lastSpin = 0,
		boostUntil = 0,
		boostMult = 1,
		lastSeen = 0,
		loginDay = 0,
		streak = 0,
		questDay = 0,
		questProg = {},
		questDone = {},
		best = {}, -- ["s<idx>"] = أفضل زمن
	}
end

local function bindStats(player: Player, data)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local vals = {}
	local function num(name, value)
		local v = Instance.new("NumberValue")
		v.Name = name
		v.Value = value
		v.Parent = folder
		vals[string.lower(name)] = v
		return v
	end
	num("Charge", data.charge)
	num("Wins", data.wins)
	num("Phones", data.phones)
	num("Stage", data.stage)
	num("Level", (Rules.level(data.lifetime)))
	folder.Parent = player
	Store.values[player] = vals
end

function Store.sync(player: Player)
	local data = Store.profiles[player]
	local vals = Store.values[player]
	if not (data and vals) then
		return
	end
	vals.charge.Value = data.charge
	vals.wins.Value = data.wins
	vals.phones.Value = data.phones
	vals.stage.Value = data.stage
	vals.level.Value = (Rules.level(data.lifetime))
end

function Store.load(player: Player)
	local data = defaults()
	if not RunService:IsStudio() then
		local ok, saved
		for _ = 1, 2 do -- محاولة + إعادة: قراءة فاشلة لا تمسح تقدم أحد
			ok, saved = pcall(function()
				return ds:GetAsync("p_" .. player.UserId)
			end)
			if ok then
				break
			end
			task.wait(1)
		end
		if ok and type(saved) == "table" then
			for key, value in defaults() do
				if saved[key] ~= nil then
					data[key] = saved[key]
				end
			end
		end
	end
	Store.profiles[player] = data
	bindStats(player, data)
	return data
end

function Store.save(player: Player)
	local data = Store.profiles[player]
	if not data or RunService:IsStudio() then
		return
	end
	data.lastSeen = os.time()
	pcall(function()
		ds:SetAsync("p_" .. player.UserId, data)
	end)
end

function Store.init(onLoaded: (Player) -> ())
	Players.PlayerAdded:Connect(function(player)
		local data = Store.load(player)
		if onLoaded then
			onLoaded(player, data)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		Store.save(player)
		Store.profiles[player] = nil
		Store.values[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		if not Store.profiles[player] then
			local data = Store.load(player)
			if onLoaded then
				onLoaded(player, data)
			end
		end
	end
	task.spawn(function()
		while true do
			task.wait(120)
			for player in Store.profiles do
				Store.save(player)
			end
		end
	end)
	game:BindToClose(function()
		for player in Store.profiles do
			Store.save(player)
		end
	end)
end

return Store
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="13">
