      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Format.luau — تنسيق الأرقام الكبيرة كما في اللعبة الأصلية:
-- K / M / B / T / Qa / Qi (لا Zillion في الأصلية).
local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

function Format.num(n: number): string
	if n ~= n then
		return "0"
	end
	if n < 0 then
		return "-" .. Format.num(-n)
	end
	if n < 1000 then
		if n % 1 == 0 then
			return string.format("%d", n)
		end
		return string.format("%.1f", n)
	end
	local tier = math.floor(math.log10(n) / 3)
	if tier > #SUFFIXES - 1 then
		tier = #SUFFIXES - 1
	end
	local scaled = n / (10 ^ (tier * 3))
	local text
	if scaled >= 100 then
		text = string.format("%d", math.floor(scaled))
	elseif scaled % 1 == 0 then
		text = string.format("%d", scaled)
	else
		text = string.format("%.1f", scaled)
		if string.sub(text, -2) == ".0" then
			text = string.sub(text, 1, -3)
		end
	end
	return text .. SUFFIXES[tier + 1]
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[-- Rules.luau — رياضيات اللعبة النقية (تعمل في السيرفر والعميل والاختبارات).
local Config = require(script.Parent.Config)

local Rules = {}

-- المستوى من الشحن التراكمي: يعيد (المستوى، التقدم داخل الشريط، حجم الشريط)
function Rules.level(lifetime: number): (number, number, number)
	local level = 1
	local rest = lifetime
	while true do
		local band = Config.LEVEL_BASE * (Config.LEVEL_GROWTH ^ (level - 1))
		if rest < band then
			return level, rest, band
		end
		rest -= band
		level += 1
		if level > 9000 then
			return level, rest, band
		end
	end
end

function Rules.stage(i: number): any
	return Config.STAGES[i]
end

-- أفضل مضاعف مملوك من سلم (مع عناصر الباسات: تُمرَّر دالة يملك(مفتاح))
function Rules.bestMult(owned: { number }, ladder: { any }, ownsPass: ((string) -> boolean)?): number
	local best = 1
	for _, idx in owned do
		local item = ladder[idx]
		if item and item.mult > best then
			best = item.mult
		end
	end
	if ownsPass then
		for _, item in ladder do
			if item.pass and ownsPass(item.pass) and item.mult > best then
				best = item.mult
			end
		end
	end
	return best
end

-- الأدوات: النسب تُجمع
function Rules.itemsMult(ownedItems: { number }): number
	local pct = 0
	for _, idx in ownedItems do
		local item = Config.ITEMS[idx]
		if item then
			pct += item.pct
		end
	end
	return 1 + pct / 100
end

-- مضاعف الترقية الحالية (0 ترقية = x1)
function Rules.phoneMult(phones: number): number
	if phones <= 0 then
		return 1
	end
	local phone = Config.PHONES[phones]
	return phone and phone.mult or Config.PHONES[#Config.PHONES].mult
end

-- كومة الكسب الكاملة
function Rules.gainStack(caseMult: number, signalMult: number, itemsMult: number, phones: number, ascends: number, passMult: number): number
	return caseMult * signalMult * itemsMult * Rules.phoneMult(phones) * (Config.OS_MULT ^ ascends) * passMult
end

-- معدل محطة عند مستوى ترقية معين: الترقية تضاعف النمو أُسيًا
function Rules.chargerRate(chg: any, lv: number): number
	return chg.rate * (1 + 0.625 * ((5 ^ lv) - 1))
end

function Rules.chargerUpgradeCost(chg: any, lv: number): number
	local base = (chg.cost and chg.cost > 0) and chg.cost or 150
	return base * (6 ^ lv)
end

-- زمن الهدف (ميدالية ذهبية) لمرحلة
function Rules.parTime(stageIndex: number): number
	return 18 + stageIndex * 2
end

-- بونص الجولة: نسبة إضافية + اسم الميدالية ("" إن لا شيء)
function Rules.runBonus(stars: number, falls: number, elapsed: number, stageIndex: number): (number, string)
	local pct = stars * Config.STAR_PCT
	if falls == 0 then
		pct += Config.FLAWLESS_PCT
	end
	local par = Rules.parTime(stageIndex)
	local medal = ""
	if elapsed <= par then
		medal = "gold"
		pct += Config.MEDALS.gold
	elseif elapsed <= par * 1.6 then
		medal = "silver"
		pct += Config.MEDALS.silver
	elseif elapsed <= par * 2.5 then
		medal = "bronze"
		pct += Config.MEDALS.bronze
	end
	return pct, medal
end

-- عجلة الحظ: roll في [0,1)
function Rules.spin(roll: number, stage: number): { kind: string, amount: number, mult: number, minutes: number }
	local tier = 10 ^ math.floor(stage / 5)
	if roll < 0.34 then
		return { kind = "charge", amount = 2000 * tier, mult = 1, minutes = 0 }
	elseif roll < 0.58 then
		return { kind = "wins", amount = 150 * (stage + 1), mult = 1, minutes = 0 }
	elseif roll < 0.78 then
		return { kind = "boost", amount = 0, mult = 2, minutes = 15 }
	elseif roll < 0.93 then
		return { kind = "boost", amount = 0, mult = 3, minutes = 10 }
	end
	return { kind = "jackpot", amount = 100000 * tier, mult = 1, minutes = 0 }
end

-- مكافأة الدخول اليومية: (شحن، Wins)
function Rules.daily(streak: number, stage: number): (number, number)
	local tier = 10 ^ math.floor(stage / 5)
	return 500 * streak * tier, 25 * streak * (stage + 1)
end

-- أرباح الغياب: 50% من أفضل محطة، سقف 8 ساعات
function Rules.offline(hoursAway: number, bestPerSecond: number): number
	local h = math.min(math.max(hoursAway, 0), Config.OFFLINE_CAP_H)
	return math.floor(h * 3600 * bestPerSecond * Config.OFFLINE_EFF)
end

return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Builder</string>
          <string name="Source"><![CDATA[-- Builder.luau — يبني عالم اللعبة كاملًا من الكود عند بدء السيرفر.
-- التصميم v4 «مدينة الأزرار»: عالم نهاري مشرق مريح للعين (مثل خرائط
-- الكيبورد) — الأرض سجادة أزرار ملوّنة بأيقونات: كل خطوة على زر = +1.
-- البناء في مجلد مؤقت ثم استبدال دفعة واحدة (فشل البناء لا يدمر المخبوز).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Builder = {}

local function block(parent, name, size, pos, rgb, mat)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = pos
	p.Anchored = true
	p.Color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	p.Material = mat or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function text(partObj, str, face, rgb)
	local faces = { face }
	if face ~= Enum.NormalId.Top and face ~= Enum.NormalId.Bottom then
		table.insert(faces, face == Enum.NormalId.Front and Enum.NormalId.Back or Enum.NormalId.Front)
	end
	local made
	for _, f in faces do
		local gui = Instance.new("SurfaceGui")
		gui.Face = f
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.Parent = partObj
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = rgb or Color3.new(1, 1, 1)
		tl.TextStrokeTransparency = 0.35
		tl.Text = str
		tl.Parent = gui
		made = made or tl
	end
	return made
end

local function boardText(partObj, title)
	local labels = {}
	for _, f in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = f
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.Parent = partObj
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = Color3.fromRGB(255, 236, 170)
		tl.Text = title
		tl.Parent = gui
		table.insert(labels, tl)
	end
	return labels
end

-- ===== مسار صاعد داخل برج =====
local RISES = { run = 2, gap = 1.2, moving = 2, movingy = 2, vanish = 2, convF = 2, convB = 2, bounce = 2, sweep = 2, narrow = 2, tower = 8.4, split = 2, mid = 0 }

local function towerCourse(parent, stageIdx, plan, cx, theme, isBoss)
	local z = -115
	local y = 3.6 -- سطح المنصة الحالية
	local segments = {}
	local starN = 0
	local prevRise, prevKind = 0, nil
	local function pillar(topY, midZ)
		local h = topY - 2
		if h > 0.5 then
			block(parent, "Pillar", Vector3.new(5, h, 5), Vector3.new(cx, 1 + h / 2, midZ), { 150, 158, 175 })
		end
	end
	local function starAt(x, topY, zz)
		starN += 1
		local s = block(parent, "Star" .. starN, Vector3.new(1.7, 1.7, 1.7), Vector3.new(x, topY + 1.6, zz), { 255, 200, 60 }, Enum.Material.Neon)
		s.Shape = Enum.PartType.Ball
		s:SetAttribute("Star", true)
		s:SetAttribute("StarOf", stageIdx)
	end
	for _, token in plan do
		local kind, arg = string.match(token, "^(%a+):?(%d*)$")
		local len = math.floor((tonumber(arg) or 0) * 0.85)
		if kind == "mid" then
			block(parent, "MidBase", Vector3.new(14, 1, 8), Vector3.new(cx, y - 0.5, z - 4), theme.floor)
			local p = block(parent, "MidPad", Vector3.new(12, 0.6, 6), Vector3.new(cx, y + 0.3, z - 4), { 110, 235, 130 })
			p:SetAttribute("Mid", stageIdx)
			table.insert(segments, { midZ = z - 4, topY = y })
			z -= 8
			prevRise, prevKind = 0, "mid"
		else
			local rise = RISES[kind] or 2
			if #segments > 0 and prevRise >= 1.2 and prevKind ~= "tower" then
				block(parent, "Step", Vector3.new(8, 0.5, 3), Vector3.new(cx, y - prevRise / 2 - 0.25, z + 0.5), theme.floor)
			end
			local mid = z - len / 2
			if kind == "run" then
				block(parent, "Run", Vector3.new(16, 1, len), Vector3.new(cx, y - 0.5, mid), theme.floor)
				pillar(y, mid)
			elseif kind == "gap" then
				-- هواء: اقفز
			elseif kind == "moving" or kind == "movingy" then
				local p = block(parent, "Lift", Vector3.new(11, 1, 10), Vector3.new(cx, y - 0.5, mid), theme.accent)
				p:SetAttribute("Move", true)
				p:SetAttribute("Axis", kind == "movingy" and "Y" or "X")
				p:SetAttribute("Range", kind == "movingy" and 3.2 or 7)
				p:SetAttribute("Speed", 1.1)
				p:SetAttribute("Phase", stageIdx * 1.7 + #segments)
			elseif kind == "vanish" then
				local seg = len / 3
				for k = 1, 3 do
					local p = block(parent, "Blink", Vector3.new(16, 0.8, seg - 1.5), Vector3.new(cx, y - 0.4, z - (k - 0.5) * seg), { 250, 235, 160 })
					p:SetAttribute("Vanish", (k + stageIdx) % 3)
				end
			elseif kind == "convF" or kind == "convB" then
				local p = block(parent, "Belt", Vector3.new(16, 1, len), Vector3.new(cx, y - 0.5, mid), kind == "convF" and { 120, 195, 245 } or { 250, 165, 105 })
				p:SetAttribute("Belt", kind == "convF" and -26 or 18)
				pillar(y, mid)
			elseif kind == "bounce" then
				for _, f in { 0.3, 0.7 } do
					local iz = z - len * f
					block(parent, "Isle", Vector3.new(9, 1, 9), Vector3.new(cx, y - 0.5, iz), theme.floor)
					local p = block(parent, "Pad", Vector3.new(6, 0.6, 6), Vector3.new(cx, y + 0.3, iz), { 250, 120, 195 })
					p:SetAttribute("Bounce", 68)
				end
			elseif kind == "sweep" then
				block(parent, "SweepFloor", Vector3.new(16, 1, len), Vector3.new(cx, y - 0.5, mid), theme.floor)
				block(parent, "SweepPost", Vector3.new(1.2, 3, 1.2), Vector3.new(cx, y + 1.5, mid), { 130, 138, 155 })
				local arm = block(parent, "Spinner", Vector3.new(13, 1.1, 1.1), Vector3.new(cx, y + 1.35, mid), { 240, 90, 80 })
				arm:SetAttribute("Sweep", true)
				arm:SetAttribute("SweepSpeed", 1.1 + stageIdx * 0.04)
				arm:SetAttribute("PivotX", cx)
				arm:SetAttribute("PivotZ", mid)
				pillar(y, mid)
			elseif kind == "narrow" then
				block(parent, "BridgeA", Vector3.new(4.5, 1, len / 2), Vector3.new(cx - 3.5, y - 0.5, z - len / 4), theme.floor)
				block(parent, "BridgeB", Vector3.new(4.5, 1, len / 2), Vector3.new(cx + 3.5, y - 0.5, z - 3 * len / 4), theme.floor)
			elseif kind == "tower" then
				for k = 1, 5 do
					local stepTop = y + (k - 1) * 2.1
					block(parent, "StepT", Vector3.new(9, 1, 9), Vector3.new(cx, stepTop - 0.5, z - (k - 0.5) * (len / 5)), theme.floor)
				end
				pillar(y, mid)
			elseif kind == "split" then
				block(parent, "Safe", Vector3.new(10, 1, len), Vector3.new(cx - 8, y - 0.5, mid), theme.floor)
				block(parent, "Risk", Vector3.new(5, 1, len), Vector3.new(cx + 10.5, y - 0.5, mid), theme.accent)
				for _, f in { 0.25, 0.5, 0.75 } do
					starAt(cx + 10.5, y, z - len * f)
				end
				pillar(y, mid)
			end
			table.insert(segments, { midZ = mid, topY = y })
			z -= len
			y += rise
			prevRise, prevKind = rise, kind
		end
	end
	if isBoss then
		local picks = { math.ceil(#segments * 0.3), math.ceil(#segments * 0.55), math.ceil(#segments * 0.8) }
		for nCell, si in picks do
			local seg = segments[si]
			if seg then
				local cell = block(parent, "Cell_" .. nCell, Vector3.new(2.2, 3, 1.2), Vector3.new(cx + (si % 2 == 0 and -6 or 6), seg.topY + 1.8, seg.midZ), { 110, 230, 130 })
				cell.CanCollide = false
				cell:SetAttribute("Cell", true)
				text(cell, "🔋", Enum.NormalId.Front, Color3.fromRGB(20, 80, 20))
			end
		end
	end
	return y, z
end

function Builder.build()
	-- إضاءة نهارية مشرقة مريحة (بلا نيون يعمي العين)
	local Lighting = game:GetService("Lighting")
	local function getOr(class, name)
		local f = Lighting:FindFirstChild(name)
		if not f then
			f = Instance.new(class)
			f.Name = name
			f.Parent = Lighting
		end
		return f
	end
	local bloom = getOr("BloomEffect", "PhoneBloom")
	bloom.Intensity = 0.22
	bloom.Size = 24
	bloom.Threshold = 0.92
	local cc = getOr("ColorCorrectionEffect", "PhoneGrade")
	cc.Saturation = 0.06
	cc.Contrast = 0.02
	cc.Brightness = 0.02
	local atm = getOr("Atmosphere", "PhoneAir")
	atm.Density = 0.12
	atm.Color = Color3.fromRGB(205, 226, 255)
	atm.Decay = Color3.fromRGB(150, 180, 225)
	atm.Haze = 1
	Lighting.ClockTime = 14
	Lighting.Ambient = Color3.fromRGB(150, 156, 172)
	Lighting.OutdoorAmbient = Color3.fromRGB(178, 188, 205)

	local world = Instance.new("Folder")
	world.Name = "PhoneWorld_Building"
	local nodes = 0

	-- ================= الأرض + سجادة الأزرار =================
	local city = Instance.new("Folder")
	city.Name = "City"
	city.Parent = world
	block(city, "Board", Vector3.new(560, 1, 420), Vector3.new(0, -0.7, -20), { 198, 212, 228 })

	-- زر دائري باستيل + غطاء أبيض كأزرار الكيبورد + أيقونة فوقه.
	-- كل زر يحمل Icon: الدوس على زر جديد = +1 (منطق الخطو في Play).
	local palette = {
		{ 168, 230, 190 }, { 165, 205, 245 }, { 250, 205, 160 }, { 245, 180, 205 },
		{ 205, 190, 240 }, { 245, 230, 160 }, { 160, 225, 225 }, { 245, 175, 165 },
	}
	local glyphs = { "⚡", "🔋", "📶", "⭐", "➕" }
	local function button(parent, x, zz, baseY)
		nodes += 1
		local rgb = palette[((nodes * 7) % #palette) + 1]
		local pad = block(parent, "Btn_" .. nodes, Vector3.new(0.9, 5.2, 5.2), Vector3.new(x, baseY + 0.45, zz), rgb)
		pad.Shape = Enum.PartType.Cylinder
		pad.Orientation = Vector3.new(0, 0, 90)
		pad:SetAttribute("Icon", true)
		local cap = block(parent, "Cap_" .. nodes, Vector3.new(3.6, 0.18, 3.6), Vector3.new(x, baseY + 0.99, zz), { 246, 249, 252 })
		text(cap, glyphs[(nodes % #glyphs) + 1], Enum.NormalId.Top, Color3.fromRGB(52, 62, 84))
		return pad
	end

	local function inRect(x, z, x1, z1, x2, z2)
		return x >= x1 and x <= x2 and z >= z1 and z <= z2
	end
	for gx = -19, 19 do
		for gz = 0, 36 do
			local x = gx * 6
			local z = -92 + gz * 6
			if inRect(x, z, -22, 18, 22, 62) then
				-- ساحة المعالج
			elseif inRect(x, z, -11, 73, 11, 95) then
				-- منصة البداية
			elseif inRect(x, z, -69, 85, -43, 109) then
				-- كشك الأدوات
			else
				local blocked = false
				if z == -92 then
					for i = 1, 15 do
						if math.abs(x - (i - 8) * 36) <= 9 then
							blocked = true -- وسادات دخول الأبراج
							break
						end
					end
				end
				if not blocked then
					button(city, x, z, -0.2)
				end
			end
		end
	end

	-- ================= ساحة المعالج =================
	local plaza = Instance.new("Folder")
	plaza.Name = "Plaza"
	plaza.Parent = world
	block(plaza, "CpuBase", Vector3.new(36, 3, 36), Vector3.new(0, 1.3, 40), { 200, 208, 220 })
	block(plaza, "CpuTop", Vector3.new(30, 0.5, 30), Vector3.new(0, 3.05, 40), { 228, 234, 244 })
	local cpuCore = block(plaza, "CpuCore", Vector3.new(18, 0.7, 18), Vector3.new(0, 3.6, 40), { 120, 190, 240 })
	text(cpuCore, "⚡ CPU ⚡", Enum.NormalId.Top, Color3.fromRGB(15, 50, 70))
	block(plaza, "PinN", Vector3.new(36.5, 0.7, 2), Vector3.new(0, 2.6, 57.2), { 245, 205, 95 })
	block(plaza, "PinS", Vector3.new(36.5, 0.7, 2), Vector3.new(0, 2.6, 22.8), { 245, 205, 95 })
	block(plaza, "PinW", Vector3.new(2, 0.7, 36.5), Vector3.new(-17.2, 2.6, 40), { 245, 205, 95 })
	block(plaza, "PinE", Vector3.new(2, 0.7, 36.5), Vector3.new(17.2, 2.6, 40), { 245, 205, 95 })

	block(plaza, "BannerPostL", Vector3.new(1, 12, 1), Vector3.new(-16, 6, 66), { 150, 155, 170 })
	block(plaza, "BannerPostR", Vector3.new(1, 12, 1), Vector3.new(16, 6, 66), { 150, 155, 170 })
	local banner = block(plaza, "Banner", Vector3.new(36, 7, 1), Vector3.new(0, 10.5, 66), { 240, 244, 250 })
	text(banner, "⚡ CHARGE CITY ⚡", Enum.NormalId.Front, Color3.fromRGB(28, 118, 108))

	block(plaza, "SpawnDeck", Vector3.new(18, 0.3, 18), Vector3.new(0, 0.05, 84), { 215, 222, 235 })
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 0.7, 84)
	spawn.Anchored = true
	spawn.Color = Color3.fromRGB(245, 246, 250)
	spawn.Neutral = true
	spawn.Transparency = 0.4
	spawn.Parent = plaza

	-- لافتة رقم النسخة عند نقطة البداية (تشخيص فوري لأي ملف قديم)
	block(plaza, "VersionPostL", Vector3.new(0.5, 5, 0.5), Vector3.new(-6, 2.5, 93), { 150, 155, 170 })
	block(plaza, "VersionPostR", Vector3.new(0.5, 5, 0.5), Vector3.new(6, 2.5, 93), { 150, 155, 170 })
	local vsign = block(plaza, "VersionSign", Vector3.new(15, 3.5, 0.6), Vector3.new(0, 5.4, 93), { 46, 160, 90 })
	text(vsign, "✅ BUILD v" .. Config.VERSION, Enum.NormalId.Front, Color3.fromRGB(240, 255, 240))

	local function guide(x, zz, txt, rgb)
		block(plaza, "SignPost", Vector3.new(0.5, 5, 0.5), Vector3.new(x, 2.5, zz), { 150, 155, 170 })
		local s = block(plaza, "Sign", Vector3.new(21, 4, 0.6), Vector3.new(x, 5.6, zz), rgb)
		text(s, txt, Enum.NormalId.Front)
	end
	guide(-34, 64, "🏃 EVERY STEP = +⚡", { 86, 184, 128 })
	guide(34, 64, "🔌 CHARGERS ▼ SOUTH", { 96, 150, 222 })
	guide(0, 108, "🗼 TOWERS ▲ NORTH", { 186, 120, 196 })

	-- لوحتا الصدارة
	block(plaza, "BoardPostL", Vector3.new(0.6, 6, 0.6), Vector3.new(-27, 3, 88), { 120, 124, 140 })
	block(plaza, "BoardPostR", Vector3.new(0.6, 6, 0.6), Vector3.new(27, 3, 88), { 120, 124, 140 })
	local bl = block(plaza, "BoardTopLevel", Vector3.new(19, 12, 1), Vector3.new(-27, 9, 88), { 58, 50, 96 })
	local levelLabels = boardText(bl, "🏆 TOP LEVEL 🏆")
	local bw = block(plaza, "BoardTopWins", Vector3.new(19, 12, 1), Vector3.new(27, 9, 88), { 58, 50, 96 })
	local winsLabels = boardText(bw, "🏆 TOP WINS 🏆")

	-- كشك الأدوات
	block(plaza, "StallBase", Vector3.new(24, 1, 20), Vector3.new(-56, 0.9, 96), { 196, 186, 222 })
	local stall = block(plaza, "Stall", Vector3.new(18, 8, 12), Vector3.new(-56, 5.4, 98), { 168, 148, 216 })
	block(plaza, "StallRoof", Vector3.new(21, 1, 15), Vector3.new(-56, 9.8, 98), { 120, 100, 178 })
	text(stall, "🛍️ ITEMS", Enum.NormalId.Front)

	-- مباني المدينة (رامات وشرائح ومكثفات) — ألوان فاتحة
	local buildings = Instance.new("Folder")
	buildings.Name = "Buildings"
	buildings.Parent = world
	local angles = { 0, 35, 55, 145, 180, 215, 260, 325 }
	for bi, deg in angles do
		local a = math.rad(deg)
		local r = deg == 55 and 90 or 118
		local bx, bz = math.cos(a) * r, 40 + math.sin(a) * r
		local kind = (bi - 1) % 3
		if kind == 0 then -- رامة
			block(buildings, "Ram", Vector3.new(12, 26, 4), Vector3.new(bx, 13, bz), { 146, 204, 158 })
			block(buildings, "RamTeeth", Vector3.new(12.4, 2.5, 4.4), Vector3.new(bx, 1.2, bz), { 246, 205, 95 })
			block(buildings, "RamTop", Vector3.new(12.2, 0.8, 4.2), Vector3.new(bx, 25.5, bz), { 110, 214, 170 })
		elseif kind == 1 then -- برج شريحة
			block(buildings, "ChipTower", Vector3.new(18, 30, 18), Vector3.new(bx, 15, bz), { 172, 188, 208 })
			for w = 1, 3 do
				block(buildings, "WinStrip", Vector3.new(14, 1, 0.4), Vector3.new(bx, 6 + w * 7, bz + 9.2), { 150, 205, 245 })
			end
			block(buildings, "ChipTop", Vector3.new(8, 1, 8), Vector3.new(bx, 30.5, bz), { 246, 170, 205 })
		else -- مكثف
			local body = block(buildings, "Capacitor", Vector3.new(15, 8.5, 8.5), Vector3.new(bx, 7.5, bz), { 186, 198, 214 })
			body.Shape = Enum.PartType.Cylinder
			body.Orientation = Vector3.new(0, 0, 90)
			local band = block(buildings, "CapBand", Vector3.new(2, 8.7, 8.7), Vector3.new(bx, 11, bz), { 110, 122, 142 })
			band.Shape = Enum.PartType.Cylinder
			band.Orientation = Vector3.new(0, 0, 90)
			local cap = block(buildings, "CapTop", Vector3.new(1, 9.5, 9.5), Vector3.new(bx, 15.4, bz), { 150, 205, 245 })
			cap.Shape = Enum.PartType.Cylinder
			cap.Orientation = Vector3.new(0, 0, 90)
		end
	end

	-- جزيرة المنطقة الاجتماعية (قريبًا)
	block(world, "IslandBase", Vector3.new(38, 2, 38), Vector3.new(170, 55, -60), { 196, 204, 220 })
	local ring = block(world, "PortalRing", Vector3.new(1.2, 17, 17), Vector3.new(170, 59, -60), { 246, 170, 205 })
	ring.Shape = Enum.PartType.Cylinder
	ring.Orientation = Vector3.new(90, 0, 0)
	local orb = block(world, "Orb", Vector3.new(4, 4, 4), Vector3.new(170, 59, -60), { 250, 215, 245 })
	orb.Shape = Enum.PartType.Ball
	local islandSign = block(world, "IslandSign", Vector3.new(26, 5, 1), Vector3.new(170, 63, -42), { 58, 60, 84 })
	text(islandSign, "🌐 SOCIAL DISTRICT — SOON", Enum.NormalId.Front)

	-- ================= حيّ الشحن (جنوب) =================
	local district = Instance.new("Folder")
	district.Name = "ChargingDistrict"
	district.Parent = world
	block(district, "Slab", Vector3.new(176, 0.5, 46), Vector3.new(0, 0.05, 152), { 198, 190, 218 })
	block(district, "ArchPostL", Vector3.new(1, 11, 1), Vector3.new(-30, 5.5, 132), { 140, 128, 175 })
	block(district, "ArchPostR", Vector3.new(1, 11, 1), Vector3.new(30, 5.5, 132), { 140, 128, 175 })
	local arch = block(district, "Arch", Vector3.new(64, 5, 1.5), Vector3.new(0, 11.5, 132), { 128, 108, 178 })
	text(arch, "🔌 CHARGING DISTRICT", Enum.NormalId.Front)
	for i = 1, 8 do
		button(district, -80 + i * 20 - 10, 138, 0.3)
	end
	local stations = Instance.new("Folder")
	stations.Name = "Stations"
	stations.Parent = district
	for i, chg in Config.CHARGERS do
		local x = -70 + (i - 1) * 20
		local pad = block(stations, "Station_" .. i, Vector3.new(13, 0.25, 13), Vector3.new(x, 0.42, 152),
			i == #Config.CHARGERS and { 250, 205, 80 } or { 140, 205, 245 })
		pad:SetAttribute("Station", i)
		block(stations, "Pylon_" .. i, Vector3.new(3, 15, 3), Vector3.new(x, 7.5, 161), { 198, 206, 218 })
		local capBall = block(stations, "PylonCap_" .. i, Vector3.new(2.6, 2.6, 2.6), Vector3.new(x, 15.8, 161), { 140, 205, 245 })
		capBall.Shape = Enum.PartType.Ball
		local price = chg.cost == 0 and "FREE" or "🏆 " .. Format.num(chg.cost)
		local pylonFace = block(stations, "PylonFace_" .. i, Vector3.new(6, 9, 0.4), Vector3.new(x, 8, 159.2), { 44, 48, 64 })
		text(pylonFace, "🔌 " .. chg.name .. "\n+" .. Format.num(chg.rate) .. "⚡/s\n" .. price, Enum.NormalId.Front)
	end

	-- ================= أبراج المراحل (شمال) =================
	local stages = Instance.new("Folder")
	stages.Name = "Stages"
	stages.Parent = world
	local built = 0
	for i, def in Config.STAGES do
		built += 1
		local theme = Config.THEMES[(i - 1) % #Config.THEMES + 1]
		local cx = (i - 8) * 36
		local sf = Instance.new("Folder")
		sf.Name = "Stage_" .. i
		sf.Parent = stages
		if def.boss then
			sf:SetAttribute("Boss", true)
		end
		local shellRgb = def.boss and { 250, 205, 80 } or theme.accent

		block(sf, "Floor", Vector3.new(30, 2, 110), Vector3.new(cx, 0, -157), { 208, 202, 192 })
		local wallL = block(sf, "WallL", Vector3.new(1, 32, 110), Vector3.new(cx - 15, 17, -157), { 160, 195, 225 }, Enum.Material.Glass)
		wallL.Transparency = 0.55
		local wallR = block(sf, "WallR", Vector3.new(1, 32, 110), Vector3.new(cx + 15, 17, -157), { 160, 195, 225 }, Enum.Material.Glass)
		wallR.Transparency = 0.55
		block(sf, "WallBack", Vector3.new(30, 32, 1), Vector3.new(cx, 17, -212), { 122, 134, 154 })
		block(sf, "FrontL", Vector3.new(11, 32, 1), Vector3.new(cx - 9.5, 17, -102), { 122, 134, 154 })
		block(sf, "FrontR", Vector3.new(11, 32, 1), Vector3.new(cx + 9.5, 17, -102), { 122, 134, 154 })
		block(sf, "Lintel", Vector3.new(30, 5, 1), Vector3.new(cx, 29.5, -102), { 122, 134, 154 })
		block(sf, "Roof", Vector3.new(30, 1, 110), Vector3.new(cx, 33.8, -157), { 100, 112, 132 })
		block(sf, "LightStripL", Vector3.new(0.8, 0.3, 98), Vector3.new(cx - 8, 33.2, -157), { 170, 215, 250 })
		block(sf, "LightStripR", Vector3.new(0.8, 0.3, 98), Vector3.new(cx + 8, 33.2, -157), { 170, 215, 250 })
		for _, px in { -15, 15 } do
			for _, pz in { -102, -212 } do
				block(sf, "PillarPost", Vector3.new(2, 34, 2), Vector3.new(cx + px, 17, pz), { 140, 150, 168 })
			end
			block(sf, "Trim", Vector3.new(0.7, 32, 0.7), Vector3.new(cx + px, 17, -101.4), shellRgb)
		end
		block(sf, "TrimTop", Vector3.new(30.5, 0.7, 0.7), Vector3.new(cx, 33.2, -101.4), shellRgb)
		local header = block(sf, "Header", Vector3.new(30, 5, 2), Vector3.new(cx, 26, -101), shellRgb)
		text(header, "🗼 " .. def.name, Enum.NormalId.Front)

		-- أرضية القتل مدفونة داخل أرضية البرج: السقوط من المسار لا يقتل
		-- بحد ذاته (تعود مشيًا للبداية)، ولا تلمس من يمشي على الأرضية
		local kill = block(sf, "KillFloor", Vector3.new(28, 0.5, 106), Vector3.new(cx, 0.55, -157), { 240, 90, 70 })
		kill:SetAttribute("Kill", true)

		-- منصة البداية + عتبة دخول مشيًا + وسادة الدخول + لافتة البوابة
		block(sf, "StepIn", Vector3.new(16, 2, 4), Vector3.new(cx, 1, -102), theme.floor)
		block(sf, "Dais", Vector3.new(16, 3, 10), Vector3.new(cx, 1.5, -109), theme.floor)
		local begin = block(sf, "Begin", Vector3.new(16, 0.6, 6), Vector3.new(cx, 3.3, -109), { 110, 235, 130 })
		begin:SetAttribute("Begin", i)
		local enter = block(sf, "EnterPad", Vector3.new(12, 0.5, 8), Vector3.new(cx, 0.3, -95), { 110, 235, 130 })
		enter:SetAttribute("Enter", i)
		text(enter, "▶ ENTER", Enum.NormalId.Top, Color3.fromRGB(15, 60, 20))
		block(sf, "GatePostL", Vector3.new(0.5, 9, 0.5), Vector3.new(cx - 7, 4.5, -99), { 140, 148, 165 })
		block(sf, "GatePostR", Vector3.new(0.5, 9, 0.5), Vector3.new(cx + 7, 4.5, -99), { 140, 148, 165 })
		local gate = block(sf, "Gate", Vector3.new(17, 7, 0.8), Vector3.new(cx, 6, -99), shellRgb)
		gate:SetAttribute("Need", def.req)
		text(gate, "🔋 LEVEL " .. def.req .. "\n" .. def.name, Enum.NormalId.Front)

		local topY, endZ = towerCourse(sf, i, def.plan, cx, theme, def.boss)
		block(sf, "FinishDeck", Vector3.new(20, 1, 10), Vector3.new(cx, topY - 0.5, endZ - 5), theme.floor)
		local finish = block(sf, "Finish", Vector3.new(16, 0.8, 8), Vector3.new(cx, topY + 0.4, endZ - 5), { 250, 210, 70 })
		finish:SetAttribute("Finish", i)
		text(finish, "🏆 +" .. Format.num(def.wins) .. " WINS", Enum.NormalId.Top, Color3.fromRGB(80, 60, 0))
		local finSign = block(sf, "FinishSign", Vector3.new(14, 3.5, 0.6), Vector3.new(cx, topY + 4.2, endZ - 9.5), { 122, 134, 154 })
		text(finSign, "🏁 TOP!", Enum.NormalId.Front, Color3.fromRGB(255, 240, 170))
	end

	local voidKill = block(world, "VoidKill", Vector3.new(620, 1, 600), Vector3.new(0, -10, -20), { 240, 90, 70 })
	voidKill.Transparency = 0.6
	voidKill:SetAttribute("Kill", true)

	-- استبدال آمن
	local old = workspace:FindFirstChild("PhoneWorld")
	if old then
		old:Destroy()
	end
	world.Name = "PhoneWorld"
	world.Parent = workspace

	print(("[Phone] world ready: %d buttons, %d towers"):format(nodes, built))
	return { levelLabels = levelLabels, winsLabels = winsLabels }
end

return Builder
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Main.server.luau — نقطة الانطلاق: الريموتات، بناء العالم، تشغيل
-- الأنظمة (بعزل كامل: فشل نظام لا يوقف الباقي)، ولوحتا الصدارة.
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rules = require(Shared.Rules)
local Format = require(Shared.Format)

-- ===== الريموتات =====
local folder = Instance.new("Folder")
folder.Name = "PhoneRemotes"
local function mk(class, name)
	local r = Instance.new(class)
	r.Name = name
	r.Parent = folder
	return r
end
local R = {
	Toast = mk("RemoteEvent", "Toast"),
	StepFX = mk("RemoteEvent", "StepFX"),
	StageCleared = mk("RemoteEvent", "StageCleared"),
	SetCap = mk("RemoteEvent", "SetCap"),
	Teleport = mk("RemoteEvent", "Teleport"),
	GetState = mk("RemoteFunction", "GetState"),
	BuyCase = mk("RemoteFunction", "BuyCase"),
	BuySignal = mk("RemoteFunction", "BuySignal"),
	BuyItem = mk("RemoteFunction", "BuyItem"),
	UnlockCharger = mk("RemoteFunction", "UnlockCharger"),
	UpgradeCharger = mk("RemoteFunction", "UpgradeCharger"),
	BuyLink = mk("RemoteFunction", "BuyLink"),
	UpgradePhone = mk("RemoteFunction", "UpgradePhone"),
	OSUpdate = mk("RemoteFunction", "OSUpdate"),
	RedeemCode = mk("RemoteFunction", "RedeemCode"),
	ClaimGift = mk("RemoteFunction", "ClaimGift"),
	GetQuests = mk("RemoteFunction", "GetQuests"),
	ClaimQuest = mk("RemoteFunction", "ClaimQuest"),
	Spin = mk("RemoteFunction", "Spin"),
}
folder.Parent = ReplicatedStorage

local ctx = {
	remotes = R,
	toast = function(player, text)
		R.Toast:FireClient(player, text)
	end,
}

local Server = script.Parent
local Builder = require(Server.Builder)
local Store = require(Server.Store)
local Play = require(Server.Play)
local Shop = require(Server.Shop)

-- ===== لافتة خطأ مرئية (حتى لا يموت أي فشل بصمت) =====
local function errorSign(title, detail)
	local sign = Instance.new("Part")
	sign.Name = "BUILD_ERROR"
	sign.Size = Vector3.new(70, 14, 1)
	sign.Position = Vector3.new(0, 12, 80)
	sign.Anchored = true
	sign.Color = Color3.fromRGB(200, 30, 30)
	sign.TopSurface = Enum.SurfaceType.Smooth
	sign.Parent = workspace
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.Parent = sign
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextScaled = true
	tl.Font = Enum.Font.GothamBold
	tl.TextColor3 = Color3.new(1, 1, 1)
	tl.Text = title .. ":\n" .. tostring(detail)
	tl.Parent = gui
end

-- ===== بناء العالم =====
local boards
local okBuild, buildResult = pcall(Builder.build)
if okBuild then
	boards = buildResult
else
	warn("[Phone] world build FAILED: " .. tostring(buildResult))
	errorSign("WORLD BUILD ERROR", buildResult)
end

-- ===== تشغيل الأنظمة بعزل (فشل أي نظام يظهر على لافتة) =====
local bootErrors = {}
local function boot(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn(("[Phone] %s failed to start:\n%s"):format(name, debug.traceback(tostring(err))))
		table.insert(bootErrors, name .. ": " .. tostring(err))
	end
end
boot("Store", function()
	Store.init(function(player, data)
		Shop.onJoin(player, data)
	end)
end)
boot("Play", function()
	Play.init(ctx)
end)
boot("Shop", function()
	Shop.init(ctx)
end)
if #bootErrors > 0 then
	errorSign("SERVER START ERROR", table.concat(bootErrors, "\n"))
end

-- ===== لوحتا الصدارة العالميتان =====
-- الـgetters نفسها قد ترمي في مكان غير منشور: pcall دائمًا
local odsLevel, odsWins, nameStore
pcall(function()
	odsLevel = DataStoreService:GetOrderedDataStore("PhoneTopLevel_v1")
	odsWins = DataStoreService:GetOrderedDataStore("PhoneTopWins_v1")
	nameStore = DataStoreService:GetDataStore("PhoneBoardNames_v1")
end)

local function writeBoard(labels, title, rows)
	if not labels then
		return
	end
	local lines = { title }
	for i, row in rows do
		table.insert(lines, i .. ". " .. row.name .. " — " .. row.value)
	end
	if #rows == 0 then
		table.insert(lines, "—")
	end
	local text = table.concat(lines, "\n")
	for _, tl in labels do
		tl.Text = text
	end
end

local function topRows(ods, sessionValue)
	local rows = {}
	local ok, pages = pcall(function()
		return ods:GetSortedAsync(false, 10)
	end)
	if ok and pages then
		for _, entry in pages:GetCurrentPage() do
			local userId = tonumber(string.sub(entry.key, 2))
			local name = "Player"
			if userId then
				local okName, saved = pcall(function()
					return nameStore:GetAsync("u" .. userId)
				end)
				if okName and saved then
					name = saved
				end
			end
			table.insert(rows, { name = name, value = Format.num(entry.value) })
		end
		return rows
	end
	local session = {}
	for player in Store.profiles do
		table.insert(session, { name = player.DisplayName, raw = sessionValue(player) })
	end
	table.sort(session, function(a, b)
		return a.raw > b.raw
	end)
	for i = 1, math.min(10, #session) do
		table.insert(rows, { name = session[i].name, value = Format.num(session[i].raw) })
	end
	return rows
end

task.spawn(function()
	while true do
		for player, data in Store.profiles do
			pcall(function()
				nameStore:SetAsync("u" .. player.UserId, player.DisplayName)
				odsWins:SetAsync("u" .. player.UserId, math.floor(data.wins))
				odsLevel:SetAsync("u" .. player.UserId, (Rules.level(data.lifetime)))
			end)
		end
		if boards then
			writeBoard(boards.levelLabels, "🏆 TOP LEVEL 🏆", topRows(odsLevel, function(p)
				return (Rules.level(Store.profiles[p].lifetime))
			end))
			writeBoard(boards.winsLabels, "🏆 TOP WINS 🏆", topRows(odsWins, function(p)
				return Store.profiles[p].wins
			end))
		end
		task.wait(60)
	end
end)

print("[Phone] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Play</string>
          <string name="Source"><![CDATA[-- Play.luau — حلقة اللعب: الخطو على الأيقونات، محطات الشحن، بوابات
-- المستوى، جولات المراحل (نجوم/سقوط/ميداليات)، وميكانيكية البطارية.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Format = require(Shared.Format)

local Store = require(script.Parent.Store)

local Play = {}
Play.passGain = {} -- [Player] = مضاعف الباسات (يملؤه Shop)
Play.passWins = {} -- [Player] = مضاعف Wins من الباسات
Play.hooks = {} -- { icons=fn(player), stages=fn(player), charge=fn(player, seconds) }

local ctx -- { remotes, toast }
local frac = {} -- كسور الشحن المتراكمة
local lastPad = {} -- [Player] = آخر زر داسه (خطوة على زر جديد = +1 فقط)
local lockToastAt = {} -- [Player] = clock (تنبيه محطة مقفلة)
local gateToastAt = {} -- [Player] = { [stage] = clock }
local beginAt = {} -- [stage] = CFrame (بدايات الأبراج، يملؤها init)
local checkpoints = {} -- [Player] = CFrame
local armed = {} -- [Player] = { [stage] = true }
local runs = {} -- [Player] = { stage, t0, falls, stars=set, battery?, warned50, warned25 }
local cellCd = {} -- [Player] = { [part] = clock }
local bossStages = {} -- [stage] = true
local LOBBY_SPAWN = nil -- يُضبط في init من SpawnLocation

local function toast(player, text)
	if ctx and ctx.toast then
		ctx.toast(player, text)
	end
end

-- ===== المضاعفات =====
local function ownsPass(data, key)
	return data.pass and data.pass[key] == true
end

function Play.caseMult(player)
	local data = Store.profiles[player]
	if not data then
		return 1
	end
	return Rules.bestMult(data.cases, Config.CASES, function(key)
		return ownsPass(data, key)
	end)
end

function Play.signalMult(player)
	local data = Store.profiles[player]
	if not data then
		return 1
	end
	return Rules.bestMult(data.signals, Config.SIGNALS, function(key)
		return ownsPass(data, key)
	end)
end

function Play.cableMult(player)
	local data = Store.profiles[player]
	if not data then
		return 1
	end
	local best = 1
	for _, cable in Config.CABLES do
		if ownsPass(data, cable.pass) and cable.mult > best then
			best = cable.mult
		end
	end
	return best
end

function Play.stack(player)
	local data = Store.profiles[player]
	if not data then
		return 1
	end
	local m = Rules.gainStack(Play.caseMult(player), Play.signalMult(player), Rules.itemsMult(data.items), data.phones, data.ascends, Play.passGain[player] or 1)
	if data.boostUntil and data.boostUntil > os.time() then
		m *= data.boostMult or 1
	end
	return m
end

-- كسب شحن عبر الحلقة (يمر بكل المضاعفات)
function Play.gain(player, base)
	local data = Store.profiles[player]
	if not data then
		return
	end
	frac[player] = (frac[player] or 0) + base * Play.stack(player)
	local whole = math.floor(frac[player])
	if whole > 0 then
		frac[player] -= whole
		data.charge += whole
		data.lifetime += whole
		Store.sync(player)
	end
end

-- منح مباشر (أكواد/هدايا/منتجات): يعدّ في التراكمي أيضًا
function Play.grant(player, amount)
	local data = Store.profiles[player]
	if not data then
		return
	end
	data.charge += amount
	data.lifetime += amount
	Store.sync(player)
end

function Play.batteryOf(player)
	local run = runs[player]
	if run and run.battery then
		return math.max(0, math.floor(run.battery))
	end
	return nil
end

function Play.resetRun(player)
	runs[player] = nil
	armed[player] = {}
	checkpoints[player] = nil
end

local function hrpOf(player)
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

function Play.sendTo(player, cf)
	local hrp = hrpOf(player)
	if hrp then
		hrp.CFrame = cf
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	checkpoints[player] = cf
end

function Play.toLobby(player)
	Play.sendTo(player, LOBBY_SPAWN or CFrame.new(0, 3, 80))
end

function Play.stageStart(i)
	return beginAt[i]
end

function Play.respawn(player)
	local run = runs[player]
	if run then
		run.falls += 1
	end
	local hrp = hrpOf(player)
	if hrp then
		hrp.CFrame = checkpoints[player] or LOBBY_SPAWN
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end

-- ===== إتمام مرحلة =====
local function claim(player, stageIdx, withRun)
	local data = Store.profiles[player]
	local def = Config.STAGES[stageIdx]
	if not (data and def) then
		return
	end
	local reward = def.wins * (Play.passWins[player] or 1)
	local extra = ""
	local run = runs[player]
	if withRun and run and run.stage == stageIdx then
		local starCount = 0
		for _ in run.stars do
			starCount += 1
		end
		local elapsed = os.clock() - run.t0
		local pct, medal = Rules.runBonus(starCount, run.falls, elapsed, stageIdx)
		if pct > 0 then
			reward = math.floor(reward * (1 + pct / 100))
			local bits = {}
			if starCount > 0 then
				table.insert(bits, "⭐x" .. starCount)
			end
			if run.falls == 0 then
				table.insert(bits, "flawless")
			end
			if medal ~= "" then
				table.insert(bits, (medal == "gold" and "🥇" or medal == "silver" and "🥈" or "🥉") .. string.format(" %.1fs", elapsed))
			end
			extra = " (" .. table.concat(bits, " • ") .. " +" .. pct .. "%)"
		end
		local key = "s" .. stageIdx
		if not data.best[key] or elapsed < data.best[key] then
			data.best[key] = math.floor(elapsed * 10) / 10
		end
		runs[player] = nil
	end
	data.wins += reward
	if stageIdx > data.stage then
		data.stage = stageIdx
	end
	Store.sync(player)
	toast(player, "🏆 Stage " .. stageIdx .. " — " .. def.name .. " cleared! +" .. Format.num(reward) .. " Wins" .. extra)
	if ctx and ctx.remotes then
		ctx.remotes.StageCleared:FireClient(player, stageIdx)
	end
	if Play.hooks.stages then
		Play.hooks.stages(player)
	end
end

-- تخطي مدفوع: يمنح الجائزة الأساسية بلا بونص جولة
function Play.claimSkip(player, stageIdx)
	claim(player, stageIdx, false)
end

function Play.clearStageReward(stageIdx)
	local def = Config.STAGES[stageIdx]
	return def and def.wins or 0
end

-- ===== التهيئة =====
function Play.init(context)
	ctx = context
	local world = workspace:WaitForChild("PhoneWorld")
	LOBBY_SPAWN = CFrame.new(0, 3, 84)
	local plaza = world:FindFirstChild("Plaza")
	local spawnLoc = plaza and plaza:FindFirstChild("Spawn")
	if spawnLoc then
		LOBBY_SPAWN = CFrame.new(spawnLoc.Position + Vector3.new(0, 2, 0))
	end
	local stagesFolder = world:FindFirstChild("Stages")
	if stagesFolder then
		for _, sf in stagesFolder:GetChildren() do
			local idx = tonumber(string.match(sf.Name, "Stage_(%d+)"))
			if idx and sf:GetAttribute("Boss") then
				bossStages[idx] = true
			end
		end
	end

	local movers, spinners, blinks, belts, stars = {}, {}, {}, {}, {}
	local enterPads = {}
	local flashBusy = {}
	local function flash(partObj)
		if flashBusy[partObj] then
			return
		end
		flashBusy[partObj] = true
		local c = partObj.Color
		partObj.Color = Color3.fromRGB(255, 255, 235) -- وميض أبيض ناعم بلا نيون
		task.delay(0.18, function()
			if partObj.Parent then
				partObj.Color = c
			end
			flashBusy[partObj] = nil
		end)
	end

	local bounceAt = {}
	for _, d in world:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("Move") then
				table.insert(movers, { part = d, base = d.CFrame, axis = d:GetAttribute("Axis") or "X", range = d:GetAttribute("Range") or 7, speed = d:GetAttribute("Speed") or 1.1, phase = d:GetAttribute("Phase") or 0 })
			end
			if d:GetAttribute("Sweep") then
				table.insert(spinners, { part = d, y = d.Position.Y, px = d:GetAttribute("PivotX") or d.Position.X, pz = d:GetAttribute("PivotZ") or d.Position.Z, speed = d:GetAttribute("SweepSpeed") or 1.2 })
			end
			if d:GetAttribute("Vanish") ~= nil then
				table.insert(blinks, { part = d, phase = d:GetAttribute("Vanish") })
			end
			if d:GetAttribute("Belt") then
				table.insert(belts, { part = d, z = d:GetAttribute("Belt") })
			end
			if d:GetAttribute("Star") then
				local ofStage = d:GetAttribute("StarOf")
				table.insert(stars, { part = d, base = d.Position, phase = math.random() * 6 })
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local run = player and runs[player]
					if run and run.stage == ofStage and not run.stars[d] then
						run.stars[d] = true
						toast(player, "⭐ Star! (+25% stage bonus)")
					end
				end)
			end
			if d:GetAttribute("Enter") then
				table.insert(enterPads, d)
			end
			if d:GetAttribute("Cell") then
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local run = player and runs[player]
					if run and run.battery and run.battery < 100 then
						cellCd[player] = cellCd[player] or {}
						local now = os.clock()
						if now - (cellCd[player][d] or 0) > 8 then
							cellCd[player][d] = now
							run.battery = math.min(100, run.battery + Config.BATTERY_CELL)
							toast(player, "🔋 +" .. Config.BATTERY_CELL .. "% (" .. math.floor(run.battery) .. "%)")
						end
					end
				end)
			end
			if d:GetAttribute("Bounce") then
				local power = d:GetAttribute("Bounce")
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local root = hit.Parent and hit.Parent:FindFirstChild("HumanoidRootPart")
					if player and root then
						local key = player.UserId .. d:GetDebugId()
						local now = os.clock()
						if now - (bounceAt[key] or 0) > 0.35 then
							bounceAt[key] = now
							local v = root.AssemblyLinearVelocity
							root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
						end
					end
				end)
			end
			if d:GetAttribute("Begin") then
				local idx = d:GetAttribute("Begin")
				beginAt[idx] = d.CFrame + Vector3.new(0, 3, 0)
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if not player then
						return
					end
					checkpoints[player] = d.CFrame + Vector3.new(0, 3, 0)
					armed[player] = armed[player] or {}
					armed[player][idx] = true
					local run = runs[player]
					if not run or run.stage ~= idx then
						runs[player] = { stage = idx, t0 = os.clock(), falls = 0, stars = {} }
						if bossStages[idx] then
							runs[player].battery = 100
							toast(player, "🔋 Power-save stage! Grab 🔋 cells — 0% sends you back!")
						end
					end
				end)
			elseif d:GetAttribute("Mid") then
				local idx = d:GetAttribute("Mid")
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						checkpoints[player] = d.CFrame + Vector3.new(0, 3, 0)
						armed[player] = armed[player] or {}
						armed[player][idx] = true
					end
				end)
			elseif d:GetAttribute("Finish") then
				local idx = d:GetAttribute("Finish")
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player and armed[player] and armed[player][idx] then
						armed[player][idx] = false
						claim(player, idx, true)
					end
				end)
			elseif d:GetAttribute("Kill") then
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						Play.respawn(player)
					end
				end)
			end
		end
	end
	-- وسائد دخول الأبراج: بوابة المستوى تُفحص هنا (لا عبور بلا مستوى)
	for _, pad in enterPads do
		local idx = pad:GetAttribute("Enter")
		pad.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if not player then
				return
			end
			local data = Store.profiles[player]
			local target = beginAt[idx]
			local def = Config.STAGES[idx]
			if not (data and target and def) then
				return
			end
			local level = Rules.level(data.lifetime)
			if idx <= data.stage or level >= def.req then
				checkpoints[player] = target
				local root = hit.Parent:FindFirstChild("HumanoidRootPart")
				if root then
					root.CFrame = target
					root.AssemblyLinearVelocity = Vector3.zero
				end
			else
				gateToastAt[player] = gateToastAt[player] or {}
				local now = os.clock()
				if now - (gateToastAt[player][idx] or 0) > 3 then
					gateToastAt[player][idx] = now
					toast(player, "🧱 Tower " .. idx .. " — " .. def.name .. " needs Level " .. def.req .. "!")
				end
			end
		end)
	end
	Play._flash = flash

	-- حلقة الميكانيكيات المتحركة
	local lastCycle = -1
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, m in movers do
			local off = math.sin(t * m.speed + m.phase) * m.range
			m.part.CFrame = m.axis == "Y" and (m.base * CFrame.new(0, off, 0)) or (m.base * CFrame.new(off, 0, 0))
		end
		for _, s in spinners do
			s.part.CFrame = CFrame.new(s.px, s.y, s.pz) * CFrame.Angles(0, t * s.speed, 0)
		end
		local cycle = math.floor(t / 1.1) % 3
		if cycle ~= lastCycle then
			lastCycle = cycle
			for _, b in blinks do
				local solid = b.phase == cycle
				b.part.CanCollide = solid
				b.part.Transparency = solid and 0 or 0.65
			end
		end
		for _, s in stars do
			s.part.Position = s.base + Vector3.new(0, math.sin(t * 2 + s.phase) * 0.3, 0)
		end
		if #belts > 0 then
			for _, player in Players:GetPlayers() do
				local root = hrpOf(player)
				if root then
					for _, belt in belts do
						local bp, bs = belt.part.Position, belt.part.Size
						if math.abs(root.Position.X - bp.X) < bs.X / 2 + 0.5
							and math.abs(root.Position.Z - bp.Z) < bs.Z / 2 + 0.5
							and root.Position.Y > bp.Y and root.Position.Y < bp.Y + 3.2 then
							local v = root.AssemblyLinearVelocity
							root.AssemblyLinearVelocity = Vector3.new(v.X, v.Y, belt.z)
						end
					end
				end
			end
		end
	end)

	-- حلقة اللعب: فحص ما تحت اللاعب + البوابات + البطارية
	RunService.Heartbeat:Connect(function(dt)
		local w = workspace:FindFirstChild("PhoneWorld")
		if not w then
			return
		end
		for _, player in Players:GetPlayers() do
			local data = Store.profiles[player]
			local root = hrpOf(player)
			if not (data and root) then
				continue
			end
			-- ما تحت اللاعب
			local params = OverlapParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { w }
			local hits = workspace:GetPartBoundsInBox(CFrame.new(root.Position - Vector3.new(0, 2.6, 0)), Vector3.new(3.4, 2.2, 3.4), params)
			local now = os.clock()
			local padUnder, bestD = nil, math.huge
			for _, hit in hits do
				if hit:GetAttribute("Icon") then
					local dx = hit.Position.X - root.Position.X
					local dz = hit.Position.Z - root.Position.Z
					local d2 = dx * dx + dz * dz
					if d2 < bestD then
						bestD = d2
						padUnder = hit
					end
				elseif hit:GetAttribute("Station") then
					local idx = hit:GetAttribute("Station")
					local chg = Config.CHARGERS[idx]
					if chg then
						if table.find(data.chargers, idx) then
							Play.gain(player, Rules.chargerRate(chg, data.chargerLv[idx] or 0) * Play.cableMult(player) * dt)
							if Play.hooks.charge then
								Play.hooks.charge(player, dt)
							end
						elseif now - (lockToastAt[player] or 0) > 4 then
							lockToastAt[player] = now
							toast(player, "🔒 Buy the " .. chg.name .. " station in the Chargers panel")
						end
					end
				end
			end
			-- خطوة على زرّ جديد = +شحن (الوقوف على نفس الزر لا يمنح شيئًا)
			if padUnder then
				if padUnder ~= lastPad[player] then
					lastPad[player] = padUnder
					local link = Config.LINKS[data.linkIdx] or Config.LINKS[1]
					Play.gain(player, link.amount)
					flash(padUnder)
					-- صوت كيبورد + رقم طائر عند اللاعب نفسه
					if ctx and ctx.remotes and ctx.remotes.StepFX then
						ctx.remotes.StepFX:FireClient(player, math.max(1, math.floor(link.amount * Play.stack(player) + 0.5)))
					end
					if Play.hooks.icons then
						Play.hooks.icons(player)
					end
				end
			else
				lastPad[player] = nil
			end
			-- سرعة المشي من الشحن: نمو محسوس من أول دقيقة لعب
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				local eff = data.charge
				if data.cap and data.cap > 0 then
					eff = math.min(eff, data.cap)
				end
				hum.WalkSpeed = math.min(16 + math.sqrt(math.max(eff, 0)) / 2, 250)
			end
			-- البطارية
			local run = runs[player]
			if run and run.battery then
				run.battery -= Config.BATTERY_DRAIN * dt
				if run.battery <= 50 and not run.warned50 then
					run.warned50 = true
					toast(player, "🪫 Battery at 50%! Find a 🔋 cell!")
				end
				if run.battery <= 25 and not run.warned25 then
					run.warned25 = true
					toast(player, "🪫⚠️ Battery at 25%!")
				end
				if run.battery <= 0 then
					runs[player] = nil
					toast(player, "🔋 Battery empty! Back to the checkpoint!")
					Play.respawn(player)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		frac[player] = nil
		lastPad[player] = nil
		lockToastAt[player] = nil
		gateToastAt[player] = nil
		checkpoints[player] = nil
		armed[player] = nil
		runs[player] = nil
		cellCd[player] = nil
		Play.passGain[player] = nil
		Play.passWins[player] = nil
	end)
end

return Play
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[-- Shop.luau — المتاجر والباسات والترقيات والأنظمة اليومية.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Format = require(Shared.Format)

local Store = require(script.Parent.Store)
local Play = require(script.Parent.Play)

local Shop = {}
local ctx
local auraOf = {} -- [Player] = Part

local function toast(player, text)
	if ctx and ctx.toast then
		ctx.toast(player, text)
	end
end

local function ownsPassAsync(player, id)
	if id <= 0 then
		return false
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
	end)
	return ok and owns == true
end

local function bestItem(owned, ladder, data)
	local bestIdx, bestMult = 0, 1
	for _, idx in owned do
		local item = ladder[idx]
		if item and item.mult > bestMult then
			bestIdx, bestMult = idx, item.mult
		end
	end
	for idx, item in ladder do
		if item.pass and data.pass[item.pass] and item.mult > bestMult then
			bestIdx, bestMult = idx, item.mult
		end
	end
	return bestIdx, bestMult
end

function Shop.refreshVisuals(player)
	local data = Store.profiles[player]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (data and root) then
		return
	end
	local old = root:FindFirstChild("GlowTrail")
	if old then
		old:Destroy()
	end
	local caseIdx = bestItem(data.cases, Config.CASES, data)
	local caseItem = Config.CASES[caseIdx]
	if caseItem then
		local a0 = root:FindFirstChild("TrailTop")
		if not a0 then
			a0 = Instance.new("Attachment")
			a0.Name = "TrailTop"
			a0.Position = Vector3.new(0, 1, 0.6)
			a0.Parent = root
		end
		local a1 = root:FindFirstChild("TrailBottom")
		if not a1 then
			a1 = Instance.new("Attachment")
			a1.Name = "TrailBottom"
			a1.Position = Vector3.new(0, -1, 0.6)
			a1.Parent = root
		end
		local trail = Instance.new("Trail")
		trail.Name = "GlowTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(Color3.fromRGB(caseItem.color[1], caseItem.color[2], caseItem.color[3]))
		trail.Lifetime = 0.6
		trail.MinLength = 0.1
		trail.Parent = root
	end
	if auraOf[player] then
		auraOf[player]:Destroy()
		auraOf[player] = nil
	end
	local sigIdx = bestItem(data.signals, Config.SIGNALS, data)
	local sigItem = Config.SIGNALS[sigIdx]
	if sigItem then
		local sphere = Instance.new("Part")
		sphere.Name = "SignalAura"
		sphere.Shape = Enum.PartType.Ball
		sphere.Size = Vector3.new(6, 6, 6)
		sphere.Transparency = 0.75
		sphere.Color = Color3.fromRGB(sigItem.color[1], sigItem.color[2], sigItem.color[3])
		sphere.Material = Enum.Material.Neon
		sphere.CanCollide = false
		sphere.Anchored = true
		sphere.Parent = workspace
		auraOf[player] = sphere
	end
end

function Shop.applyPasses(player)
	local data = Store.profiles[player]
	if not data then
		return
	end
	local gain = 1
	for key, id in Config.PASSES do
		if ownsPassAsync(player, id) then
			data.pass[key] = true
		end
	end
	if data.pass.doubleCharge then
		gain *= 2
	end
	if data.pass.vip then
		gain *= 3
		data.pass.cableGold = true
	end
	Play.passGain[player] = gain
	Play.passWins[player] = data.pass.doubleWins and 2 or 1
	Shop.refreshVisuals(player)
end

-- ===== المهام اليومية =====
local function today()
	return math.floor(os.time() / 86400)
end

local function ensureQuestDay(data)
	if data.questDay ~= today() then
		data.questDay = today()
		data.questProg = {}
		data.questDone = {}
	end
end

local function bump(player, id, amount)
	local data = Store.profiles[player]
	if not data then
		return
	end
	ensureQuestDay(data)
	if data.questDone[id] then
		return
	end
	data.questProg[id] = (data.questProg[id] or 0) + amount
end

-- ===== عند دخول لاعب (يستدعيها Main بعد تحميل البيانات) =====
function Shop.onJoin(player, data)
	ensureQuestDay(data)
	-- سلسلة الدخول اليومية
	local day = today()
	if data.loginDay ~= day then
		data.streak = (day - (data.loginDay or 0) == 1) and (data.streak or 0) + 1 or 1
		data.loginDay = day
		local c, w = Rules.daily(data.streak, data.stage)
		Play.grant(player, c)
		data.wins += w
		Store.sync(player)
		task.delay(3, function()
			toast(player, "📅 Day " .. data.streak .. " streak! +" .. Format.num(c) .. " Charge, +" .. Format.num(w) .. " Wins")
		end)
	end
	-- أرباح الغياب
	if data.lastSeen and data.lastSeen > 0 and not RunService:IsStudio() then
		local hours = (os.time() - data.lastSeen) / 3600
		if hours * 60 >= Config.OFFLINE_MIN_MIN then
			local best = 0
			for _, idx in data.chargers do
				local chg = Config.CHARGERS[idx]
				if chg then
					best = math.max(best, Rules.chargerRate(chg, data.chargerLv[idx] or 0))
				end
			end
			local earned = Rules.offline(hours, best)
			if earned > 0 then
				Play.grant(player, earned)
				task.delay(5, function()
					toast(player, "🌙 While you were away: +" .. Format.num(earned) .. " Charge!")
				end)
			end
		end
	end
	-- ترحيب بالجدد
	if data.lifetime == 0 and data.stage == 0 then
		task.delay(2, function()
			toast(player, "👋 1) Step on the APPS to gain Charge ⚡!")
		end)
		task.delay(8, function()
			toast(player, "👋 2) Clear STAGES for Wins — spend them on Cases & Signal!")
		end)
	end
	Shop.applyPasses(player)
end

local function buyLadder(player, ladder, ownedKey, idx, kindLabel)
	local data = Store.profiles[player]
	local item = ladder[idx]
	if not (data and item) then
		return false, "Invalid " .. kindLabel
	end
	if table.find(data[ownedKey], idx) then
		return false, "Already owned"
	end
	if item.pass then
		if data.pass[item.pass] then
			return false, "Already owned (pass)"
		end
		return false, "👑 Robux pass item — get it in the Shop (🛒)"
	end
	if data.wins < item.cost then
		return false, "Need " .. Format.num(item.cost) .. " Wins"
	end
	data.wins -= item.cost
	table.insert(data[ownedKey], idx)
	Store.sync(player)
	Shop.refreshVisuals(player)
	if item.pct then
		return true, "✅ " .. item.name .. " (+" .. item.pct .. "% Charge)"
	end
	return true, "✅ " .. item.name .. " (x" .. tostring(item.mult) .. ")"
end

function Shop.init(context)
	ctx = context
	local R = ctx.remotes

	Play.hooks.icons = function(player)
		bump(player, "icons", 1)
	end
	Play.hooks.stages = function(player)
		bump(player, "stages", 1)
	end
	Play.hooks.charge = function(player, seconds)
		bump(player, "charge", seconds)
	end

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.4)
			Shop.applyPasses(player)
		end)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player)
		Shop.applyPasses(player)
	end)

	R.GetState.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return {}
		end
		local level, into, band = Rules.level(data.lifetime)
		local nextPhone = Config.PHONES[data.phones + 1]
		return {
			cases = data.cases,
			signals = data.signals,
			items = data.items,
			chargers = data.chargers,
			chargerLv = data.chargerLv,
			linkIdx = data.linkIdx,
			pass = data.pass,
			caseMult = Play.caseMult(player),
			signalMult = Play.signalMult(player),
			itemMult = Rules.itemsMult(data.items),
			stack = Play.stack(player),
			level = level,
			levelInto = into,
			levelBand = band,
			phones = data.phones,
			nextPhoneReq = nextPhone and nextPhone.req or nil,
			nextPhoneName = nextPhone and nextPhone.name or nil,
			ascends = data.ascends,
			osMult = Config.OS_MULT ^ data.ascends,
			cap = data.cap,
			giftIn = math.max(0, Config.GIFT_EVERY - (os.time() - (data.lastGift or 0))),
			spinIn = math.max(0, Config.SPIN_EVERY - (os.time() - (data.lastSpin or 0))),
			boostUntil = data.boostUntil or 0,
			boostMult = data.boostMult or 1,
			battery = Play.batteryOf(player),
			stage = data.stage,
		}
	end

	R.BuyCase.OnServerInvoke = function(player, idx)
		return buyLadder(player, Config.CASES, "cases", idx, "case")
	end
	R.BuySignal.OnServerInvoke = function(player, idx)
		return buyLadder(player, Config.SIGNALS, "signals", idx, "signal")
	end
	R.BuyItem.OnServerInvoke = function(player, idx)
		local ok, msg = buyLadder(player, Config.ITEMS, "items", idx, "item")
		if ok then
			msg = "🎒 " .. msg
		end
		return ok, msg
	end

	R.UnlockCharger.OnServerInvoke = function(player, idx)
		local data = Store.profiles[player]
		local chg = Config.CHARGERS[idx]
		if not (data and chg) then
			return false, "Invalid station"
		end
		if table.find(data.chargers, idx) then
			return false, "Already unlocked"
		end
		if data.wins < chg.cost then
			return false, "Need " .. Format.num(chg.cost) .. " Wins"
		end
		data.wins -= chg.cost
		table.insert(data.chargers, idx)
		Store.sync(player)
		return true, "🔌 " .. chg.name .. " unlocked!"
	end

	R.UpgradeCharger.OnServerInvoke = function(player, idx)
		local data = Store.profiles[player]
		local chg = Config.CHARGERS[idx]
		if not (data and chg) then
			return false, "Invalid station"
		end
		if not table.find(data.chargers, idx) then
			return false, "Unlock this station first"
		end
		local lv = data.chargerLv[idx] or 0
		if lv >= Config.CHARGER_MAX_LV then
			return false, "⭐ MAX level"
		end
		local cost = Rules.chargerUpgradeCost(chg, lv)
		if data.wins < cost then
			return false, "Need " .. Format.num(cost) .. " Wins to upgrade"
		end
		data.wins -= cost
		data.chargerLv[idx] = lv + 1
		Store.sync(player)
		return true, "⬆️ " .. chg.name .. " Lv" .. (lv + 1) .. " — now +" .. Format.num(Rules.chargerRate(chg, lv + 1)) .. " Charge/s"
	end

	R.BuyLink.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		local nxt = Config.LINKS[(data.linkIdx or 1) + 1]
		if not nxt then
			return false, "🔗 MAX link owned!"
		end
		if data.wins < nxt.cost then
			return false, "Need " .. Format.num(nxt.cost) .. " Wins for the +" .. Format.num(nxt.amount) .. "⚡/step link"
		end
		data.wins -= nxt.cost
		data.linkIdx += 1
		Store.sync(player)
		return true, "🔗 Link upgraded! Now +" .. Format.num(nxt.amount) .. " Charge per step"
	end

	R.UpgradePhone.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		local nxt = Config.PHONES[data.phones + 1]
		if not nxt then
			return false, "📱 MAX phone reached!"
		end
		local level = Rules.level(data.lifetime)
		if level < nxt.req then
			return false, "📱 " .. nxt.name .. " needs Level " .. nxt.req .. " (you are " .. level .. ")"
		end
		data.charge = 0
		data.lifetime = 0
		data.stage = 0
		data.phones += 1
		Store.sync(player)
		Play.resetRun(player)
		return true, "📱 Upgraded to " .. nxt.name .. "! Gains now x" .. Format.num(Rules.phoneMult(data.phones))
	end

	R.OSUpdate.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		if data.phones < Config.OS_PHONES_NEEDED then
			return false, "🔄 OS Update needs " .. Config.OS_PHONES_NEEDED .. " phone upgrades (you have " .. data.phones .. ")"
		end
		if data.wins < Config.OS_WINS_COST then
			return false, "🔄 OS Update needs " .. Format.num(Config.OS_WINS_COST) .. " Wins"
		end
		data.wins -= Config.OS_WINS_COST
		data.phones = 0
		data.charge = 0
		data.lifetime = 0
		data.stage = 0
		data.ascends += 1
		Store.sync(player)
		Play.resetRun(player)
		Play.toLobby(player)
		return true, "🔄 OS UPDATED! Permanent x" .. Format.num(Config.OS_MULT ^ data.ascends) .. " from OS updates"
	end

	R.RedeemCode.OnServerInvoke = function(player, code)
		local data = Store.profiles[player]
		if not data or type(code) ~= "string" then
			return false, "Invalid code"
		end
		local key = string.upper(code)
		local reward = Config.CODES[key]
		if not reward then
			return false, "❌ Code not found"
		end
		if data.codes[key] then
			return false, "Already used this code"
		end
		data.codes[key] = true
		if reward.charge > 0 then
			Play.grant(player, reward.charge)
		end
		if reward.wins > 0 then
			data.wins += reward.wins
			Store.sync(player)
		end
		return true, "🎁 Code redeemed! +" .. Format.num(reward.charge) .. " Charge, +" .. Format.num(reward.wins) .. " Wins"
	end

	R.ClaimGift.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		local left = Config.GIFT_EVERY - (os.time() - (data.lastGift or 0))
		if left > 0 then
			return false, "🎁 Free gift in " .. math.ceil(left / 60) .. " min"
		end
		data.lastGift = os.time()
		local c = 1000 * (10 ^ math.floor(data.stage / 5))
		local w = 25 * (data.stage + 1)
		Play.grant(player, c)
		data.wins += w
		Store.sync(player)
		return true, "🎁 FREE! +" .. Format.num(c) .. " Charge, +" .. Format.num(w) .. " Wins"
	end

	R.Spin.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		local left = Config.SPIN_EVERY - (os.time() - (data.lastSpin or 0))
		if left > 0 then
			return false, "🎡 Free spin in " .. math.floor(left / 3600) .. "h " .. math.ceil((left % 3600) / 60) .. "m"
		end
		data.lastSpin = os.time()
		local outcome = Rules.spin(math.random(), data.stage)
		if outcome.kind == "charge" then
			Play.grant(player, outcome.amount)
			return true, "🎡 You won +" .. Format.num(outcome.amount) .. " Charge!"
		elseif outcome.kind == "wins" then
			data.wins += outcome.amount
			Store.sync(player)
			return true, "🎡 You won +" .. Format.num(outcome.amount) .. " Wins!"
		elseif outcome.kind == "boost" then
			local now = os.time()
			local active = (data.boostUntil or 0) > now and (data.boostMult or 1) or 1
			data.boostMult = math.max(active, outcome.mult)
			data.boostUntil = math.max(data.boostUntil or 0, now) + outcome.minutes * 60
			return true, "🎡 BOOST! x" .. data.boostMult .. " gains for " .. outcome.minutes .. " min!"
		end
		Play.grant(player, outcome.amount)
		return true, "🎡💎 JACKPOT! +" .. Format.num(outcome.amount) .. " Charge!"
	end

	R.GetQuests.OnServerInvoke = function(player)
		local data = Store.profiles[player]
		if not data then
			return {}
		end
		ensureQuestDay(data)
		local list = {}
		for _, q in Config.QUESTS do
			table.insert(list, {
				id = q.id,
				text = q.text,
				target = q.target,
				progress = math.floor(data.questProg[q.id] or 0),
				claimed = data.questDone[q.id] == true,
			})
		end
		return { streak = data.streak or 1, quests = list }
	end

	R.ClaimQuest.OnServerInvoke = function(player, id)
		local data = Store.profiles[player]
		if not data then
			return false, "No data"
		end
		ensureQuestDay(data)
		for _, q in Config.QUESTS do
			if q.id == id then
				if data.questDone[id] then
					return false, "Already claimed"
				end
				if (data.questProg[id] or 0) < q.target then
					return false, "Quest not finished yet"
				end
				data.questDone[id] = true
				if q.charge > 0 then
					Play.grant(player, q.charge)
				end
				if q.wins > 0 then
					data.wins += q.wins
					Store.sync(player)
				end
				return true, "🎖️ Quest done! +" .. Format.num(q.charge) .. " Charge, +" .. Format.num(q.wins) .. " Wins"
			end
		end
		return false, "Unknown quest"
	end

	R.SetCap.OnServerEvent:Connect(function(player, cap)
		local data = Store.profiles[player]
		if data and type(cap) == "number" then
			data.cap = math.max(0, math.floor(cap))
		end
	end)

	R.Teleport.OnServerEvent:Connect(function(player, dest)
		local data = Store.profiles[player]
		if not data then
			return
		end
		if dest == "lobby" then
			Play.toLobby(player)
		elseif dest == "stage" then
			local target = math.min(data.stage + 1, #Config.STAGES)
			local cf = Play.stageStart(target)
			if cf then
				Play.sendTo(player, cf)
			end
		elseif dest == "world2" then
			toast(player, "🔒 World 2 — Social Apps — is coming in Update 1!")
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local data = player and Store.profiles[player]
		if not (player and data) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if Config.PRODUCTS.skipStage > 0 and receipt.ProductId == Config.PRODUCTS.skipStage then
			if data.stage >= #Config.STAGES then
				Play.claimSkip(player, #Config.STAGES)
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not root then
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
			local nxt = data.stage + 1
			Play.claimSkip(player, nxt)
			local cf = Play.stageStart(nxt)
			if cf then
				Play.sendTo(player, cf)
			end
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		for key, amount in Config.PACK_AMOUNTS do
			local pid = Config.PRODUCTS[key]
			if pid and pid > 0 and receipt.ProductId == pid then
				Play.grant(player, amount)
				toast(player, "⚡ +" .. Format.num(amount) .. " Charge!")
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	RunService.Heartbeat:Connect(function()
		for player, sphere in auraOf do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and sphere.Parent then
				sphere.CFrame = root.CFrame
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if auraOf[player] then
			auraOf[player]:Destroy()
			auraOf[player] = nil
		end
	end)
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[-- Store.luau — بيانات اللاعبين: تحميل/حفظ DataStore + leaderstats.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Rules"))

local Store = {}
Store.profiles = {} -- [Player] = data
Store.values = {} -- [Player] = { charge=NumberValue, wins=..., phones=..., stage=..., level=... }

-- تنبيه حرج: لا تستدعِ GetDataStore في أعلى الموديول — في مكان غير منشور
-- (GameId=0) يرمي خطأً يقتل سكربت السيرفر كله عند الـrequire. كسول + pcall.
local dsCache = nil -- false = حاولنا وفشل
local function getDs()
	if dsCache == nil then
		local ok, res = pcall(function()
			return DataStoreService:GetDataStore("PhoneEscape_v1")
		end)
		dsCache = (ok and res) or false
		if not ok then
			warn("[Phone] DataStore unavailable (unpublished place?): " .. tostring(res))
		end
	end
	return dsCache or nil
end

local function defaults()
	return {
		charge = 0,
		wins = 0,
		lifetime = 0, -- الشحن التراكمي (يقود المستوى، يُصفّر بالترقية)
		stage = 0, -- أعلى مرحلة مخلّصة
		phones = 0, -- عدد ترقيات الهاتف
		ascends = 0, -- عدد تحديثات النظام
		cases = {},
		signals = {},
		items = {},
		chargers = { 1 },
		chargerLv = {},
		linkIdx = 1,
		pass = {}, -- [passKey] = true (من الباسات المشتراة)
		codes = {},
		cap = 0, -- سقف سرعة يدوي (0 = بلا سقف)
		lastGift = 0,
		lastSpin = 0,
		boostUntil = 0,
		boostMult = 1,
		lastSeen = 0,
		loginDay = 0,
		streak = 0,
		questDay = 0,
		questProg = {},
		questDone = {},
		best = {}, -- ["s<idx>"] = أفضل زمن
	}
end

local function bindStats(player: Player, data)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local vals = {}
	local function num(name, value)
		local v = Instance.new("NumberValue")
		v.Name = name
		v.Value = value
		v.Parent = folder
		vals[string.lower(name)] = v
		return v
	end
	num("Charge", data.charge)
	num("Wins", data.wins)
	num("Phones", data.phones)
	num("Stage", data.stage)
	num("Level", (Rules.level(data.lifetime)))
	folder.Parent = player
	Store.values[player] = vals
end

function Store.sync(player: Player)
	local data = Store.profiles[player]
	local vals = Store.values[player]
	if not (data and vals) then
		return
	end
	vals.charge.Value = data.charge
	vals.wins.Value = data.wins
	vals.phones.Value = data.phones
	vals.stage.Value = data.stage
	vals.level.Value = (Rules.level(data.lifetime))
end

function Store.load(player: Player)
	local data = defaults()
	local ds = getDs()
	if ds and not RunService:IsStudio() then
		local ok, saved
		for _ = 1, 2 do -- محاولة + إعادة: قراءة فاشلة لا تمسح تقدم أحد
			ok, saved = pcall(function()
				return ds:GetAsync("p_" .. player.UserId)
			end)
			if ok then
				break
			end
			task.wait(1)
		end
		if ok and type(saved) == "table" then
			for key, value in defaults() do
				if saved[key] ~= nil then
					data[key] = saved[key]
				end
			end
		end
	end
	Store.profiles[player] = data
	bindStats(player, data)
	return data
end

function Store.save(player: Player)
	local data = Store.profiles[player]
	local ds = getDs()
	if not data or not ds or RunService:IsStudio() then
		return
	end
	data.lastSeen = os.time()
	pcall(function()
		ds:SetAsync("p_" .. player.UserId, data)
	end)
end

function Store.init(onLoaded: (Player) -> ())
	Players.PlayerAdded:Connect(function(player)
		local data = Store.load(player)
		if onLoaded then
			onLoaded(player, data)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		Store.save(player)
		Store.profiles[player] = nil
		Store.values[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		if not Store.profiles[player] then
			local data = Store.load(player)
			if onLoaded then
				onLoaded(player, data)
			end
		end
	end
	task.spawn(function()
		while true do
			task.wait(120)
			for player in Store.profiles do
				Store.save(player)
			end
		end
	end)
	game:BindToClose(function()
		for player in Store.profiles do
			Store.save(player)
		end
	end)
end

return Store
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="13">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="14">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="16">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- UI.client.luau — واجهة اللاعب: HUD + لوحات المتاجر والمهام والتنقل.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local R = ReplicatedStorage:WaitForChild("PhoneRemotes")

local gui = Instance.new("ScreenGui")
gui.Name = "PhoneUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function el(class, props, parent)
	local o = Instance.new(class)
	for k, v in props do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function round(o, r)
	el("UICorner", { CornerRadius = UDim.new(0, r or 10) }, o)
end

-- ===== شريط Wins + أزرار اليسار =====
local winsChip = el("TextLabel", {
	Size = UDim2.new(0, 170, 0, 44), Position = UDim2.new(0, 10, 0, 10),
	BackgroundColor3 = Color3.fromRGB(25, 25, 35), BackgroundTransparency = 0.15,
	Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.fromRGB(120, 255, 140), Text = "🏆 0",
}, gui)
round(winsChip, 12)

local function sideBtn(txt, color, order)
	local col = (order - 1) % 2
	local row = math.floor((order - 1) / 2)
	local b = el("TextButton", {
		Size = UDim2.new(0, 118, 0, 60), Position = UDim2.new(0, 10 + col * 126, 0, 66 + row * 68),
		BackgroundColor3 = color, Font = Enum.Font.FredokaOne, TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1), Text = txt, BorderSizePixel = 0,
	}, gui)
	round(b, 12)
	return b
end
local upgradeBtn = sideBtn("📱\nUpgrade", Color3.fromRGB(90, 160, 255), 1)
local giftBtn = sideBtn("🎁\nFREE!", Color3.fromRGB(255, 120, 170), 2)
local tpBtn = sideBtn("🌀\nTeleport", Color3.fromRGB(150, 90, 220), 3)
local caseBtn = sideBtn("📦\nCases", Color3.fromRGB(200, 90, 200), 4)
local signalBtn = sideBtn("📶\nSignal", Color3.fromRGB(70, 130, 230), 5)
local itemBtn = sideBtn("🎒\nItems", Color3.fromRGB(230, 150, 60), 6)
local chargerBtn = sideBtn("🔌\nChargers", Color3.fromRGB(60, 170, 90), 7)
local codeBtn = sideBtn("🔑\nCode", Color3.fromRGB(90, 90, 110), 8)
local osBtn = sideBtn("🔄\nOS Update", Color3.fromRGB(255, 190, 40), 9)
local questBtn = sideBtn("🎖️\nQuests", Color3.fromRGB(220, 170, 40), 10)
local spinBtn = sideBtn("🎡\nSpin", Color3.fromRGB(200, 80, 200), 11)
local linkBtn = sideBtn("🔗\nLinks", Color3.fromRGB(90, 170, 90), 12)

-- رقم النسخة (زاوية الشاشة — تشخيص الملف الصحيح)
el("TextLabel", {
	Size = UDim2.new(0, 70, 0, 22), Position = UDim2.new(1, -76, 1, -26),
	BackgroundTransparency = 0.4, BackgroundColor3 = Color3.fromRGB(20, 20, 30),
	Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.fromRGB(160, 255, 180),
	Text = "v" .. Config.VERSION, BorderSizePixel = 0,
}, gui)

-- ===== شريط الهدف + البطارية =====
local objective = el("TextLabel", {
	Size = UDim2.new(0, 460, 0, 26), Position = UDim2.new(0.5, -230, 0, 118),
	BackgroundColor3 = Color3.fromRGB(20, 20, 35), BackgroundTransparency = 0.35,
	Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.fromRGB(255, 230, 150), Text = "🎯 ...",
}, gui)
round(objective, 8)
local battFrame = el("Frame", {
	Size = UDim2.new(0, 330, 0, 30), Position = UDim2.new(0.5, -165, 0, 150),
	BackgroundColor3 = Color3.fromRGB(30, 30, 40), BorderSizePixel = 0, Visible = false,
}, gui)
round(battFrame, 8)
local battFill = el("Frame", {
	Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(90, 255, 120), BorderSizePixel = 0,
}, battFrame)
round(battFill, 8)
local battText = el("TextLabel", {
	Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
	TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = "🔋 100%",
}, battFrame)

-- ===== الأسفل: الشحن والمستوى والمضاعفات =====
local bigCharge = el("TextLabel", {
	Size = UDim2.new(0, 460, 0, 62), Position = UDim2.new(0.5, -230, 1, -178),
	BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.3, Text = "0 ⚡",
}, gui)
local levelChip = el("TextLabel", {
	Size = UDim2.new(0, 130, 0, 40), Position = UDim2.new(0.5, -330, 1, -112),
	BackgroundColor3 = Color3.fromRGB(90, 60, 160), Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), Text = "Level 1", BorderSizePixel = 0,
}, gui)
round(levelChip, 10)
local barBg = el("Frame", {
	Size = UDim2.new(0, 330, 0, 40), Position = UDim2.new(0.5, -190, 1, -112),
	BackgroundColor3 = Color3.fromRGB(30, 30, 40), BorderSizePixel = 0,
}, gui)
round(barBg, 10)
local barFill = el("Frame", {
	Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(60, 220, 255), BorderSizePixel = 0,
}, barBg)
round(barFill, 10)
local barText = el("TextLabel", {
	Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
	TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = "0 / 100",
}, barBg)
local multLine = el("TextLabel", {
	Size = UDim2.new(0, 700, 0, 30), Position = UDim2.new(0.5, -350, 1, -66),
	BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.fromRGB(200, 220, 255), TextStrokeTransparency = 0.5, Text = "",
}, gui)

local packRow = { { "charge150K", "+150K ⚡" }, { "charge1M", "+1M ⚡" }, { "charge10M", "+10M ⚡" } }
for i, row in packRow do
	local b = el("TextButton", {
		Size = UDim2.new(0, 168, 0, 42), Position = UDim2.new(0.5, -260 + (i - 1) * 178, 1, -34),
		BackgroundColor3 = i == 3 and Color3.fromRGB(255, 190, 40) or Color3.fromRGB(140, 95, 60),
		Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.new(1, 1, 1),
		Text = row[2], BorderSizePixel = 0,
	}, gui)
	round(b, 10)
	b.MouseButton1Click:Connect(function()
		local pid = Config.PRODUCTS[row[1]]
		if pid and pid > 0 then
			MarketplaceService:PromptProductPurchase(player, pid)
		else
			showToast("This product is not set up yet")
		end
	end)
end

-- ===== اليمين: متجر + سقف الشحن =====
local shopBtn = el("TextButton", {
	Size = UDim2.new(0, 150, 0, 58), Position = UDim2.new(1, -160, 0, 10),
	BackgroundColor3 = Color3.fromRGB(255, 90, 160), Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), Text = "🛒 Shop", BorderSizePixel = 0,
}, gui)
round(shopBtn, 12)
local capBox = el("TextBox", {
	Size = UDim2.new(0, 96, 0, 40), Position = UDim2.new(1, -160, 0, 78),
	BackgroundColor3 = Color3.fromRGB(240, 240, 245), Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.fromRGB(30, 30, 40), Text = "", PlaceholderText = "Max charge", BorderSizePixel = 0,
}, gui)
round(capBox, 8)
local capOk = el("TextButton", {
	Size = UDim2.new(0, 54, 0, 40), Position = UDim2.new(1, -58, 0, 78),
	BackgroundColor3 = Color3.fromRGB(60, 200, 90), Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), Text = "OK", BorderSizePixel = 0,
}, gui)
round(capOk, 8)
local capLabel = el("TextLabel", {
	Size = UDim2.new(0, 150, 0, 24), Position = UDim2.new(1, -160, 0, 122),
	BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, Text = "Max Charge: off",
}, gui)
capOk.MouseButton1Click:Connect(function()
	local cap = tonumber(capBox.Text) or 0
	R.SetCap:FireServer(cap)
	capLabel.Text = cap > 0 and ("Max Charge: " .. Format.num(cap)) or "Max Charge: off"
	showToast(cap > 0 and ("🚦 Max charge set to " .. Format.num(cap)) or "🚦 Charge cap removed")
end)

-- ===== التنبيهات + المؤثرات =====
local toast = el("TextLabel", {
	Size = UDim2.new(0, 680, 0, 46), Position = UDim2.new(0.5, -340, 0, 14),
	BackgroundColor3 = Color3.fromRGB(20, 20, 30), BackgroundTransparency = 0.25,
	Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = "", Visible = false,
}, gui)
round(toast, 10)
local toastSeq = 0
function showToast(text)
	toastSeq += 1
	local mine = toastSeq
	toast.Text = text
	toast.Visible = true
	task.delay(2.8, function()
		if toastSeq == mine then
			toast.Visible = false
		end
	end)
end
R.Toast.OnClientEvent:Connect(showToast)

local soundOn, shakeOn, effectsOn = true, true, true
local pop = Instance.new("Sound")
pop.SoundId = "rbxassetid://6026984224"
pop.Volume = 0.3
pop.Parent = gui
local lastPopAt = 0

-- ===== مؤثرات الخطوات: صوت كيبورد ممتع + أرقام طائرة =====
local clickPool = {}
for i = 1, 6 do
	local s = Instance.new("Sound")
	s.SoundId = Config.STEP_SOUNDS[(i - 1) % #Config.STEP_SOUNDS + 1]
	s.Volume = 0.45
	s.Parent = gui
	clickPool[i] = s
end
local clickIdx = 0
local function playStepClick()
	if not soundOn then
		return
	end
	clickIdx = clickIdx % #clickPool + 1
	local s = clickPool[clickIdx]
	s.SoundId = Config.STEP_SOUNDS[math.random(#Config.STEP_SOUNDS)]
	s.PlaybackSpeed = 0.95 + math.random() * 0.13
	s:Play()
end

local floatPool = {}
for i = 1, 20 do
	local bb = el("BillboardGui", {
		Size = UDim2.new(0, 120, 0, 46), StudsOffset = Vector3.new(0, 3, 0),
		AlwaysOnTop = true, Enabled = false,
	}, gui)
	local tl = el("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne, TextScaled = true,
		TextColor3 = Color3.fromRGB(130, 255, 110), TextStrokeTransparency = 0.2, Text = "+1",
	}, bb)
	floatPool[i] = { bb = bb, tl = tl, flying = false }
end
local floatIdx = 0
local function spawnStepNumber(amount)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	floatIdx = floatIdx % #floatPool + 1
	local f = floatPool[floatIdx]
	f.bb.Adornee = hrp
	f.bb.StudsOffset = Vector3.new(math.random(-12, 12) / 10, 3.2, 0)
	f.tl.Text = "+" .. Format.num(amount)
	f.tl.TextTransparency = 0
	f.bb.Enabled = true
	if f.flying then
		return -- أُعيد استخدامها أثناء طيرانها: تحديث الرقم يكفي
	end
	f.flying = true
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 0.8 do
			local k = (os.clock() - t0) / 0.8
			f.bb.StudsOffset = Vector3.new(f.bb.StudsOffset.X, 3.2 + k * 2.4, 0)
			f.tl.TextTransparency = k * k
			task.wait()
		end
		f.bb.Enabled = false
		f.flying = false
	end)
end

R.StepFX.OnClientEvent:Connect(function(amount)
	playStepClick()
	if effectsOn then
		spawnStepNumber(amount or 1)
	end
end)

-- كتم صوت الخطوات الافتراضي: يبقى صوت الكيبورد وحده
local function muteDefaultSteps(char)
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then
		return
	end
	local function kill(s)
		if s:IsA("Sound") and s.Name == "Running" then
			s.Volume = 0
		end
	end
	for _, s in hrp:GetChildren() do
		kill(s)
	end
	hrp.ChildAdded:Connect(kill)
end
player.CharacterAdded:Connect(muteDefaultSteps)
if player.Character then
	task.spawn(muteDefaultSteps, player.Character)
end

R.StageCleared.OnClientEvent:Connect(function()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		local Debris = game:GetService("Debris")
		local cols = { Color3.fromRGB(255, 110, 180), Color3.fromRGB(110, 220, 255), Color3.fromRGB(170, 255, 110), Color3.fromRGB(255, 200, 80) }
		for i = 1, 26 do
			local p = Instance.new("Part")
			p.Size = Vector3.new(0.35, 0.35, 0.35)
			p.Color = cols[(i % #cols) + 1]
			p.Material = Enum.Material.Neon
			p.CanCollide = false
			p.CFrame = root.CFrame + Vector3.new(0, 1, 0)
			p.AssemblyLinearVelocity = Vector3.new(math.random(-14, 14), math.random(14, 26), math.random(-14, 14))
			p.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8))
			p.Parent = workspace
			Debris:AddItem(p, 1.4)
		end
	end
	if shakeOn then
		local cam = workspace.CurrentCamera
		if cam then
			local orig = cam.CFrame
			for _ = 1, 3 do
				cam.CFrame = orig * CFrame.new(math.random(-2, 2) / 20, math.random(-2, 2) / 20, 0)
				task.wait(0.03)
			end
			cam.CFrame = orig
		end
	end
end)

-- ===== اللوحات =====
local panels = {}
local function makePanel(key, title)
	local f = el("Frame", {
		Size = UDim2.new(0, 440, 0, 400), Position = UDim2.new(0.5, -220, 0.5, -200),
		BackgroundColor3 = Color3.fromRGB(28, 28, 40), BorderSizePixel = 0, Visible = false,
	}, gui)
	round(f, 14)
	el("TextLabel", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = title }, f)
	local close = el("TextButton", {
		Size = UDim2.new(0, 38, 0, 38), Position = UDim2.new(1, -44, 0, 4),
		BackgroundColor3 = Color3.fromRGB(200, 60, 60), Font = Enum.Font.FredokaOne,
		TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = "X", BorderSizePixel = 0,
	}, f)
	round(close, 8)
	close.MouseButton1Click:Connect(function()
		f.Visible = false
	end)
	local scroll = el("ScrollingFrame", {
		Size = UDim2.new(1, -16, 1, -56), Position = UDim2.new(0, 8, 0, 50),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, CanvasSize = UDim2.new(0, 0, 0, 0),
	}, f)
	el("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	panels[key] = { frame = f, scroll = scroll }
	return panels[key]
end
local function row(scroll, text, color, onClick)
	local b = el("TextButton", {
		Size = UDim2.new(1, -8, 0, 50), BackgroundColor3 = color, Font = Enum.Font.FredokaOne,
		TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = text, BorderSizePixel = 0,
	}, scroll)
	round(b, 10)
	if onClick then
		b.MouseButton1Click:Connect(onClick)
	end
	return b
end
local OWNED = Color3.fromRGB(70, 130, 70)
local NORMAL = Color3.fromRGB(60, 60, 85)
local function rebuild(panel, fill)
	for _, c in panel.scroll:GetChildren() do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	fill()
	local count = 0
	for _, c in panel.scroll:GetChildren() do
		if c:IsA("TextButton") then
			count += 1
		end
	end
	panel.scroll.CanvasSize = UDim2.new(0, 0, 0, count * 56 + 10)
end

local pCases = makePanel("cases", "📦 CASES")
local pSignals = makePanel("signals", "📶 SIGNAL")
local pItems = makePanel("items", "🎒 ITEMS (+% Charge)")
local pChargers = makePanel("chargers", "🔌 CHARGERS")
local pShop = makePanel("shop", "🛒 SHOP")
local pTp = makePanel("tp", "🌀 TELEPORT")
local pQuests = makePanel("quests", "🎖️ DAILY QUESTS")
local pLinks = makePanel("links", "🔗 FAST-CHARGE LINKS (+⚡ per step)")

local Rules = require(Shared.Rules)
local lastCap = 0
local state = {}
local function refresh()
	local ok, st = pcall(function()
		return R.GetState:InvokeServer()
	end)
	if not (ok and st and st.level) then
		return
	end
	state = st
	lastCap = st.cap or 0
	syncStats()
	levelChip.Text = "Level " .. st.level
	barText.Text = Format.num(st.levelInto) .. " / " .. Format.num(st.levelBand)
	barFill.Size = UDim2.new(math.clamp(st.levelInto / math.max(st.levelBand, 1), 0, 1), 0, 1, 0)
	multLine.Text = "Case & Signal x" .. Format.num(st.caseMult * st.signalMult)
		.. "   •   Items x" .. tostring(st.itemMult)
		.. "   •   Phone x" .. Format.num(Rules.phoneMult(st.phones))
		.. "   •   OS x" .. Format.num(st.osMult)
		.. "   •   TOTAL x" .. Format.num(st.stack)

	rebuild(pCases, function()
		for i, item in Config.CASES do
			local owned = (st.cases and table.find(st.cases, i)) or (item.pass and st.pass[item.pass])
			local price = item.pass and "👑 PASS (in 🛒 Shop)" or "🏆 " .. Format.num(item.cost)
			row(pCases.scroll, item.name .. " x" .. Format.num(item.mult) .. (owned and " ✅" or " — " .. price), owned and OWNED or NORMAL, function()
				local _, msg = R.BuyCase:InvokeServer(i)
				showToast(msg)
				refresh()
			end)
		end
	end)
	rebuild(pSignals, function()
		for i, item in Config.SIGNALS do
			local owned = (st.signals and table.find(st.signals, i)) or (item.pass and st.pass[item.pass])
			local price = item.pass and "👑 PASS (in 🛒 Shop)" or (item.cost == 0 and "FREE" or "🏆 " .. Format.num(item.cost))
			row(pSignals.scroll, item.name .. " x" .. Format.num(item.mult) .. (owned and " ✅" or " — " .. price), owned and OWNED or NORMAL, function()
				local _, msg = R.BuySignal:InvokeServer(i)
				showToast(msg)
				refresh()
			end)
		end
	end)
	rebuild(pItems, function()
		for i, item in Config.ITEMS do
			local owned = st.items and table.find(st.items, i)
			row(pItems.scroll, item.name .. " (+" .. item.pct .. "% Charge)" .. (owned and " ✅" or " — 🏆 " .. Format.num(item.cost)), owned and OWNED or NORMAL, function()
				local _, msg = R.BuyItem:InvokeServer(i)
				showToast(msg)
				refresh()
			end)
		end
	end)
	rebuild(pChargers, function()
		for i, chg in Config.CHARGERS do
			local owned = st.chargers and table.find(st.chargers, i)
			local lv = (st.chargerLv and st.chargerLv[i]) or 0
			local outNow = Rules.chargerRate(chg, lv)
			if not owned then
				local price = chg.cost == 0 and "FREE" or "🏆 " .. Format.num(chg.cost)
				row(pChargers.scroll, chg.name .. " (+" .. Format.num(outNow) .. "⚡/s) — " .. price, NORMAL, function()
					local _, msg = R.UnlockCharger:InvokeServer(i)
					showToast(msg)
					refresh()
				end)
			elseif lv >= Config.CHARGER_MAX_LV then
				row(pChargers.scroll, chg.name .. " Lv" .. lv .. " ⭐ MAX (+" .. Format.num(outNow) .. "⚡/s)", Color3.fromRGB(160, 130, 40))
			else
				local cost = Rules.chargerUpgradeCost(chg, lv)
				local outNext = Rules.chargerRate(chg, lv + 1)
				row(pChargers.scroll, "⬆️ " .. chg.name .. " Lv" .. lv .. " (+" .. Format.num(outNow) .. "⚡/s) → +" .. Format.num(outNext) .. " — 🏆 " .. Format.num(cost), NORMAL, function()
					local _, msg = R.UpgradeCharger:InvokeServer(i)
					showToast(msg)
					refresh()
				end)
			end
		end
	end)
	rebuild(pShop, function()
		local passRows = {
			{ "⚡ Double Charge (x2 gains)", Config.PASSES.doubleCharge },
			{ "🏆 Double Wins (x2)", Config.PASSES.doubleWins },
			{ "👑 VIP (x3 gains + Gold Cable)", Config.PASSES.vip },
			{ "♾️ INFINITY CASE (x" .. Format.num(Config.CASES[11].mult) .. ")", Config.PASSES.infinityCase },
			{ "🌌 GALAXY CASE (x10)", Config.PASSES.galaxyCase },
			{ "🌑 DARKNESS SIGNAL (x10)", Config.PASSES.darknessSignal },
			{ "🔌 GOLD CABLE (stations x3)", Config.PASSES.cableGold },
			{ "🔌 DIAMOND CABLE (stations x9)", Config.PASSES.cableDiamond },
			{ "🔌 CANDY CABLE (stations x25)", Config.PASSES.cableCandy },
			{ "🔌 ADMIN CABLE (stations x100)", Config.PASSES.cableAdmin },
		}
		for _, pr in passRows do
			row(pShop.scroll, pr[1], NORMAL, function()
				if pr[2] > 0 then
					MarketplaceService:PromptGamePassPurchase(player, pr[2])
				else
					showToast("This pass is not set up yet")
				end
			end)
		end
		row(pShop.scroll, "⏩ Skip Next Stage", Color3.fromRGB(180, 120, 30), function()
			if Config.PRODUCTS.skipStage > 0 then
				MarketplaceService:PromptProductPurchase(player, Config.PRODUCTS.skipStage)
			else
				showToast("Skip is not set up yet")
			end
		end)
		row(pShop.scroll, "🔊 Sound: " .. (soundOn and "ON" or "OFF"), Color3.fromRGB(90, 90, 110), function()
			soundOn = not soundOn
			refresh()
		end)
		row(pShop.scroll, "📷 Screen shake: " .. (shakeOn and "ON" or "OFF"), Color3.fromRGB(90, 90, 110), function()
			shakeOn = not shakeOn
			refresh()
		end)
		row(pShop.scroll, "👁 Others' effects: " .. (effectsOn and "ON" or "OFF"), Color3.fromRGB(90, 90, 110), function()
			effectsOn = not effectsOn
			applyEffects()
			refresh()
		end)
	end)
	rebuild(pQuests, function()
		local okQ, q = pcall(function()
			return R.GetQuests:InvokeServer()
		end)
		if okQ and q and q.quests then
			row(pQuests.scroll, "📅 Login streak: " .. (q.streak or 1) .. " day(s) — come back daily!", Color3.fromRGB(90, 90, 110))
			for _, quest in q.quests do
				local done = quest.progress >= quest.target
				local status = quest.claimed and " ✅ CLAIMED" or (done and " — TAP TO CLAIM!" or "")
				row(pQuests.scroll, quest.text .. " (" .. Format.num(math.min(quest.progress, quest.target)) .. "/" .. Format.num(quest.target) .. ")" .. status, quest.claimed and OWNED or NORMAL, function()
					local _, msg = R.ClaimQuest:InvokeServer(quest.id)
					showToast(msg)
					refresh()
				end)
			end
		end
	end)
	rebuild(pLinks, function()
		local cur = st.linkIdx or 1
		for i, link in Config.LINKS do
			if i < cur then
				row(pLinks.scroll, "+" .. Format.num(link.amount) .. " ⚡ / step ✅", Color3.fromRGB(70, 110, 70))
			elseif i == cur then
				row(pLinks.scroll, "▶ +" .. Format.num(link.amount) .. " ⚡ / step (ACTIVE)", Color3.fromRGB(40, 140, 70))
			elseif i == cur + 1 then
				row(pLinks.scroll, "⬆️ +" .. Format.num(link.amount) .. " ⚡ / step — 🏆 " .. Format.num(link.cost), NORMAL, function()
					local _, msg = R.BuyLink:InvokeServer()
					showToast(msg)
					refresh()
				end)
			else
				row(pLinks.scroll, "🔒 +" .. Format.num(link.amount) .. " ⚡ / step — 🏆 " .. Format.num(link.cost), Color3.fromRGB(45, 45, 60))
			end
		end
	end)
	rebuild(pTp, function()
		row(pTp.scroll, "🏠 Lobby", NORMAL, function()
			R.Teleport:FireServer("lobby")
			pTp.frame.Visible = false
		end)
		row(pTp.scroll, "🔒 World 2 — Social Apps (SOON)", Color3.fromRGB(70, 120, 190), function()
			R.Teleport:FireServer("world2")
			pTp.frame.Visible = false
		end)
		row(pTp.scroll, "🚀 My next Stage", NORMAL, function()
			R.Teleport:FireServer("stage")
			pTp.frame.Visible = false
		end)
	end)
end

function applyEffects()
	for _, other in Players:GetPlayers() do
		if other ~= player and other.Character then
			local root = other.Character:FindFirstChild("HumanoidRootPart")
			local trail = root and root:FindFirstChild("GlowTrail")
			if trail then
				trail.Enabled = effectsOn
			end
		end
	end
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	for _, part in workspace:GetChildren() do
		if part.Name == "SignalAura" and part:IsA("BasePart") then
			local mine = myRoot and (part.Position - myRoot.Position).Magnitude < 7
			if not mine then
				part.Transparency = effectsOn and 0.75 or 1
			end
		end
	end
end

local function toggle(panel)
	for _, p in panels do
		p.frame.Visible = (p == panel) and not panel.frame.Visible
	end
	if panel.frame.Visible then
		refresh()
	end
end
caseBtn.MouseButton1Click:Connect(function() toggle(pCases) end)
signalBtn.MouseButton1Click:Connect(function() toggle(pSignals) end)
itemBtn.MouseButton1Click:Connect(function() toggle(pItems) end)
chargerBtn.MouseButton1Click:Connect(function() toggle(pChargers) end)
shopBtn.MouseButton1Click:Connect(function() toggle(pShop) end)
tpBtn.MouseButton1Click:Connect(function() toggle(pTp) end)
questBtn.MouseButton1Click:Connect(function() toggle(pQuests) end)
linkBtn.MouseButton1Click:Connect(function() toggle(pLinks) end)
upgradeBtn.MouseButton1Click:Connect(function()
	local _, msg = R.UpgradePhone:InvokeServer()
	showToast(msg)
	refresh()
end)
osBtn.MouseButton1Click:Connect(function()
	local _, msg = R.OSUpdate:InvokeServer()
	showToast(msg)
	refresh()
end)
giftBtn.MouseButton1Click:Connect(function()
	local _, msg = R.ClaimGift:InvokeServer()
	showToast(msg)
end)
spinBtn.MouseButton1Click:Connect(function()
	local _, msg = R.Spin:InvokeServer()
	showToast(msg)
end)
codeBtn.MouseButton1Click:Connect(function()
	local code = string.upper(capBox.Text)
	if code == "" then
		showToast("Type a code in the cap box first — codes go there too 😉")
		return
	end
	local _, msg = R.RedeemCode:InvokeServer(code)
	showToast(msg)
end)

-- ===== مزامنة الإحصائيات + شفافية البوابات =====
local stats = player:WaitForChild("leaderstats")
function syncStats()
	local chargeNow = stats.Charge.Value
	local eff = lastCap > 0 and math.min(chargeNow, lastCap) or chargeNow
	local spd = math.floor(16 + math.sqrt(math.max(eff, 0)) / 2)
	bigCharge.Text = Format.num(chargeNow) .. " ⚡   🏃 " .. spd
	winsChip.Text = "🏆 " .. Format.num(stats.Wins.Value)
	local level = stats.Level.Value
	local world = workspace:FindFirstChild("PhoneWorld")
	local stagesFolder = world and world:FindFirstChild("Stages")
	if stagesFolder then
		for _, sf in stagesFolder:GetChildren() do
			local gate = sf:FindFirstChild("Gate")
			if gate then
				local need = gate:GetAttribute("Need")
				if need then
					gate.Transparency = level >= need and 0.5 or 0
				end
			end
		end
	end
end
stats.Charge.Changed:Connect(syncStats)
stats.Wins.Changed:Connect(syncStats)
stats.Stage.Changed:Connect(syncStats)
stats.Level.Changed:Connect(syncStats)
stats.Charge.Changed:Connect(function()
	if soundOn and os.clock() - lastPopAt > 0.12 then
		lastPopAt = os.clock()
		pop.PlaybackSpeed = 0.95 + math.random() * 0.15
		pop:Play()
	end
end)
syncStats()

-- ===== حلقة الهدف والبطارية =====
task.spawn(function()
	while true do
		local ok, st = pcall(function()
			return R.GetState:InvokeServer()
		end)
		if ok and st and st.level then
			local text
			if st.stage < #Config.STAGES then
				local nxt = st.stage + 1
				text = "🎯 Next: Stage " .. nxt .. " — needs Level " .. Config.STAGES[nxt].req .. " (you are " .. st.level .. ")"
			else
				text = "🏆 WORLD 1 BEATEN! 📱 Upgrade your phone / 🔄 OS Update to grow stronger"
			end
			local boostLeft = (st.boostUntil or 0) - os.time()
			if boostLeft > 0 then
				text = "🔥 BOOST x" .. (st.boostMult or 1) .. " (" .. math.floor(boostLeft / 60) .. "m " .. (boostLeft % 60) .. "s)  •  " .. text
			end
			objective.Text = text
			if st.battery then
				battFrame.Visible = true
				battFill.Size = UDim2.new(math.clamp(st.battery / 100, 0, 1), 0, 1, 0)
				battFill.BackgroundColor3 = st.battery > 50 and Color3.fromRGB(90, 255, 120) or (st.battery > 25 and Color3.fromRGB(255, 200, 60) or Color3.fromRGB(255, 80, 60))
				battText.Text = "🔋 " .. st.battery .. "%"
			else
				battFrame.Visible = false
			end
		end
		task.wait(2)
	end
end)

task.spawn(function()
	while true do
		refresh()
		applyEffects()
		task.wait(4)
	end
end)
