}
-- العالم 2 (التطبيقات الاجتماعية) — أرقامه جاهزة، يُبنى محتواه في التحديث 1
Config.WORLD2_REQS = { 140, 160, 180, 200, 220, 240, 260, 280, 300, 320, 340, 360 }
