      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[-- Economy: pure math for the Keyboard formula. Loaded by server AND lune tests.
-- v7: numbers aligned to the real +1 Speed Keyboard Escape (researched
-- 2026-10-23): stages gated by LEVEL, documented Wins tables, documented
-- Trails/Auras/Items/Rebirth ladders.
-- Sibling require, Roblox-style. The Lune tests load this file through a
-- small shim (tests/run.luau) in which `script.Parent.Config` resolves to
-- the already-loaded Config module — so no string-path requires appear
-- inside Roblox modules, per the project rule.
local Config = require(script.Parent.Config)

local Economy = {}

-- Stage gates need LEVEL (not raw Speed), like the original.
function Economy.stageLevelReq(stageIndex: number, world: number?): number
	if world == 2 then
		return Config.STAGE_LEVEL_REQS_W2[stageIndex] or math.huge
	end
	return Config.STAGE_LEVEL_REQS[stageIndex] or math.huge
end

function Economy.stageReward(stageIndex: number, world: number?): number
	if world == 2 then
		return Config.STAGE_WINS_W2[stageIndex] or 0
	end
	return Config.STAGE_WINS[stageIndex] or 0
end

function Economy.stageCount(world: number?): number
	return Config.WORLD_STAGE_COUNT[world or 1] or Config.STAGE_COUNT
end

-- Stage course plan for a stage (v8). World 2 reuses World 1's plans
-- rotated by 3 (harder courses) — the builder applies difficulty scaling.
function Economy.stagePlan(stageIndex: number, world: number?): any
	if world == 2 then
		return Config.STAGE_PLANS[((stageIndex + 2) % #Config.STAGE_PLANS) + 1]
	end
	return Config.STAGE_PLANS[stageIndex]
end

-- Par (gold-medal) time in seconds for a stage run.
function Economy.parTime(stageIndex: number, world: number?): number
	return (18 + stageIndex * 2) * (world == 2 and 1.15 or 1)
end

-- Run bonus (v8): returns total bonus percent and the medal name (""/none).
function Economy.runBonus(stars: number, falls: number, elapsed: number, par: number): (number, string)
	local pct = stars * Config.STAR_BONUS_PCT
	if falls == 0 then
		pct += Config.NOFALL_BONUS_PCT
	end
	local medal = ""
	if elapsed <= par then
		medal = "gold"
		pct += Config.MEDAL_BONUS.gold
	elseif elapsed <= par * 1.6 then
		medal = "silver"
		pct += Config.MEDAL_BONUS.silver
	elseif elapsed <= par * 2.5 then
		medal = "bronze"
		pct += Config.MEDAL_BONUS.bronze
	end
	return pct, medal
end

-- Spin wheel (v6): roll is 0..1. Returns a table describing the prize.
function Economy.spinOutcome(roll: number, maxStage: number): { kind: string, amount: number, mult: number, minutes: number }
	local tier = 10 ^ math.floor(maxStage / 5)
	if roll < 0.34 then
		return { kind = "speed", amount = 2000 * tier, mult = 1, minutes = 0 }
	elseif roll < 0.58 then
		return { kind = "wins", amount = 150 * (maxStage + 1), mult = 1, minutes = 0 }
	elseif roll < 0.78 then
		return { kind = "boost", amount = 0, mult = 2, minutes = 15 }
	elseif roll < 0.93 then
		return { kind = "boost", amount = 0, mult = 3, minutes = 10 }
	else
		return { kind = "jackpot", amount = 100000 * tier, mult = 1, minutes = 0 }
	end
end

-- Level from LIFETIME speed earned. Returns level, progress into the level, band size.
-- NOTE: Rebirth/Ascend reset the lifetime total (the original resets Level).
function Economy.levelFor(totalEarned: number): (number, number, number)
	local level = 1
	local remaining = totalEarned
	while true do
		local band = Config.LEVEL_BASE * (Config.LEVEL_GROWTH ^ (level - 1))
		if remaining < band then
			return level, remaining, band
		end
		remaining -= band
		level += 1
		if level > 5000 then
			return level, remaining, band
		end
	end
end

-- Rebirth ladder (documented 1-20). Next rebirth index = currentRebirths + 1.
function Economy.rebirthLevelRequired(currentRebirths: number): number
	return Config.REBIRTH_LEVELS[currentRebirths + 1] or math.huge
end

function Economy.rebirthMult(currentRebirths: number): number
	if currentRebirths <= 0 then
		return 1
	end
	return Config.REBIRTH_MULTS[currentRebirths] or Config.REBIRTH_MULTS[#Config.REBIRTH_MULTS]
end

-- The full gain stack: Rebirth x Ascend x Trail x Aura x Items x Passes
function Economy.gainMultiplier(rebirthMult: number, ascends: number, caseMult: number, signalMult: number, itemMult: number, passMult: number): number
	return rebirthMult * (Config.ASCEND_MULT ^ ascends) * caseMult * signalMult * itemMult * passMult
end

-- Items give +% each and the percentages SUM (original behavior).
function Economy.itemsMult(ownedItems: { number }): number
	local pct = 0
	for _, idx in ownedItems do
		local item = Config.ITEMS[idx]
		if item then
			pct += item.pct
		end
	end
	return 1 + pct / 100
end

-- Free-progression math (v4)
function Economy.dailyReward(streak: number, maxStage: number): (number, number)
	local tier = 10 ^ math.floor(maxStage / 5)
	return 500 * streak * tier, 25 * streak * (maxStage + 1)
end

function Economy.offlineSpeed(hoursAway: number, bestChargerPerSecond: number): number
	local hours = math.min(math.max(hoursAway, 0), Config.OFFLINE_CAP_HOURS)
	return math.floor(hours * 3600 * bestChargerPerSecond * Config.OFFLINE_EFFICIENCY)
end

-- Charger upgrades (v5): upgrade k adds rate x 2.5 x 5^(k-1).
-- Effective rate at level L = rate x (1 + 0.625 x (5^L - 1)).
function Economy.chargerRate(tm: any, level: number): number
	return tm.rate * (1 + 0.625 * ((5 ^ level) - 1))
end

function Economy.chargerOutput(tm: any, level: number): number
	return Economy.chargerRate(tm, level) * tm.mult
end

-- Cost in Wins to go from `currentLevel` to the next level.
function Economy.chargerUpgradeCost(tm: any, currentLevel: number): number
	local base = (tm.cost and tm.cost > 0) and tm.cost or 150
	return base * (6 ^ currentLevel)
end

function Economy.bestOwned(owned: { number }, ladder: { any }): (number, number)
	local bestIndex, bestMult = 0, 1
	for _, idx in owned do
		local item = ladder[idx]
		if item and item.mult > bestMult then
			bestIndex, bestMult = idx, item.mult
		end
	end
	return bestIndex, bestMult
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">NumberFormat</string>
          <string name="Source"><![CDATA[-- NumberFormat: short display for huge numbers, K / M / B / T / Qa / Qi —
-- the same suffix style the original game uses (no "Zillion" there).
local NumberFormat = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

function NumberFormat.format(value: number): string
	if value ~= value then
		return "0"
	end
	if value < 0 then
		return "-" .. NumberFormat.format(-value)
	end
	if value < 1000 then
		if value % 1 == 0 then
			return string.format("%d", value)
		end
		return string.format("%.1f", value)
	end
	local tier = math.floor(math.log10(value) / 3)
	if tier >= #SUFFIXES then
		tier = #SUFFIXES - 1
	end
	local scaled = value / (10 ^ (tier * 3))
	local text
	if scaled >= 100 then
		text = string.format("%d", math.floor(scaled))
	elseif scaled >= 10 then
		text = string.format("%.1f", math.floor(scaled * 10) / 10)
	else
		text = string.format("%.2f", math.floor(scaled * 100) / 100)
	end
	text = string.gsub(text, "%.0+$", "")
	text = string.gsub(text, "(%..-)0+$", "%1")
	return text .. SUFFIXES[tier + 1]
end

return NumberFormat
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- DataService: leaderstats + DataStore persistence per player.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Economy = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Economy"))

local store = DataStoreService:GetDataStore("PhoneCharge_v1")

local DataService = {}
DataService.profiles = {}

local DEFAULTS = {
	Speed = 0,
	Wins = 0,
	Rebirths = 0,
	Ascends = 0,
	TotalEarned = 0, -- lifetime speed: drives Level; RESET by Rebirth/Ascend (v7, like the original)
	MaxStage = 0, -- highest stage cleared
	CasesOwned = {}, -- ladder indexes
	SignalsOwned = {},
	ItemsOwned = {},
	ChargersOwned = { 1 }, -- starter pad owned
	ChargerLevels = {}, -- [chargerIndex] = upgrade level 0..8 (v5)
	InfinityCase = false, -- the Robux crown jewel
	GalaxyCase = false, -- Robux pass trail (v7)
	DarknessSignal = false, -- Robux pass signal
	CableGold = false, -- Robux cables (station-output multipliers)
	CableDiamond = false,
	CableCandy = false,
	CableAdmin = false,
	StepIndex = 1, -- current step pad (v7): +Speed per step from Config.STEP_PADS
	CodesUsed = {},
	SpeedCap = 0, -- 0 = no cap (the "Custom Speed" box in the screenshot)
	LastGift = 0, -- os.time of last free gift claim
	-- v4 free progression
	LastSeen = 0, -- os.time when the profile was last saved (offline earnings)
	LastLoginDay = 0, -- day number (os.time()/86400) of last daily reward
	LoginStreak = 0,
	QuestDay = 0,
	QuestProgress = {}, -- [questId] = number
	QuestClaimed = {}, -- [questId] = true
	BestTimes = {}, -- [ "w<world>_<stage>" ] = best clear seconds (v8 medals)
	-- v6: World 2 progress, spin wheel, temporary boosts
	MaxStageW2 = 0,
	LastSpin = 0,
	BoostUntil = 0, -- os.time when the active boost ends
	BoostMult = 1,
}

local function freshData()
	local data = {}
	for k, v in DEFAULTS do
		data[k] = if type(v) == "table" then table.clone(v) else v
	end
	return data
end

local function bindLeaderstats(player: Player, data)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local speed = Instance.new("NumberValue")
	speed.Name = "Charge"
	speed.Value = data.Speed
	speed.Parent = ls
	local wins = Instance.new("NumberValue")
	wins.Name = "Wins"
	wins.Value = data.Wins
	wins.Parent = ls
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Phones"
	rebirths.Value = data.Rebirths
	rebirths.Parent = ls
	local stage = Instance.new("IntValue")
	stage.Name = "Stage"
	stage.Value = data.MaxStage
	stage.Parent = ls
	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Value = Economy.levelFor(data.TotalEarned)
	level.Parent = ls
	ls.Parent = player
end

function DataService.syncStats(player: Player)
	local data = DataService.profiles[player]
	local ls = player:FindFirstChild("leaderstats")
	if not (data and ls) then
		return
	end
	ls.Charge.Value = data.Speed
	ls.Wins.Value = data.Wins
	ls.Phones.Value = data.Rebirths
	ls.Stage.Value = data.MaxStage
	if ls:FindFirstChild("Level") then
		ls.Level.Value = Economy.levelFor(data.TotalEarned)
	end
end

function DataService.load(player: Player)
	local data = freshData()
	if not RunService:IsStudio() then
		-- one retry: a failed first read must not wipe a veteran's progress
		local ok, saved = pcall(function()
			return store:GetAsync("player_" .. player.UserId)
		end)
		if not ok then
			task.wait(1)
			ok, saved = pcall(function()
				return store:GetAsync("player_" .. player.UserId)
			end)
		end
		if ok and type(saved) == "table" then
			for k in DEFAULTS do
				if saved[k] ~= nil then
					data[k] = saved[k]
				end
			end
		end
	end
	DataService.profiles[player] = data
	bindLeaderstats(player, data)
	return data
end

function DataService.save(player: Player)
	local data = DataService.profiles[player]
	if not data or RunService:IsStudio() then
		return
	end
	data.LastSeen = os.time()
	pcall(function()
		store:SetAsync("player_" .. player.UserId, data)
	end)
end

function DataService.init()
	Players.PlayerAdded:Connect(function(player)
		DataService.load(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		DataService.save(player)
		DataService.profiles[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		if not DataService.profiles[player] then
			DataService.load(player)
		end
	end
	task.spawn(function()
		while true do
			task.wait(120)
			for player in DataService.profiles do
				DataService.save(player)
			end
		end
	end)
	game:BindToClose(function()
		for player in DataService.profiles do
			DataService.save(player)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- MapBuilder v3: clones the screenshot layout of +1 Speed Keyboard Escape.
-- The lobby floor IS a giant keyboard (chocolate keys, pink gradient runway)
-- that runs straight into Stage 1. TOP LEVEL / TOP WINS boards flank the gate.
-- Items Shop stall, event portal, candy decor, charger platform on the side.
-- Then 27 stages (15 in World 1, 12 in Snow World): level gates, courses,
-- kill floors, yellow Wins pads.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)

local MapBuilder = {}
MapBuilder.boardLevelLabels = {}
MapBuilder.boardWinsLabels = {}

local function part(parent, name, size, pos, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = pos
	p.Anchored = true
	p.Color = Color3.fromRGB(color[1], color[2], color[3])
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function label(partObj, text, face, color)
	local faces = { face or Enum.NormalId.Front }
	if faces[1] ~= Enum.NormalId.Top and faces[1] ~= Enum.NormalId.Bottom then
		table.insert(faces, faces[1] == Enum.NormalId.Front and Enum.NormalId.Back or Enum.NormalId.Front)
	end
	local first
	for _, f in faces do
		local gui = Instance.new("SurfaceGui")
		gui.Face = f
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.Parent = partObj
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Text = text
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = color or Color3.new(1, 1, 1)
		tl.TextStrokeTransparency = 0.35
		tl.Parent = gui
		first = first or gui
	end
	return first
end

local function board(partObj, title)
	local labels = {}
	for _, f in { Enum.NormalId.Back, Enum.NormalId.Front } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = f
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.Parent = partObj
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = Color3.fromRGB(255, 230, 120)
		tl.Text = title
		tl.Parent = gui
		table.insert(labels, tl)
	end
	return labels
end

local function lerpColor(a, b, t)
	return {
		math.floor(a[1] + (b[1] - a[1]) * t + 0.5),
		math.floor(a[2] + (b[2] - a[2]) * t + 0.5),
		math.floor(a[3] + (b[3] - a[3]) * t + 0.5),
	}
end

function MapBuilder.build()
	-- Beauty pass (v4): bloom, warm color grade, soft atmosphere.
	local Lighting = game:GetService("Lighting")
	if not Lighting:FindFirstChild("KB_Bloom") then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "KB_Bloom"
		bloom.Intensity = 0.35
		bloom.Size = 24
		bloom.Threshold = 0.85
		bloom.Parent = Lighting
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "KB_Grade"
		cc.Saturation = 0.14
		cc.Contrast = 0.05
		cc.Brightness = 0.02
		cc.Parent = Lighting
		local rays = Instance.new("SunRaysEffect")
		rays.Name = "KB_Rays"
		rays.Intensity = 0.06
		rays.Parent = Lighting
		local atm = Instance.new("Atmosphere")
		atm.Name = "KB_Atmosphere"
		atm.Density = 0.16
		atm.Color = Color3.fromRGB(215, 230, 255)
		atm.Decay = Color3.fromRGB(255, 200, 220)
		atm.Parent = Lighting
		Lighting.ClockTime = 14.2
	end

	-- Build the fresh map off to the side and swap it in only once it is
	-- complete: if anything below errors, the baked map already in the
	-- place survives instead of being destroyed first.
	local map = Instance.new("Folder")
	map.Name = "PhoneMap_Building"
	local keysBuilt, stagesBuilt = 0, 0

	-- ================= LOBBY =================
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = map
	part(lobby, "UnderSlab", Vector3.new(150, 1, 130), Vector3.new(0, -0.7, 34), { 22, 22, 34 })

	-- The giant home screen: app-icon tiles on dark glass. Every icon
	-- stepped on = +1 Charge and flashes.
	local kb = Instance.new("Folder")
	kb.Name = "HomeScreen"
	kb.Parent = lobby
	local pitch = Config.APP_SIZE + Config.APP_GAP
	local appColors = {
		{ 255, 90, 90 }, { 255, 160, 60 }, { 255, 215, 80 }, { 120, 220, 110 },
		{ 70, 200, 190 }, { 80, 160, 255 }, { 150, 110, 255 }, { 255, 110, 190 },
	}
	for r = 1, Config.APP_ROWS do
		local z = 84 - (r - 1) * pitch
		for c = 1, Config.APP_COLS do
			local x = (c - (Config.APP_COLS + 1) / 2) * pitch
			local gi = ((r - 1) * Config.APP_COLS + (c - 1)) % #Config.APP_GLYPHS + 1
			local color = appColors[((r * 3 + c) % #appColors) + 1]
			local key = part(kb, "App_" .. r .. "_" .. c, Vector3.new(Config.APP_SIZE, 0.8, Config.APP_SIZE), Vector3.new(x, 0.4, z), color)
			key:SetAttribute("IsApp", true)
			keysBuilt += 1
			label(key, Config.APP_GLYPHS[gi], Enum.NormalId.Top, Color3.new(1, 1, 1))
			local plateColor = lerpColor(color, { 255, 255, 255 }, 0.25)
			part(kb, "Plate_" .. r .. "_" .. c, Vector3.new(Config.APP_SIZE - 1.3, 0.22, Config.APP_SIZE - 1.3), Vector3.new(x, 0.91, z), plateColor)
		end
	end

	-- Perimeter walls (the phone's bezel) + title
	part(lobby, "WallBack", Vector3.new(150, 10, 1), Vector3.new(0, 5, 93), { 30, 30, 45 })
	part(lobby, "WallL", Vector3.new(1, 10, 118), Vector3.new(-71, 5, 34), { 30, 30, 45 })
	part(lobby, "WallR", Vector3.new(1, 10, 118), Vector3.new(71, 5, 34), { 30, 30, 45 })
	local trim = part(lobby, "TrimBack", Vector3.new(150, 1, 1.4), Vector3.new(0, 10.4, 93), { 90, 230, 255 }, Enum.Material.Neon)
	local title = part(lobby, "TitleSign", Vector3.new(52, 8, 1), Vector3.new(0, 5.5, 92.4), { 40, 40, 55 })
	label(title, "📱 PHONE ESCAPE 📱", Enum.NormalId.Back)

	-- Spawn deck (the home bar)
	part(lobby, "SpawnDeck", Vector3.new(17, 0.3, 17), Vector3.new(0, 0.95, 80), { 210, 210, 220 })
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 1.4, 80)
	spawn.Anchored = true
	spawn.Color = Color3.fromRGB(255, 255, 255)
	spawn.Neutral = true
	spawn.Transparency = 0.4
	spawn.Parent = lobby

	-- Guide signs for new players (v4 comfort): the first 3 things to do
	part(lobby, "Guide1Post", Vector3.new(0.5, 5, 0.5), Vector3.new(0, 2.5, 30), { 90, 90, 100 })
	local g1 = part(lobby, "Guide1", Vector3.new(20, 4, 0.6), Vector3.new(0, 5.6, 30), { 50, 160, 90 })
	label(g1, "1️⃣ STEP ON APPS = +1 ⚡", Enum.NormalId.Back)
	local g2 = part(lobby, "Guide2", Vector3.new(15, 4, 0.6), Vector3.new(49, 4.5, 82), { 60, 120, 220 })
	label(g2, "🔌 CHARGE HERE ➡", Enum.NormalId.Back)
	local g3 = part(lobby, "Guide3", Vector3.new(20, 4, 0.6), Vector3.new(0, 5.6, -8), { 220, 90, 160 })
	label(g3, "🚪 STAGE 1 — LEVEL 1", Enum.NormalId.Back)

	-- TOP LEVEL / TOP WINS boards flanking the Stage 1 gate
	local bLevel = part(lobby, "BoardLevel", Vector3.new(19, 12, 1), Vector3.new(-24, 6.5, -15), { 160, 50, 140 })
	MapBuilder.boardLevelLabels = board(bLevel, "🏆 TOP LEVEL 🏆")
	local bWins = part(lobby, "BoardWins", Vector3.new(19, 12, 1), Vector3.new(24, 6.5, -15), { 160, 50, 140 })
	MapBuilder.boardWinsLabels = board(bWins, "🏆 TOP WINS 🏆")

	-- Items Shop stall (left, on a platform over the keys)
	part(lobby, "ShopPlatform", Vector3.new(24, 1, 20), Vector3.new(-56, 0.9, 58), { 200, 120, 170 })
	local stall = part(lobby, "ItemsShop", Vector3.new(18, 8, 12), Vector3.new(-56, 5.4, 60), { 255, 170, 215 })
	part(lobby, "ShopRoof", Vector3.new(21, 1, 15), Vector3.new(-56, 9.8, 60), { 200, 60, 130 })
	label(stall, "🛍️ ITEMS SHOP", Enum.NormalId.Front)

	-- Event portal arch (right) — decorative, like the screenshot's countdown portal
	part(lobby, "PortalL", Vector3.new(3, 13, 3), Vector3.new(50, 6.5, 62), { 90, 90, 100 })
	part(lobby, "PortalR", Vector3.new(3, 13, 3), Vector3.new(62, 6.5, 62), { 90, 90, 100 })
	local beam = part(lobby, "PortalTop", Vector3.new(15, 3, 3), Vector3.new(56, 13.5, 62), { 90, 90, 100 })
	label(beam, "🌍 WORLD 2 — SOON", Enum.NormalId.Front)

	-- Neon bubble decor (app bubbles rising off the screen)
	local lolColors = { { 255, 110, 180 }, { 110, 220, 255 }, { 170, 255, 110 }, { 255, 190, 90 } }
	for i, pos in { { -66, 26 }, { 66, 26 }, { -66, 84 }, { 66, 84 } } do
		part(lobby, "BubbleStick" .. i, Vector3.new(0.6, 10, 0.6), Vector3.new(pos[1], 5, pos[2]), { 245, 245, 245 })
		local head = part(lobby, "Bubble" .. i, Vector3.new(5.4, 1.4, 5.4), Vector3.new(pos[1], 10.6, pos[2]), lolColors[i], Enum.Material.Neon)
		head.Shape = Enum.PartType.Cylinder
		head.Orientation = Vector3.new(0, 0, 90)
	end
	for i, pos in { { -64, 44 }, { 64, 44 }, { -64, 6 }, { 64, 6 } } do
		local gum = part(lobby, "Puff" .. i, Vector3.new(4, 3, 4), Vector3.new(pos[1], 1.2, pos[2]), lolColors[(i % 4) + 1])
		gum.Shape = Enum.PartType.Ball
	end

	-- Charging-station platform (right side), pads along it
	part(lobby, "ChargePlatform", Vector3.new(17, 1, 118), Vector3.new(58, 0.25, 26), { 45, 45, 60 })
	local tmFolder = Instance.new("Folder")
	tmFolder.Name = "Chargers"
	tmFolder.Parent = lobby
	for i, tm in Config.CHARGERS do
		local z = 74 - (i - 1) * 16
		local pad = part(tmFolder, "Charger_" .. i, Vector3.new(13, 0.25, 13), Vector3.new(58, 0.9, z),
			i == #Config.CHARGERS and { 255, 200, 40 } or { 80, 80, 100 }, Enum.Material.Neon)
		pad:SetAttribute("ChargerIndex", i)
		local costText = tm.cost == 0 and "FREE" or "🏆 " .. NumberFormat.format(tm.cost)
		label(pad, "🔌 " .. tm.name .. "\n+" .. NumberFormat.format(tm.rate) .. "⚡/s\n" .. costText, Enum.NormalId.Top)
	end

	-- ================= COURSE BUILDER (v8) =================
	-- Lays a stage's planned elements over its 84-stud run. Mechanics are
	-- attribute-driven; StageService animates/drives them at runtime.
	local function buildCourse(stageFolder, world, stageIdx, plan, zStart, zEnd, theme)
		local speedScale = world == 2 and 1.35 or 1
		local z = zStart
		local elIdx = 0
		local function star(x, y, zz)
			local st = part(stageFolder, "Star_" .. stageIdx .. "_" .. elIdx, Vector3.new(1.7, 1.7, 1.7), Vector3.new(x, y, zz), { 255, 215, 0 }, Enum.Material.Neon)
			st.Shape = Enum.PartType.Ball
			st:SetAttribute("IsStar", true)
			st:SetAttribute("StarKey", world * 1000 + stageIdx)
			elIdx += 1
		end
		for _, token in plan.elements do
			elIdx += 1
			local name, arg = string.match(token, "^(%a+):?(%d*)$")
			local len = tonumber(arg) or 0
			local zc = z - len / 2
			if name == "run" then
				part(stageFolder, "Run_" .. elIdx, Vector3.new(16, 1, len), Vector3.new(0, 0, zc), theme.floor)
			elseif name == "gap" then
				-- open air over the kill floor
			elseif name == "moving" or name == "movingy" then
				local plat = part(stageFolder, "Moving_" .. elIdx, Vector3.new(11, 1, 10), Vector3.new(0, 0, zc), theme.accent)
				plat:SetAttribute("Moving", true)
				plat:SetAttribute("MoveAxis", name == "movingy" and "Y" or "X")
				plat:SetAttribute("MoveRange", name == "movingy" and 3.2 or 7)
				plat:SetAttribute("MoveSpeed", 1.1 * speedScale)
				plat:SetAttribute("MovePhase", stageIdx * 1.7 + elIdx)
			elseif name == "vanish" then
				local tileLen = len / 3
				for k = 1, 3 do
					local tile = part(stageFolder, "Vanish_" .. elIdx .. "_" .. k, Vector3.new(16, 0.8, tileLen - 1.5), Vector3.new(0, 0, z - (k - 0.5) * tileLen), { 255, 240, 170 }, Enum.Material.Neon)
					tile:SetAttribute("VanishPhase", (k + stageIdx) % 3)
				end
			elseif name == "convF" or name == "convB" then
				local belt = part(stageFolder, "Belt_" .. elIdx, Vector3.new(16, 1, len), Vector3.new(0, 0, zc), name == "convF" and { 90, 200, 255 } or { 255, 150, 90 })
				belt:SetAttribute("ConvZ", name == "convF" and -26 or 18)
			elseif name == "bounce" then
				for _, frac in { 0.3, 0.7 } do
					local islandZ = z - len * frac
					part(stageFolder, "BounceIsle_" .. elIdx, Vector3.new(9, 1, 9), Vector3.new(0, 0, islandZ), theme.floor)
					local padB = part(stageFolder, "BouncePad_" .. elIdx, Vector3.new(6, 0.6, 6), Vector3.new(0, 0.8, islandZ), { 255, 90, 200 }, Enum.Material.Neon)
					padB:SetAttribute("Bounce", 68)
				end
			elseif name == "sweep" then
				part(stageFolder, "SweepFloor_" .. elIdx, Vector3.new(16, 1, len), Vector3.new(0, 0, zc), theme.floor)
				part(stageFolder, "SweepPost_" .. elIdx, Vector3.new(1.2, 3, 1.2), Vector3.new(0, 1.5, zc), { 60, 60, 70 })
				local arm = part(stageFolder, "SweepArm_" .. elIdx, Vector3.new(13, 1.1, 1.1), Vector3.new(0, 1.35, zc), { 235, 70, 60 }, Enum.Material.Neon)
				arm:SetAttribute("Sweeper", true)
				arm:SetAttribute("SweepSpeed", (1.1 + stageIdx * 0.04) * speedScale)
				arm:SetAttribute("PivotX", 0)
				arm:SetAttribute("PivotZ", zc)
			elseif name == "narrow" then
				part(stageFolder, "Narrow_" .. elIdx .. "a", Vector3.new(4.5, 1, len / 2), Vector3.new(-3.5, 0, z - len / 4), theme.floor)
				part(stageFolder, "Narrow_" .. elIdx .. "b", Vector3.new(4.5, 1, len / 2), Vector3.new(3.5, 0, z - 3 * len / 4), theme.floor)
			elseif name == "tower" then
				for k = 1, 5 do
					part(stageFolder, "Tower_" .. elIdx .. "_" .. k, Vector3.new(9, 1, 9), Vector3.new(0, k * 2.1 - 1, z - (k - 0.5) * (len / 5)), theme.floor)
				end
			elseif name == "split" then
				part(stageFolder, "SplitSafe_" .. elIdx, Vector3.new(10, 1, len), Vector3.new(-12.5, 0, zc), theme.floor)
				part(stageFolder, "SplitRisk_" .. elIdx, Vector3.new(5, 1, len), Vector3.new(13.5, 0, zc), theme.accent)
				for _, frac in { 0.25, 0.5, 0.75 } do
					star(13.5, 1.6, z - len * frac)
				end
			elseif name == "mid" then
				local midPad = part(stageFolder, "MidPad_" .. elIdx, Vector3.new(12, 0.6, 6), Vector3.new(0, 0.3, z - 3), { 120, 255, 140 }, Enum.Material.Neon)
				midPad:SetAttribute("MidStart", stageIdx)
				midPad:SetAttribute("World", world)
			end
			z -= len
		end
		if z > zEnd then
			part(stageFolder, "Run_fill", Vector3.new(16, 1, z - zEnd), Vector3.new(0, 0, (z + zEnd) / 2), theme.floor)
		end
	end

	-- ================= STAGES (parameterized per world, v6) =================
	local function buildStages(stagesFolder, world, zOffset, themes)
		local reqTable = world == 2 and Config.STAGE_LEVEL_REQS_W2 or Config.STAGE_LEVEL_REQS
		local winsTable = world == 2 and Config.STAGE_WINS_W2 or Config.STAGE_WINS
		for i = 1, #reqTable do
			local theme = themes[(i - 1) % #themes + 1]
			local zGate = zOffset - Config.STAGE_SPACING * (i - 1) - 20
			local zStart = zGate - 6
			local zEnd = zStart - 84
			local stageFolder = Instance.new("Folder")
			stageFolder.Name = "Stage_" .. i
			stageFolder.Parent = stagesFolder
			stagesBuilt += 1

			local req = reqTable[i]
			local plan = world == 2 and Config.STAGE_PLANS[((i + 2) % #Config.STAGE_PLANS) + 1] or Config.STAGE_PLANS[i]
			local gateColor = plan.boss and { 255, 200, 40 } or theme.accent
			local gate = part(stageFolder, "Gate", Vector3.new(26, 15, 2), Vector3.new(0, 7.5, zGate), gateColor)
			gate:SetAttribute("StageIndex", i)
			gate:SetAttribute("World", world)
			gate:SetAttribute("Requirement", req)
			label(gate, "🔋 LEVEL " .. req .. "\n" .. plan.name, Enum.NormalId.Back)
			part(stageFolder, "GatePostL", Vector3.new(3, 19, 3), Vector3.new(-14.5, 9.5, zGate), gateColor)
			part(stageFolder, "GatePostR", Vector3.new(3, 19, 3), Vector3.new(14.5, 9.5, zGate), gateColor)

			buildCourse(stageFolder, world, i, plan, zStart, zEnd, theme)

			-- Battery stages (bosses): draining battery + pickup cells
			if plan.boss then
				stageFolder:SetAttribute("BatteryDrain", Config.BATTERY_DRAIN_PCT)
				local spots = { { -6, 22 }, { 6, 47 }, { 0, 70 } }
				for n, spot in spots do
					local cell = part(stageFolder, "BatteryPickup_" .. n, Vector3.new(2.2, 3, 1.2), Vector3.new(spot[1], 1.8, zStart - spot[2]), { 90, 255, 120 }, Enum.Material.Neon)
					cell.CanCollide = false
					cell:SetAttribute("IsBattery", true)
					label(cell, "🔋", Enum.NormalId.Front, Color3.fromRGB(20, 80, 20))
				end
			end

			local startPad = part(stageFolder, "StartPad", Vector3.new(16, 0.6, 6), Vector3.new(0, 0.3, zStart - 3), { 120, 255, 140 }, Enum.Material.Neon)
			startPad:SetAttribute("StageStart", i)
			startPad:SetAttribute("World", world)

			local reward = winsTable[i]
			local pad = part(stageFolder, "WinsPad", Vector3.new(16, 0.8, 10), Vector3.new(0, 0.4, zEnd - 5), { 255, 214, 40 }, Enum.Material.Neon)
			pad:SetAttribute("StageWin", i)
			pad:SetAttribute("World", world)
			label(pad, "🏆 +" .. NumberFormat.format(reward) .. " WINS", Enum.NormalId.Top, Color3.fromRGB(80, 60, 0))

			local kill = part(stageFolder, "KillFloor", Vector3.new(60, 1, 100), Vector3.new(0, -8, (zStart + zEnd) / 2), world == 2 and { 90, 180, 255 } or { 255, 70, 40 }, Enum.Material.Neon)
			kill:SetAttribute("IsKill", true)

			local nextGateZ = zOffset - Config.STAGE_SPACING * i - 20
			local bridgeLen = (zEnd - 10) - nextGateZ
			if i < #reqTable then
				part(stageFolder, "Bridge", Vector3.new(16, 1, bridgeLen), Vector3.new(0, 0, (zEnd - 10 + nextGateZ) / 2), theme.floor)
			else
				local fin = part(stageFolder, "Finish", Vector3.new(30, 1, 24), Vector3.new(0, 0, zEnd - 22), { 255, 215, 0 }, Enum.Material.Neon)
				label(fin, "🏆 YOU ESCAPED THE PHONE! 🏆", Enum.NormalId.Top, Color3.fromRGB(80, 60, 0))
			end
		end
	end

	local stages = Instance.new("Folder")
	stages.Name = "Stages"
	stages.Parent = map
	buildStages(stages, 1, 0, Config.STAGE_THEMES)

	-- World 2 teaser (by the arch): Social Apps world ships in Update 1.
	-- Decorative pad only — no portal wiring in v1.
	local teaser = part(lobby, "W2Teaser", Vector3.new(10, 0.5, 10), Vector3.new(40, 1.0, 62), { 120, 120, 140 }, Enum.Material.Neon)
	label(teaser, "🔒 WORLD 2\nSOCIAL APPS — SOON", Enum.NormalId.Top)

	local lobbyKill = part(map, "LobbyKill", Vector3.new(500, 1, 500), Vector3.new(0, -12, -Config.STAGE_SPACING * Config.STAGE_COUNT / 2), { 255, 70, 40 }, Enum.Material.Neon)
	lobbyKill.Transparency = 0.6
	lobbyKill:SetAttribute("IsKill", true)

	-- World 2 (Social Apps) ships in Update 1 — its numbers already live
	-- in Config; v1 builds World 1 only, plus the lobby teaser above.

	-- Seasonal decor (disabled until the first event: Config.SEASONAL)
	if Config.SEASONAL then
		for i, pos in { { -30, 96 }, { 30, 96 }, { -70, 58 }, { 70, 58 }, { -30, -2 }, { 34, -2 } } do
			local pumpkin = part(lobby, "Pumpkin" .. i, Vector3.new(3.4, 2.8, 3.4), Vector3.new(pos[1], 1.4, pos[2]), { 255, 130, 30 })
			pumpkin.Shape = Enum.PartType.Ball
			part(lobby, "PumpkinStem" .. i, Vector3.new(0.5, 0.8, 0.5), Vector3.new(pos[1], 3.1, pos[2]), { 70, 140, 60 })
		end
		for i, pos in { { -52, 20 }, { 52, 20 }, { 0, 108 } } do
			local ghost = part(lobby, "Ghost" .. i, Vector3.new(2.6, 3.4, 2.6), Vector3.new(pos[1], 4.5, pos[2]), { 245, 245, 255 })
			ghost.Shape = Enum.PartType.Ball
			ghost.Transparency = 0.25
		end
	end

	local old = workspace:FindFirstChild("PhoneMap")
	if old then
		old:Destroy()
	end
	map.Name = "PhoneMap"
	map.Parent = workspace

	print(("[Phone] Map built: %d app icons, %d stages"):format(keysBuilt, stagesBuilt))
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[-- QuestService (v4 free progression): daily login + streak, offline earnings,
-- and the Medal Quests (daily). Free players must progress well — Robux only
-- speeds things up; that is what keeps a game alive and growing.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local NumberFormat = require(Shared.NumberFormat)

local DataService = require(script.Parent.DataService)
local SpeedService = require(script.Parent.SpeedService)

local QuestService = {}
local remotes
local trainFrac = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

-- Daily quests roll over at midnight even for players who stay online:
-- every quest read/write goes through this first.
local function ensureQuestDay(data)
	local day = today()
	if data.QuestDay ~= day then
		data.QuestDay = day
		data.QuestProgress = {}
		data.QuestClaimed = {}
	end
end

local function toast(player, text)
	if remotes then
		remotes.Toast:FireClient(player, text)
	end
end

local function bestChargerPerSecond(data): number
	local best = 0
	for _, idx in data.ChargersOwned do
		local tm = Config.CHARGERS[idx]
		if tm then
			local level = (data.ChargerLevels and data.ChargerLevels[idx]) or 0
			best = math.max(best, Economy.chargerOutput(tm, level))
		end
	end
	return best
end

local function onJoin(player: Player)
	local data = DataService.profiles[player]
	if not data then
		return
	end
	-- Offline earnings (uses LastSeen stamped by the previous session's save)
	if data.LastSeen and data.LastSeen > 0 then
		local awaySeconds = os.time() - data.LastSeen
		if awaySeconds >= Config.OFFLINE_MIN_MINUTES * 60 then
			local hours = awaySeconds / 3600
			local earned = Economy.offlineSpeed(hours, bestChargerPerSecond(data))
			if earned > 0 then
				SpeedService.grantSpeed(player, earned)
				toast(player, "🌙 While you were away: +" .. NumberFormat.format(earned) .. " Charge!")
			end
		end
	end
	-- Daily login + streak
	local day = today()
	if data.LastLoginDay ~= day then
		if data.LastLoginDay == day - 1 then
			data.LoginStreak += 1
		else
			data.LoginStreak = 1
		end
		data.LastLoginDay = day
		local speedReward, winsReward = Economy.dailyReward(data.LoginStreak, data.MaxStage)
		SpeedService.grantSpeed(player, speedReward)
		data.Wins += winsReward
		DataService.syncStats(player)
		toast(player, "📅 Day " .. data.LoginStreak .. " streak! +" .. NumberFormat.format(speedReward) .. " Charge, +" .. NumberFormat.format(winsReward) .. " Wins")
	end
	-- Daily quests reset
	ensureQuestDay(data)
	-- Welcome guidance for brand-new players
	if data.TotalEarned == 0 and data.MaxStage == 0 then
		task.delay(2, function()
			toast(player, "👋 1) Step on the APPS to gain Charge ⚡!")
		end)
		task.delay(7, function()
			toast(player, "👋 2) Clear STAGES to earn Wins, 3) spend Wins on Cases & Signal!")
		end)
	end
end

local function bump(player: Player, questId: string, amount: number)
	local data = DataService.profiles[player]
	if not data then
		return
	end
	ensureQuestDay(data)
	data.QuestProgress[questId] = math.min((data.QuestProgress[questId] or 0) + amount, 1000000000)
end

function QuestService.init(remotesFolder)
	remotes = remotesFolder
	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			local data = DataService.profiles[player]
			while not data do
				task.wait(0.2)
				data = DataService.profiles[player]
			end
			task.wait(0.5)
			onJoin(player)
		end)
	end)
	for _, player in Players:GetPlayers() do
		if DataService.profiles[player] then
			task.spawn(onJoin, player)
		end
	end

	SpeedService.hooks.onKey = function(player)
		bump(player, "keys", 1)
	end
	SpeedService.hooks.onTrain = function(player, dt)
		trainFrac[player] = (trainFrac[player] or 0) + dt
		if trainFrac[player] >= 1 then
			local whole = math.floor(trainFrac[player])
			trainFrac[player] -= whole
			bump(player, "train", whole)
		end
	end
	local StageService = require(script.Parent.StageService)
	StageService.onClaim = function(player)
		bump(player, "stages", 1)
	end
	Players.PlayerRemoving:Connect(function(player)
		trainFrac[player] = nil
	end)

	remotes.GetQuests.OnServerInvoke = function(player)
		local data = DataService.profiles[player]
		if not data then
			return {}
		end
		ensureQuestDay(data)
		local out = { streak = data.LoginStreak, quests = {} }
		for _, q in Config.QUESTS do
			table.insert(out.quests, {
				id = q.id,
				text = q.text,
				target = q.target,
				progress = math.floor(data.QuestProgress[q.id] or 0),
				claimed = data.QuestClaimed[q.id] == true,
				wins = q.wins,
				speed = q.speed,
			})
		end
		return out
	end

	remotes.ClaimQuest.OnServerInvoke = function(player, questId)
		local data = DataService.profiles[player]
		if not data then
			return false, "No data"
		end
		ensureQuestDay(data)
		for _, q in Config.QUESTS do
			if q.id == questId then
				if data.QuestClaimed[questId] then
					return false, "Already claimed"
				end
				if (data.QuestProgress[questId] or 0) < q.target then
					return false, "Not finished yet"
				end
				data.QuestClaimed[questId] = true
				if q.speed > 0 then
					SpeedService.grantSpeed(player, q.speed)
				end
				if q.wins > 0 then
					data.Wins += q.wins
					DataService.syncStats(player)
				end
				return true, "🎖️ Quest done! +" .. NumberFormat.format(q.speed) .. " Charge, +" .. NumberFormat.format(q.wins) .. " Wins"
			end
		end
		return false, "Unknown quest"
	end
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">ServerMain</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- ServerMain: remotes, map, services, and the global TOP LEVEL / TOP WINS boards.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local NumberFormat = require(Shared.NumberFormat)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(class, name): Instance
	local r = Instance.new(class)
	r.Name = name
	r.Parent = remotes
	return r
end
local R = {
	Toast = remote("RemoteEvent", "Toast"),
	StageCleared = remote("RemoteEvent", "StageCleared"),
	SetCap = remote("RemoteEvent", "SetCap"),
	Teleport = remote("RemoteEvent", "Teleport"),
	GetState = remote("RemoteFunction", "GetState"),
	BuyCase = remote("RemoteFunction", "BuyCase"),
	BuySignal = remote("RemoteFunction", "BuySignal"),
	BuyItem = remote("RemoteFunction", "BuyItem"),
	UnlockCharger = remote("RemoteFunction", "UnlockCharger"),
	UpgradeCharger = remote("RemoteFunction", "UpgradeCharger"),
	BuyStep = remote("RemoteFunction", "BuyStep"),
	UpgradePhone = remote("RemoteFunction", "UpgradePhone"),
	Ascend = remote("RemoteFunction", "Ascend"),
	RedeemCode = remote("RemoteFunction", "RedeemCode"),
	ClaimGift = remote("RemoteFunction", "ClaimGift"),
	GetQuests = remote("RemoteFunction", "GetQuests"),
	ClaimQuest = remote("RemoteFunction", "ClaimQuest"),
	Spin = remote("RemoteFunction", "Spin"),
}
remotes.Parent = ReplicatedStorage

local Server = script.Parent
local MapBuilder = require(Server.MapBuilder)
local DataService = require(Server.DataService)
local SpeedService = require(Server.SpeedService)
local StageService = require(Server.StageService)
local ShopService = require(Server.ShopService)

-- Fail-safe: if the map build throws, show the error in-world instead of
-- leaving the player in an empty map with no explanation.
local ok, buildErr = pcall(MapBuilder.build)
if not ok then
	-- Fail-safe: never leave the player in an empty world without an explanation.
	warn("[Phone] Map build FAILED: " .. tostring(buildErr))
	local sign = Instance.new("Part")
	sign.Name = "BUILD_ERROR"
	sign.Size = Vector3.new(70, 14, 1)
	sign.Position = Vector3.new(0, 12, 80)
	sign.Anchored = true
	sign.Color = Color3.fromRGB(200, 30, 30)
	sign.Material = Enum.Material.SmoothPlastic
	sign.TopSurface = Enum.SurfaceType.Smooth
	sign.Parent = workspace
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.Parent = sign
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextScaled = true
	tl.Font = Enum.Font.GothamBold
	tl.TextColor3 = Color3.new(1, 1, 1)
	tl.Text = "MAP BUILD ERROR:\n" .. tostring(buildErr)
	tl.Parent = gui
end
local QuestService = require(Server.QuestService)

-- Every service init is isolated: one failing service must never stop the
-- others — and never stop the map (already built above) from appearing.
local function initService(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn(("[Phone] %s init FAILED:\n%s"):format(name, debug.traceback(tostring(err))))
	end
end
initService("DataService", DataService.init)
SpeedService.toastFn = function(player, text)
	R.Toast:FireClient(player, text)
end
initService("SpeedService", SpeedService.init)
initService("StageService", function()
	StageService.init(R)
end)
initService("ShopService", function()
	ShopService.init(R)
end)
initService("QuestService", function()
	QuestService.init(R)
end)

-- ===== Global boards: TOP LEVEL and TOP WINS (OrderedDataStores) =====
local odsLevel = DataStoreService:GetOrderedDataStore("TopLevel_v1")
local odsWins = DataStoreService:GetOrderedDataStore("TopWins_v1")
local nameStore = DataStoreService:GetDataStore("BoardNames_v1")

local function setBoard(labels, title, rows)
	if not labels then
		return
	end
	local lines = { title }
	for i, row in rows do
		table.insert(lines, i .. ". " .. row.name .. " — " .. row.value)
	end
	if #rows == 0 then
		table.insert(lines, "—")
	end
	local text = table.concat(lines, "\n")
	for _, tl in labels do
		tl.Text = text
	end
end

local function topRows(ods, sessionValue)
	local rows = {}
	local ok, pages = pcall(function()
		return ods:GetSortedAsync(false, 10)
	end)
	if ok and pages then
		local entries = pages:GetCurrentPage()
		for _, entry in entries do
			local userId = tonumber(string.sub(entry.key, 2))
			local name = "Player"
			if userId then
				local okName, saved = pcall(function()
					return nameStore:GetAsync("u" .. userId)
				end)
				if okName and saved then
					name = saved
				end
			end
			table.insert(rows, { name = name, value = NumberFormat.format(entry.value) })
		end
		return rows
	end
	-- Studio / failure fallback: rank this server's players
	local session = {}
	for player in DataService.profiles do
		table.insert(session, { name = player.DisplayName, raw = sessionValue(player) })
	end
	table.sort(session, function(a, b)
		return a.raw > b.raw
	end)
	for i = 1, math.min(10, #session) do
		table.insert(rows, { name = session[i].name, value = NumberFormat.format(session[i].raw) })
	end
	return rows
end

task.spawn(function()
	while true do
		for player, data in DataService.profiles do
			pcall(function()
				nameStore:SetAsync("u" .. player.UserId, player.DisplayName)
				odsWins:SetAsync("u" .. player.UserId, math.floor(data.Wins))
				odsLevel:SetAsync("u" .. player.UserId, Economy.levelFor(data.TotalEarned))
			end)
		end
		setBoard(MapBuilder.boardLevelLabels, "🏆 TOP LEVEL 🏆", topRows(odsLevel, function(p)
			return Economy.levelFor(DataService.profiles[p].TotalEarned)
		end))
		setBoard(MapBuilder.boardWinsLabels, "🏆 TOP WINS 🏆", topRows(odsWins, function(p)
			return DataService.profiles[p].Wins
		end))
		task.wait(60)
	end
end)

print("[Phone] Server ready. Config stages:", Config.STAGE_COUNT)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- ShopService v3: passes, Wins shops (Trails / Auras / Items / Chargers),
-- Rebirth (level-gated) + Ascend, codes, free gift, teleport, custom speed cap,
-- buy-speed developer products, and equipped trail/aura visuals.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local NumberFormat = require(Shared.NumberFormat)

local DataService = require(script.Parent.DataService)
local SpeedService = require(script.Parent.SpeedService)
local StageService = require(script.Parent.StageService)

local ShopService = {}
local signalParts = {}

local function ownsPass(player: Player, id: number): boolean
	if id <= 0 then
		return false
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
	end)
	return ok and owns == true
end

function ShopService.applyPasses(player: Player)
	local data = DataService.profiles[player]
	local mult = 1
	if ownsPass(player, Config.PASSES.DoubleCharge) then
		mult *= 2
	end
	if ownsPass(player, Config.PASSES.VIP) then
		mult *= 3
		if data then
			data.CableGold = true -- VIP includes the gold cable
		end
	end
	SpeedService.passMult[player] = mult
	SpeedService.winMult[player] = ownsPass(player, Config.PASSES.DoubleWins) and 2 or 1
	if data then
		if ownsPass(player, Config.PASSES.InfinityCase) then
			data.InfinityCase = true
		end
		if ownsPass(player, Config.PASSES.GalaxyCase) then
			data.GalaxyCase = true
		end
		if ownsPass(player, Config.PASSES.DarknessSignal) then
			data.DarknessSignal = true
		end
		for _, cable in Config.CABLES do
			if ownsPass(player, Config.PASSES[cable.pass]) then
				data[cable.pass] = true
			end
		end
	end
	ShopService.refreshVisuals(player)
end

function ShopService.refreshVisuals(player: Player)
	local data = DataService.profiles[player]
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (data and hrp) then
		return
	end
	local oldTrail = hrp:FindFirstChild("CaseTrail")
	if oldTrail then
		oldTrail:Destroy()
	end
	local a0 = hrp:FindFirstChild("TrailTop")
	local a1 = hrp:FindFirstChild("TrailBottom")
	local caseIdx = Economy.bestOwned(data.CasesOwned, Config.CASES)
	local caseItem = Config.CASES[caseIdx]
	-- pass trails can outrank the best Wins trail (Galaxy x10, Infinity x5M)
	for _, item in Config.CASES do
		if item.pass and data[item.pass] and (not caseItem or item.mult > caseItem.mult) then
			caseItem = item
		end
	end
	if caseItem then
		if not a0 then
			a0 = Instance.new("Attachment")
			a0.Name = "TrailTop"
			a0.Position = Vector3.new(0, 1, 0.6)
			a0.Parent = hrp
		end
		if not a1 then
			a1 = Instance.new("Attachment")
			a1.Name = "TrailBottom"
			a1.Position = Vector3.new(0, -1, 0.6)
			a1.Parent = hrp
		end
		local trail = Instance.new("Trail")
		trail.Name = "CaseTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(Color3.fromRGB(caseItem.color[1], caseItem.color[2], caseItem.color[3]))
		trail.Lifetime = 0.6
		trail.MinLength = 0.1
		trail.Parent = hrp
	end
	if signalParts[player] then
		signalParts[player]:Destroy()
		signalParts[player] = nil
	end
	local signalIdx = Economy.bestOwned(data.SignalsOwned, Config.SIGNALS)
	local signalItem = Config.SIGNALS[signalIdx]
	for _, item in Config.SIGNALS do
		if item.pass and data[item.pass] and (not signalItem or item.mult > signalItem.mult) then
			signalItem = item
		end
	end
	if signalItem then
		local sphere = Instance.new("Part")
		sphere.Name = "Signal"
		sphere.Shape = Enum.PartType.Ball
		sphere.Size = Vector3.new(6, 6, 6)
		sphere.Transparency = 0.75
		sphere.Color = Color3.fromRGB(signalItem.color[1], signalItem.color[2], signalItem.color[3])
		sphere.Material = Enum.Material.Neon
		sphere.CanCollide = false
		sphere.Anchored = true
		sphere.Parent = workspace
		signalParts[player] = sphere
	end
end

local function buyLadder(player, ladder, ownedTable, idx, kindName)
	local data = DataService.profiles[player]
	local item = ladder[idx]
	if not (data and item) then
		return false, "Invalid " .. kindName
	end
	if table.find(ownedTable, idx) then
		return false, "Already owned"
	end
	if item.pass then
		if data[item.pass] then
			return false, "Already owned (pass)"
		end
		return false, "👑 Robux pass item — get it in the Shop (🛒)"
	end
	if data.Wins < item.cost then
		return false, "Need " .. NumberFormat.format(item.cost) .. " Wins"
	end
	data.Wins -= item.cost
	table.insert(ownedTable, idx)
	DataService.syncStats(player)
	ShopService.refreshVisuals(player)
	if item.pct then
		return true, "✅ " .. item.name .. " equipped! (+" .. item.pct .. "% Charge)"
	end
	return true, "✅ " .. item.name .. " equipped! (x" .. tostring(item.mult) .. ")"
end

function ShopService.init(remotes)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.4)
			ShopService.applyPasses(player)
		end)
		task.spawn(function()
			local data = DataService.profiles[player]
			while not data do
				task.wait(0.2)
				data = DataService.profiles[player]
			end
			ShopService.applyPasses(player)
		end)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player)
		ShopService.applyPasses(player)
	end)

	remotes.GetState.OnServerInvoke = function(player)
		local data = DataService.profiles[player]
		if not data then
			return {}
		end
		local level, into, band = Economy.levelFor(data.TotalEarned)
		return {
			CasesOwned = data.CasesOwned,
			SignalsOwned = data.SignalsOwned,
			ItemsOwned = data.ItemsOwned,
			ChargersOwned = data.ChargersOwned,
			ChargerLevels = data.ChargerLevels,
			InfinityCase = data.InfinityCase,
			GalaxyCase = data.GalaxyCase or false,
			DarknessSignal = data.DarknessSignal or false,
			CaseMult = SpeedService.caseMult(player),
			SignalMult = SpeedService.signalMult(player),
			ItemMult = SpeedService.itemMult(player),
			RebirthMult = Economy.rebirthMult(data.Rebirths),
			StepIndex = data.StepIndex or 1,
			AscendMult = Config.ASCEND_MULT ^ data.Ascends,
			GainMult = SpeedService.gainMult(player),
			Level = level,
			LevelInto = into,
			LevelBand = band,
			RebirthLevelReq = Economy.rebirthLevelRequired(data.Rebirths),
			Ascends = data.Ascends,
			SpeedCap = data.SpeedCap,
			GiftReadyIn = math.max(0, Config.GIFT_COOLDOWN - (os.time() - (data.LastGift or 0))),
			MaxStageW2 = data.MaxStageW2 or 0,
			Battery = StageService.runBattery(player),
			BoostUntil = data.BoostUntil or 0,
			BoostMult = data.BoostMult or 1,
			SpinReadyIn = math.max(0, Config.SPIN_COOLDOWN - (os.time() - (data.LastSpin or 0))),
		}
	end

	remotes.BuyCase.OnServerInvoke = function(player, idx)
		local data = DataService.profiles[player]
		return buyLadder(player, Config.CASES, data and data.CasesOwned, idx, "trail")
	end
	remotes.BuySignal.OnServerInvoke = function(player, idx)
		local data = DataService.profiles[player]
		return buyLadder(player, Config.SIGNALS, data and data.SignalsOwned, idx, "aura")
	end
	remotes.BuyItem.OnServerInvoke = function(player, idx)
		local data = DataService.profiles[player]
		local ok, msg = buyLadder(player, Config.ITEMS, data and data.ItemsOwned, idx, "item")
		if ok then
			msg = "🎒 " .. msg
		end
		return ok, msg
	end

	remotes.UnlockCharger.OnServerInvoke = function(player, idx)
		local data = DataService.profiles[player]
		local item = Config.CHARGERS[idx]
		if not (data and item) then
			return false, "Invalid station"
		end
		if table.find(data.ChargersOwned, idx) then
			return false, "Already unlocked"
		end
		if item.cost == -1 then
			return false, "👑 VIP only — get the VIP pass"
		end
		if data.Wins < item.cost then
			return false, "Need " .. NumberFormat.format(item.cost) .. " Wins"
		end
		data.Wins -= item.cost
		table.insert(data.ChargersOwned, idx)
		DataService.syncStats(player)
		return true, "🏃 " .. item.name .. " charger unlocked!"
	end

	-- Charger upgrades (v5): paid in Wins earned by playing — never Robux.
	remotes.UpgradeCharger.OnServerInvoke = function(player, idx)
		local data = DataService.profiles[player]
		local tm = Config.CHARGERS[idx]
		if not (data and tm) then
			return false, "Invalid station"
		end
		if not table.find(data.ChargersOwned, idx) then
			return false, "Unlock this charger first"
		end
		data.ChargerLevels = data.ChargerLevels or {}
		local level = data.ChargerLevels[idx] or 0
		if level >= Config.CHARGER_MAX_LEVEL then
			return false, "⭐ This charger is MAX level"
		end
		local cost = Economy.chargerUpgradeCost(tm, level)
		if data.Wins < cost then
			return false, "Need " .. NumberFormat.format(cost) .. " Wins to upgrade"
		end
		data.Wins -= cost
		data.ChargerLevels[idx] = level + 1
		DataService.syncStats(player)
		local nowRate = Economy.chargerOutput(tm, level + 1)
		return true, "⬆️ " .. tm.name .. " Lv" .. (level + 1) .. "! Now +" .. NumberFormat.format(nowRate) .. " Charge/s"
	end

	-- Rebirth (v7, documented ladder): needs the ladder's Level, resets Speed
	-- AND Level (TotalEarned), keeps Wins, gear, chargers and step pads.
	remotes.UpgradePhone.OnServerInvoke = function(player)
		local data = DataService.profiles[player]
		if not data then
			return false, "No data"
		end
		if data.Rebirths >= #Config.REBIRTH_LEVELS then
			return false, "📱 MAX phone (" .. #Config.REBIRTH_LEVELS .. ") reached!"
		end
		local level = Economy.levelFor(data.TotalEarned)
		local req = Economy.rebirthLevelRequired(data.Rebirths)
		if level < req then
			return false, "📱 Phone upgrade " .. (data.Rebirths + 1) .. " needs Level " .. req .. " (you are " .. level .. ")"
		end
		data.Speed = 0
		data.TotalEarned = 0
		data.MaxStage = 0
		data.MaxStageW2 = 0
		data.Rebirths += 1
		DataService.syncStats(player)
		StageService.checkpoints[player] = nil
		StageService.armed[player] = {}
		StageService.resetRun(player)
		local model = Config.PHONE_MODELS[data.Rebirths] or ""
		return true, "📱 Upgraded to " .. model .. "! Gain multiplier is now x" .. NumberFormat.format(Economy.rebirthMult(data.Rebirths))
	end

	-- Ascend (v7, documented shape): max Rebirths + 200T Wins -> x8 per tier.
	-- Resets Speed, Level and Rebirths; the Wins cost is paid.
	remotes.Ascend.OnServerInvoke = function(player)
		local data = DataService.profiles[player]
		if not data then
			return false, "No data"
		end
		if data.Rebirths < Config.ASCEND_REBIRTHS_NEEDED then
			return false, "🔄 OS Update needs " .. Config.ASCEND_REBIRTHS_NEEDED .. " phone upgrades (you have " .. data.Rebirths .. ")"
		end
		if data.Wins < Config.ASCEND_WINS_COST then
			return false, "🔄 OS Update needs " .. NumberFormat.format(Config.ASCEND_WINS_COST) .. " Wins (you have " .. NumberFormat.format(data.Wins) .. ")"
		end
		data.Wins -= Config.ASCEND_WINS_COST
		data.Rebirths = 0
		data.Speed = 0
		data.TotalEarned = 0
		data.MaxStage = 0
		data.MaxStageW2 = 0
		data.Ascends += 1
		DataService.syncStats(player)
		StageService.checkpoints[player] = nil
		StageService.armed[player] = {}
		StageService.resetRun(player)
		StageService.teleportToCheckpoint(player)
		return true, "🔄 OS UPDATED! Permanent x" .. NumberFormat.format(Config.ASCEND_MULT ^ data.Ascends) .. " from OS updates"
	end

	-- Step pads (v7): buy the NEXT +Speed-per-step pad with Wins.
	remotes.BuyStep.OnServerInvoke = function(player)
		local data = DataService.profiles[player]
		if not data then
			return false, "No data"
		end
		local current = data.StepIndex or 1
		local nextPad = Config.STEP_PADS[current + 1]
		if not nextPad then
			return false, "👟 MAX step pad owned!"
		end
		if data.Wins < nextPad.cost then
			return false, "Need " .. NumberFormat.format(nextPad.cost) .. " Wins for the +" .. NumberFormat.format(nextPad.amount) .. "⚡/step link"
		end
		data.Wins -= nextPad.cost
		data.StepIndex = current + 1
		DataService.syncStats(player)
		return true, "🔗 Fast-charge link upgraded! Now +" .. NumberFormat.format(nextPad.amount) .. " Charge per step"
	end

	remotes.RedeemCode.OnServerInvoke = function(player, code)
		local data = DataService.profiles[player]
		if not data or type(code) ~= "string" then
			return false, "Invalid code"
		end
		local reward = Config.CODES[string.upper(code)]
		if not reward then
			return false, "❌ Code not found"
		end
		if data.CodesUsed[string.upper(code)] then
			return false, "Already used this code"
		end
		data.CodesUsed[string.upper(code)] = true
		if reward.speed > 0 then
			SpeedService.grantSpeed(player, reward.speed)
		end
		if reward.wins > 0 then
			data.Wins += reward.wins
			DataService.syncStats(player)
		end
		return true, "🎁 Code redeemed! +" .. NumberFormat.format(reward.speed) .. " Charge, +" .. NumberFormat.format(reward.wins) .. " Wins"
	end

	remotes.ClaimGift.OnServerInvoke = function(player)
		local data = DataService.profiles[player]
		if not data then
			return false, "No data"
		end
		local left = Config.GIFT_COOLDOWN - (os.time() - (data.LastGift or 0))
		if left > 0 then
			return false, "🎁 Free gift in " .. math.ceil(left / 60) .. " min"
		end
		data.LastGift = os.time()
		local speedGift = 1000 * (10 ^ math.floor(data.MaxStage / 5))
		local winsGift = 25 * (data.MaxStage + 1)
		SpeedService.grantSpeed(player, speedGift)
		data.Wins += winsGift
		DataService.syncStats(player)
		return true, "🎁 FREE! +" .. NumberFormat.format(speedGift) .. " Charge, +" .. NumberFormat.format(winsGift) .. " Wins"
	end

	-- Spin wheel (v6): free every 12h — speed, wins, boosts, or the jackpot.
	remotes.Spin.OnServerInvoke = function(player)
		local data = DataService.profiles[player]
		if not data then
			return false, "No data"
		end
		local left = Config.SPIN_COOLDOWN - (os.time() - (data.LastSpin or 0))
		if left > 0 then
			return false, "🎡 Free spin in " .. math.floor(left / 3600) .. "h " .. math.ceil((left % 3600) / 60) .. "m"
		end
		data.LastSpin = os.time()
		local outcome = Economy.spinOutcome(math.random(), math.max(data.MaxStage, data.MaxStageW2 or 0))
		if outcome.kind == "speed" then
			SpeedService.grantSpeed(player, outcome.amount)
			return true, "🎡 You won +" .. NumberFormat.format(outcome.amount) .. " Charge!"
		elseif outcome.kind == "wins" then
			data.Wins += outcome.amount
			DataService.syncStats(player)
			return true, "🎡 You won +" .. NumberFormat.format(outcome.amount) .. " Wins!"
		elseif outcome.kind == "boost" then
			local now = os.time()
			local activeMult = (data.BoostUntil or 0) > now and (data.BoostMult or 1) or 1
			data.BoostMult = math.max(activeMult, outcome.mult)
			data.BoostUntil = math.max(data.BoostUntil or 0, now) + outcome.minutes * 60
			return true, "🎡 BOOST! x" .. data.BoostMult .. " gains for " .. outcome.minutes .. " min!"
		else
			SpeedService.grantSpeed(player, outcome.amount)
			return true, "🎡💎 JACKPOT! +" .. NumberFormat.format(outcome.amount) .. " Charge!"
		end
	end

	remotes.SetCap.OnServerEvent:Connect(function(player, cap)
		local data = DataService.profiles[player]
		if data and type(cap) == "number" then
			data.SpeedCap = math.max(0, math.floor(cap))
		end
	end)

	remotes.Teleport.OnServerEvent:Connect(function(player, dest)
		local data = DataService.profiles[player]
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not (data and hrp) then
			return
		end
		if dest == "lobby" then
			hrp.CFrame = CFrame.new(0, 4, 80)
			StageService.checkpoints[player] = nil
		elseif dest == "world2" then
			remotes.Toast:FireClient(player, "🔒 World 2 — Social Apps — is coming in Update 1!")
		elseif dest == "world1" then
			StageService.setSpawn(player, CFrame.new(0, 4, 80))
		elseif dest == "stage" then
			local target = math.max(1, data.MaxStage + 1)
			if target > Config.STAGE_COUNT then
				target = Config.STAGE_COUNT
			end
			local zStart = -Config.STAGE_SPACING * (target - 1) - 26
			hrp.CFrame = CFrame.new(0, 3, zStart - 2)
			StageService.checkpoints[player] = CFrame.new(0, 3, zStart - 2)
		end
	end)

	-- Developer products: SkipStage + the buy-speed buttons from the screenshot.
	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local data = player and DataService.profiles[player]
		if not (player and data) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if Config.PRODUCTS.SkipStage > 0 and receipt.ProductId == Config.PRODUCTS.SkipStage then
			if data.MaxStage < Config.STAGE_COUNT then
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp then
					-- Character not loaded yet: let Roblox retry the receipt.
					return Enum.ProductPurchaseDecision.NotProcessedYet
				end
				local nextStage = data.MaxStage + 1
				StageService.claimStage(player, nextStage)
				local zStart = -Config.STAGE_SPACING * (nextStage - 1) - 26
				hrp.CFrame = CFrame.new(0, 3, zStart)
				StageService.checkpoints[player] = CFrame.new(0, 3, zStart)
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
			-- Every World 1 stage is already cleared: never leave a paid
			-- receipt unprocessed — grant the final stage's Wins instead.
			StageService.claimStage(player, Config.STAGE_COUNT)
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		for key, amount in Config.PRODUCT_AMOUNTS do
			local pid = Config.PRODUCTS[key]
			if pid and pid > 0 and receipt.ProductId == pid then
				SpeedService.grantSpeed(player, amount)
				remotes.Toast:FireClient(player, "⚡ +" .. NumberFormat.format(amount) .. " Charge!")
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	RunService.Heartbeat:Connect(function()
		for player, sphere in signalParts do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and sphere.Parent then
				sphere.CFrame = hrp.CFrame
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if signalParts[player] then
			signalParts[player]:Destroy()
			signalParts[player] = nil
		end
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">SpeedService</string>
          <string name="Source"><![CDATA[-- SpeedService: the heart of the Keyboard formula.
-- * Stepping on a keyboard KEY = +1 Speed (key lights up, per-player cooldown
--   so you must keep running across keys).
-- * Standing on an owned TREADMILL = +rate x pad-mult per second.
-- * Everything is multiplied by (1+rebirths) x trail x aura x passes.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)

local DataService = require(script.Parent.DataService)

local SpeedService = {}
SpeedService.passMult = {} -- [Player] = gains multiplier from passes
SpeedService.winMult = {} -- [Player] = wins multiplier from passes
SpeedService.toastFn = nil -- set by ServerMain: (player, text) -> ()
SpeedService.hooks = {} -- optional: onKey(player), onTrain(player, seconds) — set by ServerMain for quests
local frac = {}
local keyCooldown = {} -- [Player] = {[BasePart] = os.clock()}

-- Best multiplier from a ladder, including Robux-pass entries whose
-- ownership flag lives on the profile (data.GalaxyCase, data.InfinityCase…)
local function ladderMult(data, owned, ladder): number
	local _, mult = Economy.bestOwned(owned, ladder)
	for _, item in ladder do
		if item.pass and data[item.pass] then
			mult = math.max(mult, item.mult)
		end
	end
	return mult
end

function SpeedService.caseMult(player: Player): number
	local data = DataService.profiles[player]
	if not data then
		return 1
	end
	return ladderMult(data, data.CasesOwned, Config.CASES)
end

function SpeedService.signalMult(player: Player): number
	local data = DataService.profiles[player]
	if not data then
		return 1
	end
	return ladderMult(data, data.SignalsOwned, Config.SIGNALS)
end

-- Robux cable multiplier: applies ONLY to charging-station output
-- (from the original's treadmill passes: Gold x3 / Diamond x9 / ...).
function SpeedService.cableMult(player: Player): number
	local data = DataService.profiles[player]
	if not data then
		return 1
	end
	local mult = 1
	for _, cable in Config.CABLES do
		if data[cable.pass] then
			mult = math.max(mult, cable.mult)
		end
	end
	return mult
end

function SpeedService.itemMult(player: Player): number
	local data = DataService.profiles[player]
	if not data then
		return 1
	end
	return Economy.itemsMult(data.ItemsOwned)
end

function SpeedService.gainMult(player: Player): number
	local data = DataService.profiles[player]
	if not data then
		return 1
	end
	return Economy.gainMultiplier(Economy.rebirthMult(data.Rebirths), data.Ascends, SpeedService.caseMult(player), SpeedService.signalMult(player), SpeedService.itemMult(player), SpeedService.passMult[player] or 1)
end

function SpeedService.addSpeed(player: Player, baseAmount: number)
	local data = DataService.profiles[player]
	if not data then
		return
	end
	local mult = SpeedService.gainMult(player)
	-- Temporary spin boost (v6): multiplies active play gains only.
	if data.BoostUntil and data.BoostUntil > os.time() and data.BoostMult then
		mult *= data.BoostMult
	end
	frac[player] = (frac[player] or 0) + baseAmount * mult
	local whole = math.floor(frac[player])
	if whole > 0 then
		frac[player] -= whole
		data.Speed += whole
		data.TotalEarned += whole
		DataService.syncStats(player)
	end
end

-- Direct grant (products, codes, gift): counts toward lifetime/Level too.
function SpeedService.grantSpeed(player: Player, amount: number)
	local data = DataService.profiles[player]
	if not data then
		return
	end
	data.Speed += amount
	data.TotalEarned += amount
	DataService.syncStats(player)
end

local function walkSpeedFor(speedStat: number): number
	return math.min(16 + math.sqrt(math.max(speedStat, 0)) / 4, 250)
end

function SpeedService.applyWalkSpeed(player: Player)
	local data = DataService.profiles[player]
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if data and hum then
		local effective = data.Speed
		if data.SpeedCap and data.SpeedCap > 0 then
			effective = math.min(effective, data.SpeedCap)
		end
		hum.WalkSpeed = walkSpeedFor(effective)
	end
end

local function partsUnderPlayer(player: Player): { BasePart }
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return {}
	end
	local map = workspace:FindFirstChild("PhoneMap")
	if not map then
		return {}
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { map }
	return workspace:GetPartBoundsInBox(CFrame.new(hrp.Position - Vector3.new(0, 2.6, 0)), Vector3.new(3.4, 2.2, 3.4), params)
end

local keyFlashBusy = {}
local function flashKey(key: BasePart)
	if keyFlashBusy[key] then
		return
	end
	keyFlashBusy[key] = true
	local origColor, origMat = key.Color, key.Material
	key.Color = Color3.fromRGB(120, 255, 140)
	key.Material = Enum.Material.Neon
	task.delay(0.25, function()
		if key.Parent then
			key.Color = origColor
			key.Material = origMat
		end
		keyFlashBusy[key] = nil
	end)
end

function SpeedService.init()
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for _, player in Players:GetPlayers() do
			local data = DataService.profiles[player]
			if not data then
				continue
			end
			keyCooldown[player] = keyCooldown[player] or {}
			for _, hit in partsUnderPlayer(player) do
				if hit:GetAttribute("IsApp") then
					local last = keyCooldown[player][hit] or 0
					if now - last >= Config.APP_COOLDOWN then
						keyCooldown[player][hit] = now
						local stepPad = Config.STEP_PADS[data.StepIndex or 1] or Config.STEP_PADS[1]
						SpeedService.addSpeed(player, stepPad.amount)
						flashKey(hit)
						if SpeedService.hooks.onKey then
							SpeedService.hooks.onKey(player)
						end
					end
				elseif hit:GetAttribute("ChargerIndex") then
					local idx = hit:GetAttribute("ChargerIndex")
					local tm = Config.CHARGERS[idx]
					if tm then
						if table.find(data.ChargersOwned, idx) then
							local level = (data.ChargerLevels and data.ChargerLevels[idx]) or 0
							SpeedService.addSpeed(player, Economy.chargerOutput(tm, level) * SpeedService.cableMult(player) * dt)
							if SpeedService.hooks.onTrain then
								SpeedService.hooks.onTrain(player, dt)
							end
						elseif SpeedService.toastFn and (now - (keyCooldown[player].tmToast or 0)) > 4 then
							keyCooldown[player].tmToast = now
							SpeedService.toastFn(player, "🔒 Buy the " .. tm.name .. " station in the Chargers panel")
						end
					end
				end
			end
			SpeedService.applyWalkSpeed(player)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		frac[player] = nil
		keyCooldown[player] = nil
		SpeedService.passMult[player] = nil
		SpeedService.winMult[player] = nil
	end)
end

return SpeedService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">StageService</string>
          <string name="Source"><![CDATA[-- StageService: stage gates with level requirements, checkpoints,
-- kill-floor respawns, Wins pads, and world portals.
-- v6: two worlds. World 1 stages extend from z=0; World 2 (Snow) from
-- z = Config.WORLD2_Z, gated by the documented World 2 level ladder.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local NumberFormat = require(Shared.NumberFormat)

local DataService = require(script.Parent.DataService)
local SpeedService = require(script.Parent.SpeedService)

local StageService = {}
StageService.onClaim = nil -- optional hook (player, stageIndex) — set by ServerMain for quests
StageService.checkpoints = {} -- [Player] = CFrame
StageService.armed = {} -- [Player] = {[world*1000+stageIndex] = true}
local remotes
local portalCooldown = {}
-- v8 mechanics registries + per-run tracking (stars / falls / timer)
local movers = {}
local sweepers = {}
local vanishTiles = {}
local conveyors = {}
local spinStars = {}
local runs = {} -- [Player] = {world, stage, startT, falls, stars = {[part] = true}, battery?}
local bounceCooldown = {}
local batteryStages = {} -- [world*1000+stage] = drain % per second (boss stages)
local batteryCooldown = {} -- [Player] = {[BasePart] = os.clock()}

local WORLD_OFFSETS = { [1] = 0, [2] = Config.WORLD2_Z }
local WORLD_SPAWNS = { [1] = CFrame.new(0, 3, 78), [2] = CFrame.new(0, 3, Config.WORLD2_LOBBY_Z) }

function StageService.toast(player: Player, text: string)
	if remotes then
		remotes.Toast:FireClient(player, text)
	end
end

function StageService.setSpawn(player: Player, cframe: CFrame)
	StageService.checkpoints[player] = cframe
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.CFrame = cframe
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end

function StageService.claimStage(player: Player, stageIndex: number, world: number?)
	world = world or 1
	local data = DataService.profiles[player]
	if not data then
		return
	end
	local reward = Economy.stageReward(stageIndex, world) * (SpeedService.winMult[player] or 1)
	-- v8 run bonuses: stars, no-fall, timer medal
	local bonusText = ""
	local run = runs[player]
	if run and run.world == world and run.stage == stageIndex then
		local starCount = 0
		for _ in run.stars do
			starCount += 1
		end
		local elapsed = os.clock() - run.startT
		local pct, medal = Economy.runBonus(starCount, run.falls, elapsed, Economy.parTime(stageIndex, world))
		if pct > 0 then
			reward = math.floor(reward * (1 + pct / 100))
			local bits = {}
			if starCount > 0 then
				table.insert(bits, "⭐x" .. starCount)
			end
			if run.falls == 0 then
				table.insert(bits, "flawless")
			end
			if medal ~= "" then
				table.insert(bits, (medal == "gold" and "🥇" or medal == "silver" and "🥈" or "🥉") .. " " .. string.format("%.1fs", elapsed))
			end
			bonusText = " (" .. table.concat(bits, " • ") .. " +" .. pct .. "%)"
		end
		data.BestTimes = data.BestTimes or {}
		local key = "w" .. world .. "_" .. stageIndex
		if not data.BestTimes[key] or elapsed < data.BestTimes[key] then
			data.BestTimes[key] = math.floor(elapsed * 10) / 10
		end
		runs[player] = nil
	end
	data.Wins += reward
	if world == 2 then
		if stageIndex > (data.MaxStageW2 or 0) then
			data.MaxStageW2 = stageIndex
		end
	else
		if stageIndex > data.MaxStage then
			data.MaxStage = stageIndex
		end
	end
	DataService.syncStats(player)
	local tag = world == 2 and "❄️ World 2 — " or ""
	StageService.toast(player, "🏆 " .. tag .. "Stage " .. stageIndex .. " cleared! +" .. NumberFormat.format(reward) .. " Wins" .. bonusText)
	if remotes then
		remotes.StageCleared:FireClient(player, stageIndex)
	end
	if StageService.onClaim then
		StageService.onClaim(player, stageIndex)
	end
end

function StageService.teleportToCheckpoint(player: Player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		if runs[player] then
			runs[player].falls += 1
		end
		hrp.CFrame = StageService.checkpoints[player] or WORLD_SPAWNS[1]
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end

local function usePortal(player: Player, targetWorld: number)
	local now = os.clock()
	if portalCooldown[player] and now - portalCooldown[player] < 2 then
		return
	end
	portalCooldown[player] = now
	local data = DataService.profiles[player]
	if not data then
		return
	end
	if targetWorld == 2 and Economy.levelFor(data.TotalEarned) < Config.WORLD2_UNLOCK_LEVEL and (data.MaxStageW2 or 0) == 0 then
		StageService.toast(player, "🔒 World 2 unlocks at Level " .. Config.WORLD2_UNLOCK_LEVEL .. "!")
		return
	end
	StageService.setSpawn(player, WORLD_SPAWNS[targetWorld] + Vector3.new(0, 1, 0))
	StageService.toast(player, targetWorld == 2 and "❄️ Welcome to SNOW WORLD! Gates need Level 140+, Wins up to 40M" or "🏠 Back to World 1")
end

function StageService.resetRun(player: Player)
	runs[player] = nil
end

-- Current battery % for the HUD (nil when not in a battery stage run).
function StageService.runBattery(player: Player): number?
	local run = runs[player]
	if run and run.battery then
		return math.max(0, math.floor(run.battery))
	end
	return nil
end

function StageService.init(remotesFolder)
	remotes = remotesFolder
	local map = workspace:WaitForChild("PhoneMap")

	-- Battery stages registry (boss folders carry a BatteryDrain attribute)
	local stagesFolder = map:FindFirstChild("Stages")
	if stagesFolder then
		for _, folder in stagesFolder:GetChildren() do
			local drain = folder:GetAttribute("BatteryDrain")
			local idx = tonumber(string.match(folder.Name, "Stage_(%d+)"))
			if drain and idx then
				batteryStages[1000 + idx] = drain
			end
		end
	end

	-- Touch wiring: checkpoints, wins pads, kill floors, portals + v8 mechanics
	for _, desc in map:GetDescendants() do
		if desc:IsA("BasePart") then
			if desc:GetAttribute("Moving") then
				table.insert(movers, {
					part = desc, base = desc.CFrame,
					axis = desc:GetAttribute("MoveAxis") or "X",
					range = desc:GetAttribute("MoveRange") or 7,
					speed = desc:GetAttribute("MoveSpeed") or 1.1,
					phase = desc:GetAttribute("MovePhase") or 0,
				})
			end
			if desc:GetAttribute("Sweeper") then
				table.insert(sweepers, {
					part = desc, pos = desc.Position,
					pivotX = desc:GetAttribute("PivotX") or desc.Position.X,
					pivotZ = desc:GetAttribute("PivotZ") or desc.Position.Z,
					speed = desc:GetAttribute("SweepSpeed") or 1.2,
				})
			end
			if desc:GetAttribute("VanishPhase") ~= nil then
				table.insert(vanishTiles, { part = desc, phase = desc:GetAttribute("VanishPhase") })
			end
			if desc:GetAttribute("ConvZ") then
				table.insert(conveyors, { part = desc, z = desc:GetAttribute("ConvZ") })
			end
			if desc:GetAttribute("Bounce") then
				local power = desc:GetAttribute("Bounce")
				desc.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local hrp = hit.Parent and hit.Parent:FindFirstChild("HumanoidRootPart")
					if player and hrp then
						local key = player.UserId .. "_" .. desc:GetDebugId()
						local now = os.clock()
						if not bounceCooldown[key] or now - bounceCooldown[key] > 0.35 then
							bounceCooldown[key] = now
							local v = hrp.AssemblyLinearVelocity
							hrp.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
						end
					end
				end)
			end
			if desc:GetAttribute("IsBattery") then
				desc.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local run = player and runs[player]
					if run and run.battery and run.battery < 100 then
						batteryCooldown[player] = batteryCooldown[player] or {}
						local now = os.clock()
						if now - (batteryCooldown[player][desc] or 0) > 8 then
							batteryCooldown[player][desc] = now
							run.battery = math.min(100, run.battery + Config.BATTERY_PICKUP_PCT)
							StageService.toast(player, "🔋 +" .. Config.BATTERY_PICKUP_PCT .. "% battery! (" .. math.floor(run.battery) .. "%)")
						end
					end
				end)
			end
			if desc:GetAttribute("IsStar") then
				table.insert(spinStars, { part = desc, base = desc.Position, phase = math.random() * 6 })
				local starKey = desc:GetAttribute("StarKey")
				desc.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local run = player and runs[player]
					if run and run.world * 1000 + run.stage == starKey and not run.stars[desc] then
						run.stars[desc] = true
						StageService.toast(player, "⭐ Star! (+25% stage bonus)")
					end
				end)
			end
			if desc:GetAttribute("StageStart") then
				local idx = desc:GetAttribute("StageStart")
				local world = desc:GetAttribute("World") or 1
				desc.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						StageService.checkpoints[player] = desc.CFrame + Vector3.new(0, 3, 0)
						StageService.armed[player] = StageService.armed[player] or {}
						StageService.armed[player][world * 1000 + idx] = true
						-- start a fresh timed run (re-touching mid-run keeps it)
						local run = runs[player]
						if not run or run.world ~= world or run.stage ~= idx then
							runs[player] = { world = world, stage = idx, startT = os.clock(), falls = 0, stars = {} }
							local drain = batteryStages[world * 1000 + idx]
							if drain then
								runs[player].battery = 100
								runs[player].drain = drain
								StageService.toast(player, "🔋 Power-save stage! Watch your battery — grab 🔋 cells!")
							end
						end
					end
				end)
			elseif desc:GetAttribute("MidStart") then
				local idx = desc:GetAttribute("MidStart")
				local world = desc:GetAttribute("World") or 1
				desc.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						StageService.checkpoints[player] = desc.CFrame + Vector3.new(0, 3, 0)
						StageService.armed[player] = StageService.armed[player] or {}
						StageService.armed[player][world * 1000 + idx] = true
					end
				end)
			elseif desc:GetAttribute("StageWin") then
				local idx = desc:GetAttribute("StageWin")
				local world = desc:GetAttribute("World") or 1
				desc.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					local key = world * 1000 + idx
					if player and StageService.armed[player] and StageService.armed[player][key] then
						StageService.armed[player][key] = false
						StageService.claimStage(player, idx, world)
					end
				end)
			elseif desc:GetAttribute("IsKill") then
				desc.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						StageService.teleportToCheckpoint(player)
					end
				end)
			elseif desc:GetAttribute("IsPortal") then
				local targetWorld = desc:GetAttribute("IsPortal")
				desc.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						usePortal(player, targetWorld)
					end
				end)
			end
		end
	end

	-- v8 mechanics animation: movers, sweepers, vanish cycle, conveyors, stars
	local lastVanishCycle = -1
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, m in movers do
			local off = math.sin(t * m.speed + m.phase) * m.range
			if m.axis == "Y" then
				m.part.CFrame = m.base * CFrame.new(0, off, 0)
			else
				m.part.CFrame = m.base * CFrame.new(off, 0, 0)
			end
		end
		for _, sw in sweepers do
			sw.part.CFrame = CFrame.new(sw.pivotX, sw.pos.Y, sw.pivotZ) * CFrame.Angles(0, t * sw.speed, 0)
		end
		local cycle = math.floor(t / 1.1) % 3
		if cycle ~= lastVanishCycle then
			lastVanishCycle = cycle
			for _, tile in vanishTiles do
				local solid = tile.phase == cycle
				tile.part.CanCollide = solid
				tile.part.Transparency = solid and 0 or 0.65
			end
		end
		for _, st in spinStars do
			st.part.Position = st.base + Vector3.new(0, math.sin(t * 2 + st.phase) * 0.3, 0)
		end
		if #conveyors > 0 then
			for _, player in Players:GetPlayers() do
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hrp then
					for _, belt in conveyors do
						local bp = belt.part.Position
						local bs = belt.part.Size
						if math.abs(hrp.Position.X - bp.X) < bs.X / 2 + 0.5
							and math.abs(hrp.Position.Z - bp.Z) < bs.Z / 2 + 0.5
							and hrp.Position.Y > bp.Y and hrp.Position.Y < bp.Y + 3.2 then
							local v = hrp.AssemblyLinearVelocity
							hrp.AssemblyLinearVelocity = Vector3.new(v.X, v.Y, belt.z)
						end
					end
				end
			end
		end
	end)

	-- Battery drain (boss stages): hits 0% -> run fails to the checkpoint.
	RunService.Heartbeat:Connect(function(dt)
		for _, player in Players:GetPlayers() do
			local run = runs[player]
			if run and run.battery then
				run.battery -= (run.drain or Config.BATTERY_DRAIN_PCT) * dt
				if run.battery <= 50 and not run.warn50 then
					run.warn50 = true
					StageService.toast(player, "🪫 Battery at 50%! Find a 🔋 cell!")
				end
				if run.battery <= 25 and not run.warn25 then
					run.warn25 = true
					StageService.toast(player, "🪫⚠️ Battery at 25%!")
				end
				if run.battery <= 0 then
					runs[player] = nil
					StageService.toast(player, "🔋 Battery empty! Back to the checkpoint — try again!")
					StageService.teleportToCheckpoint(player)
				end
			end
		end
	end)

	-- Gate enforcement per world: crossing a gate plane without the speed
	-- bounces you back. Stages you already cleared stay open to you.
	RunService.Heartbeat:Connect(function()
		for _, player in Players:GetPlayers() do
			local data = DataService.profiles[player]
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if data and hrp then
				local level = Economy.levelFor(data.TotalEarned)
				for world = 1, 2 do
					local offset = WORLD_OFFSETS[world]
					local maxStage = world == 2 and (data.MaxStageW2 or 0) or data.MaxStage
					for i = 1, Economy.stageCount(world) do
						local gateZ = offset - Config.STAGE_SPACING * (i - 1) - 20
						if hrp.Position.Z < gateZ - 1.5 and hrp.Position.Z > gateZ - 30 then
							local req = Economy.stageLevelReq(i, world)
							if i > maxStage and level < req then
								hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y, gateZ + 4)
								hrp.AssemblyLinearVelocity = Vector3.zero
								StageService.toast(player, "🧱 Stage " .. i .. " needs Level " .. req .. "!")
							end
							break
						end
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		StageService.checkpoints[player] = nil
		StageService.armed[player] = nil
		portalCooldown[player] = nil
		runs[player] = nil
		batteryCooldown[player] = nil
	end)
end

return StageService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="18">
          <Properties>
            <string name="Name">ClientMain</string>
            <string name="Source"><![CDATA[-- ClientMain v3: HUD modeled on توفيق's screenshot of the real game —
-- left button column (Rebirth / FREE / Teleport / Trails / Auras / Items /
-- Chargers / Code), bottom-center big Speed + Level bar + multiplier lines,
-- right-side Shop + Custom Speed cap, buy-speed product buttons.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local NumberFormat = require(Shared.NumberFormat)
local EconomyClient = require(Shared.Economy)
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local gui = Instance.new("ScreenGui")
gui.Name = "PhoneHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in props do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(parent, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 10) }, parent)
end

-- ===== left column: wins + buttons =====
local winsLabel = make("TextLabel", {
	Size = UDim2.new(0, 170, 0, 44), Position = UDim2.new(0, 10, 0, 10),
	BackgroundColor3 = Color3.fromRGB(25, 25, 35), BackgroundTransparency = 0.15,
	Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.fromRGB(120, 255, 140), Text = "🏆 0",
}, gui)
corner(winsLabel, 12)

local leftButtons = {}
local function leftButton(text, color, order)
	-- two-column grid (v4 comfort: compact, thumb-friendly, nothing off-screen)
	local col = (order - 1) % 2
	local row = math.floor((order - 1) / 2)
	local b = make("TextButton", {
		Size = UDim2.new(0, 118, 0, 60), Position = UDim2.new(0, 10 + col * 126, 0, 66 + row * 68),
		BackgroundColor3 = color, Font = Enum.Font.FredokaOne, TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1), Text = text, BorderSizePixel = 0,
	}, gui)
	corner(b, 12)
	leftButtons[text] = b
	return b
end
local rebBtn = leftButton("📱\nUpgrade", Color3.fromRGB(90, 160, 255), 1)
local giftBtn = leftButton("🎁\nFREE!", Color3.fromRGB(255, 120, 170), 2)
local tpBtn = leftButton("🌀\nTeleport", Color3.fromRGB(150, 90, 220), 3)
local caseBtn = leftButton("📦\nCases", Color3.fromRGB(200, 90, 200), 4)
local signalBtn = leftButton("📶\nSignal", Color3.fromRGB(70, 130, 230), 5)
local itemBtn = leftButton("🎒\nItems", Color3.fromRGB(230, 150, 60), 6)
local trainBtn = leftButton("🏃\nChargers", Color3.fromRGB(60, 170, 90), 7)
local codeBtn = leftButton("🔑\nCode", Color3.fromRGB(90, 90, 110), 8)
local ascBtn = leftButton("🔄\nOS Update", Color3.fromRGB(255, 190, 40), 9)
local questBtn = leftButton("🎖️\nQuests", Color3.fromRGB(220, 170, 40), 10)
local spinBtn = leftButton("🎡\nSpin", Color3.fromRGB(200, 80, 200), 11)
local stepsBtn = leftButton("🔗\nLinks", Color3.fromRGB(90, 170, 90), 12)
spinBtn.MouseButton1Click:Connect(function()
	local _, msg = remotes.Spin:InvokeServer()
	showToast(msg)
end)

-- Objective banner (v6 comfort): always shows the player's next goal.
local objective = make("TextLabel", {
	Size = UDim2.new(0, 460, 0, 26), Position = UDim2.new(0.5, -230, 0, 118),
	BackgroundColor3 = Color3.fromRGB(20, 20, 35), BackgroundTransparency = 0.35,
	Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.fromRGB(255, 230, 150), Text = "🎯 ...",
}, gui)
corner(objective, 8)

-- Battery bar (boss stages only): driven by GetState's Battery field.
local batteryFrame = make("Frame", {
	Size = UDim2.new(0, 330, 0, 30), Position = UDim2.new(0.5, -165, 0, 150),
	BackgroundColor3 = Color3.fromRGB(30, 30, 40), BorderSizePixel = 0, Visible = false,
}, gui)
corner(batteryFrame, 8)
local batteryFill = make("Frame", {
	Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(90, 255, 120), BorderSizePixel = 0,
}, batteryFrame)
corner(batteryFill, 8)
local batteryText = make("TextLabel", {
	Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
	TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = "🔋 100%",
}, batteryFrame)

-- Key pop sound (v6): soft click when your Speed rises, throttled.
local popSound = Instance.new("Sound")
popSound.SoundId = "rbxassetid://6026984224"
popSound.Volume = 0.3
popSound.Parent = gui
local soundOn = true
local lastPop = 0

-- ===== bottom center: speed, level bar, multipliers, buy-speed =====
local bigSpeed = make("TextLabel", {
	Size = UDim2.new(0, 460, 0, 62), Position = UDim2.new(0.5, -230, 1, -178),
	BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.3, Text = "0 Speed",
}, gui)
local levelLabel = make("TextLabel", {
	Size = UDim2.new(0, 130, 0, 40), Position = UDim2.new(0.5, -330, 1, -112),
	BackgroundColor3 = Color3.fromRGB(120, 85, 40), Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), Text = "Level 1", BorderSizePixel = 0,
}, gui)
corner(levelLabel, 10)
local barBg = make("Frame", {
	Size = UDim2.new(0, 330, 0, 40), Position = UDim2.new(0.5, -190, 1, -112),
	BackgroundColor3 = Color3.fromRGB(30, 30, 40), BorderSizePixel = 0,
}, gui)
corner(barBg, 10)
local barFill = make("Frame", {
	Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 170, 60), BorderSizePixel = 0,
}, barBg)
corner(barFill, 10)
local barText = make("TextLabel", {
	Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne,
	TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = "0 / 100",
}, barBg)
local multLine = make("TextLabel", {
	Size = UDim2.new(0, 700, 0, 30), Position = UDim2.new(0.5, -350, 1, -66),
	BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.fromRGB(200, 220, 255), TextStrokeTransparency = 0.5, Text = "",
}, gui)

local buyRow = { { "Charge150K", "+150K ⚡" }, { "Charge1M", "+1M ⚡" }, { "Charge10M", "+10M ⚡" } }
for i, row in buyRow do
	local b = make("TextButton", {
		Size = UDim2.new(0, 168, 0, 42), Position = UDim2.new(0.5, -260 + (i - 1) * 178, 1, -34),
		BackgroundColor3 = i == 3 and Color3.fromRGB(255, 190, 40) or Color3.fromRGB(140, 95, 60),
		Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.new(1, 1, 1),
		Text = row[2], BorderSizePixel = 0,
	}, gui)
	corner(b, 10)
	b.MouseButton1Click:Connect(function()
		local pid = Config.PRODUCTS[row[1]]
		if pid and pid > 0 then
			MarketplaceService:PromptProductPurchase(player, pid)
		else
			showToast("This product is not set up yet")
		end
	end)
end

-- ===== right side: shop + custom speed =====
local shopBtn = make("TextButton", {
	Size = UDim2.new(0, 150, 0, 58), Position = UDim2.new(1, -160, 0, 10),
	BackgroundColor3 = Color3.fromRGB(255, 90, 160), Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), Text = "🛒 Shop", BorderSizePixel = 0,
}, gui)
corner(shopBtn, 12)
local capBox = make("TextBox", {
	Size = UDim2.new(0, 96, 0, 40), Position = UDim2.new(1, -160, 0, 78),
	BackgroundColor3 = Color3.fromRGB(240, 240, 245), Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.fromRGB(30, 30, 40), Text = "", PlaceholderText = "Max charge", BorderSizePixel = 0,
}, gui)
corner(capBox, 8)
local capOk = make("TextButton", {
	Size = UDim2.new(0, 54, 0, 40), Position = UDim2.new(1, -58, 0, 78),
	BackgroundColor3 = Color3.fromRGB(60, 200, 90), Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), Text = "OK", BorderSizePixel = 0,
}, gui)
corner(capOk, 8)
local capLabel = make("TextLabel", {
	Size = UDim2.new(0, 150, 0, 24), Position = UDim2.new(1, -160, 0, 122),
	BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextScaled = true,
	TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, Text = "Max Charge: off",
}, gui)
capOk.MouseButton1Click:Connect(function()
	local cap = tonumber(capBox.Text) or 0
	remotes.SetCap:FireServer(cap)
	capLabel.Text = cap > 0 and ("Max Charge: " .. NumberFormat.format(cap)) or "Custom Speed: off"
	showToast(cap > 0 and ("🚦 Max charge set to " .. NumberFormat.format(cap)) or "🚦 Charge cap removed")
end)

-- ===== toast =====
local toast = make("TextLabel", {
	Size = UDim2.new(0, 680, 0, 46), Position = UDim2.new(0.5, -340, 0, 14),
	BackgroundColor3 = Color3.fromRGB(20, 20, 30), BackgroundTransparency = 0.25,
	Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = "", Visible = false,
}, gui)
corner(toast, 10)
local toastToken = 0
function showToast(text)
	toastToken += 1
	local my = toastToken
	toast.Text = text
	toast.Visible = true
	task.delay(2.8, function()
		if toastToken == my then
			toast.Visible = false
		end
	end)
end
remotes.Toast.OnClientEvent:Connect(showToast)
local shakeOn = true
local effectsOn = true
remotes.StageCleared.OnClientEvent:Connect(function()
	-- confetti burst at the player (v4 delight, client-only parts)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		local Debris = game:GetService("Debris")
		local colors = { Color3.fromRGB(255, 110, 180), Color3.fromRGB(110, 220, 255), Color3.fromRGB(170, 255, 110), Color3.fromRGB(255, 200, 80) }
		for i = 1, 26 do
			local p = Instance.new("Part")
			p.Size = Vector3.new(0.35, 0.35, 0.35)
			p.Color = colors[(i % #colors) + 1]
			p.Material = Enum.Material.Neon
			p.CanCollide = false
			p.CFrame = hrp.CFrame + Vector3.new(0, 1, 0)
			p.AssemblyLinearVelocity = Vector3.new(math.random(-14, 14), math.random(14, 26), math.random(-14, 14))
			p.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8))
			p.Parent = workspace
			Debris:AddItem(p, 1.4)
		end
	end
	if not shakeOn then
		return
	end
	local cam = workspace.CurrentCamera
	if cam then
		local orig = cam.CFrame
		for _ = 1, 3 do
			cam.CFrame = orig * CFrame.new(math.random(-2, 2) / 20, math.random(-2, 2) / 20, 0)
			task.wait(0.03)
		end
		cam.CFrame = orig
	end
end)

-- ===== panels =====
local panels = {}
local function shopPanel(key, title)
	local f = make("Frame", {
		Size = UDim2.new(0, 440, 0, 400), Position = UDim2.new(0.5, -220, 0.5, -200),
		BackgroundColor3 = Color3.fromRGB(28, 28, 40), BorderSizePixel = 0, Visible = false,
	}, gui)
	corner(f, 14)
	make("TextLabel", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = title }, f)
	local close = make("TextButton", {
		Size = UDim2.new(0, 38, 0, 38), Position = UDim2.new(1, -44, 0, 4),
		BackgroundColor3 = Color3.fromRGB(200, 60, 60), Font = Enum.Font.FredokaOne,
		TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = "X", BorderSizePixel = 0,
	}, f)
	corner(close, 8)
	close.MouseButton1Click:Connect(function()
		f.Visible = false
	end)
	local scroll = make("ScrollingFrame", {
		Size = UDim2.new(1, -16, 1, -56), Position = UDim2.new(0, 8, 0, 50),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, CanvasSize = UDim2.new(0, 0, 0, 0),
	}, f)
	make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	panels[key] = { frame = f, scroll = scroll }
	return panels[key]
end
local function rowButton(scroll, text, color, onClick)
	local b = make("TextButton", {
		Size = UDim2.new(1, -8, 0, 50), BackgroundColor3 = color, Font = Enum.Font.FredokaOne,
		TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = text, BorderSizePixel = 0,
	}, scroll)
	corner(b, 10)
	b.MouseButton1Click:Connect(onClick)
	return b
end
local function clearRows(scroll)
	for _, c in scroll:GetChildren() do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
end
local function fixCanvas(panel)
	local count = 0
	for _, c in panel.scroll:GetChildren() do
		if c:IsA("TextButton") then
			count += 1
		end
	end
	panel.scroll.CanvasSize = UDim2.new(0, 0, 0, count * 56 + 10)
end

local casesPanel = shopPanel("cases", "📦 CASES")
local signalsPanel = shopPanel("auras", "📶 SIGNAL")
local itemsPanel = shopPanel("items", "🎒 ITEMS (+% Charge)")
local trainPanel = shopPanel("train", "🔌 CHARGERS")
local passPanel = shopPanel("shop", "🛒 SHOP")
local tpPanel = shopPanel("tp", "🌀 TELEPORT")
local questsPanel = shopPanel("quests", "🎖️ MEDAL QUESTS (daily)")
local stepsPanel = shopPanel("steps", "🔗 FAST-CHARGE LINKS (+⚡ per step)")

local function applyEffects()
	for _, other in Players:GetPlayers() do
		if other ~= player and other.Character then
			local hrp = other.Character:FindFirstChild("HumanoidRootPart")
			local trail = hrp and hrp:FindFirstChild("CaseTrail")
			if trail then
				trail.Enabled = effectsOn
			end
		end
	end
	local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	for _, part in workspace:GetChildren() do
		if part.Name == "Signal" and part:IsA("BasePart") then
			local mine = myHrp and (part.Position - myHrp.Position).Magnitude < 7
			if not mine then
				part.Transparency = effectsOn and 0.75 or 1
			end
		end
	end
end

local lastState = {}
local function refreshShops()
	local state = remotes.GetState:InvokeServer()
	lastState = state
	levelLabel.Text = "Level " .. (state.Level or 1)
	barText.Text = NumberFormat.format(state.LevelInto or 0) .. " / " .. NumberFormat.format(state.LevelBand or 100)
	barFill.Size = UDim2.new(math.clamp((state.LevelInto or 0) / math.max(state.LevelBand or 100, 1), 0, 1), 0, 1, 0)
	multLine.Text = "Case & Signal x" .. NumberFormat.format((state.CaseMult or 1) * (state.SignalMult or 1))
		.. "   •   Items x" .. tostring(state.ItemMult or 1)
		.. "   •   Phone x" .. NumberFormat.format(state.RebirthMult or 1)
		.. "   •   OS x" .. NumberFormat.format(state.AscendMult or 1)
		.. "   •   TOTAL x" .. NumberFormat.format(state.GainMult or 1)

	clearRows(casesPanel.scroll)
	for i, item in Config.CASES do
		local owned = (state.CasesOwned and table.find(state.CasesOwned, i)) or (item.pass and state[item.pass])
		local costText = item.pass and "👑 PASS (in 🛒 Shop)" or "🏆 " .. NumberFormat.format(item.cost)
		local text = item.name .. " x" .. NumberFormat.format(item.mult) .. (owned and " ✅" or " — " .. costText)
		rowButton(casesPanel.scroll, text, owned and Color3.fromRGB(70, 130, 70) or Color3.fromRGB(60, 60, 85), function()
			local _, msg = remotes.BuyCase:InvokeServer(i)
			showToast(msg)
			refreshShops()
		end)
	end
	fixCanvas(casesPanel)

	clearRows(signalsPanel.scroll)
	for i, item in Config.SIGNALS do
		local owned = (state.SignalsOwned and table.find(state.SignalsOwned, i)) or (item.pass and state[item.pass])
		local costText = item.pass and "👑 PASS (in 🛒 Shop)" or (item.cost == 0 and "FREE" or "🏆 " .. NumberFormat.format(item.cost))
		local text = item.name .. " x" .. item.mult .. (owned and " ✅" or " — " .. costText)
		rowButton(signalsPanel.scroll, text, owned and Color3.fromRGB(70, 130, 70) or Color3.fromRGB(60, 60, 85), function()
			local _, msg = remotes.BuySignal:InvokeServer(i)
			showToast(msg)
			refreshShops()
		end)
	end
	fixCanvas(signalsPanel)

	clearRows(itemsPanel.scroll)
	for i, item in Config.ITEMS do
		local owned = state.ItemsOwned and table.find(state.ItemsOwned, i)
		local text = item.name .. " (+" .. item.pct .. "% Charge)" .. (owned and " ✅" or " — 🏆 " .. NumberFormat.format(item.cost))
		rowButton(itemsPanel.scroll, text, owned and Color3.fromRGB(70, 130, 70) or Color3.fromRGB(60, 60, 85), function()
			local _, msg = remotes.BuyItem:InvokeServer(i)
			showToast(msg)
			refreshShops()
		end)
	end
	fixCanvas(itemsPanel)

	clearRows(trainPanel.scroll)
	for i, item in Config.CHARGERS do
		local owned = state.ChargersOwned and table.find(state.ChargersOwned, i)
		local level = (state.ChargerLevels and state.ChargerLevels[i]) or 0
		local outNow = EconomyClient.chargerOutput(item, level)
		if not owned then
			local costText = item.cost == -1 and "👑 VIP PASS" or (item.cost == 0 and "FREE" or "🏆 " .. NumberFormat.format(item.cost))
			rowButton(trainPanel.scroll, item.name .. " (+" .. NumberFormat.format(outNow) .. "/s) — " .. costText, Color3.fromRGB(60, 60, 85), function()
				local _, msg = remotes.UnlockCharger:InvokeServer(i)
				showToast(msg)
				refreshShops()
			end)
		elseif level >= Config.CHARGER_MAX_LEVEL then
			rowButton(trainPanel.scroll, item.name .. " Lv" .. level .. " ⭐ MAX (+" .. NumberFormat.format(outNow) .. "/s)", Color3.fromRGB(160, 130, 40), function() end)
		else
			local cost = EconomyClient.chargerUpgradeCost(item, level)
			local outNext = EconomyClient.chargerOutput(item, level + 1)
			local text = "⬆️ " .. item.name .. " Lv" .. level .. " (+" .. NumberFormat.format(outNow) .. "/s) → +" .. NumberFormat.format(outNext) .. "/s — 🏆 " .. NumberFormat.format(cost)
			rowButton(trainPanel.scroll, text, Color3.fromRGB(60, 60, 85), function()
				local _, msg = remotes.UpgradeCharger:InvokeServer(i)
				showToast(msg)
				refreshShops()
			end)
		end
	end
	fixCanvas(trainPanel)

	clearRows(passPanel.scroll)
	local passRows = {
		{ name = "⚡ Double Charge (x2 gains)", id = Config.PASSES.DoubleCharge },
		{ name = "🏆 Double Wins (x2)", id = Config.PASSES.DoubleWins },
		{ name = "👑 VIP (x3 gains + Gold Cable)", id = Config.PASSES.VIP },
		{ name = "♾️ INFINITY CASE (x" .. NumberFormat.format(Config.INFINITY_CASE.mult) .. ")", id = Config.PASSES.InfinityCase },
		{ name = "🌌 GALAXY CASE (x10)", id = Config.PASSES.GalaxyCase },
		{ name = "🌑 DARKNESS SIGNAL (x10)", id = Config.PASSES.DarknessSignal },
		{ name = "🔌 كابل ذهبي — GOLD CABLE (stations x3)", id = Config.PASSES.CableGold },
		{ name = "🔌 كابل ماسي — DIAMOND CABLE (stations x9)", id = Config.PASSES.CableDiamond },
		{ name = "🔌 كابل الحلوى — CANDY CABLE (stations x25)", id = Config.PASSES.CableCandy },
		{ name = "🔌 كابل الأدمين — ADMIN CABLE (stations x100)", id = Config.PASSES.CableAdmin },
	}
	for _, row in passRows do
		rowButton(passPanel.scroll, row.name, Color3.fromRGB(60, 60, 85), function()
			if row.id > 0 then
				MarketplaceService:PromptGamePassPurchase(player, row.id)
			else
				showToast("This pass is not set up yet")
			end
		end)
	end
	rowButton(passPanel.scroll, "🔊 Sound: " .. (soundOn and "ON" or "OFF"), Color3.fromRGB(90, 90, 110), function()
		soundOn = not soundOn
		refreshShops()
	end)
	rowButton(passPanel.scroll, "⏩ Skip Next Stage", Color3.fromRGB(180, 120, 30), function()
		if Config.PRODUCTS.SkipStage > 0 then
			MarketplaceService:PromptProductPurchase(player, Config.PRODUCTS.SkipStage)
		else
			showToast("Skip is not set up yet")
		end
	end)
	-- comfort settings (v4)
	rowButton(passPanel.scroll, "📷 Screen shake: " .. (shakeOn and "ON" or "OFF"), Color3.fromRGB(90, 90, 110), function()
		shakeOn = not shakeOn
		refreshShops()
	end)
	rowButton(passPanel.scroll, "👁 Others' effects: " .. (effectsOn and "ON" or "OFF"), Color3.fromRGB(90, 90, 110), function()
		effectsOn = not effectsOn
		applyEffects()
		refreshShops()
	end)
	fixCanvas(passPanel)

	-- quests (v4)
	local q = remotes.GetQuests:InvokeServer()
	clearRows(questsPanel.scroll)
	if q and q.quests then
		rowButton(questsPanel.scroll, "📅 Login streak: " .. (q.streak or 1) .. " day(s) — come back daily!", Color3.fromRGB(90, 90, 110), function() end)
		for _, quest in q.quests do
			local done = quest.progress >= quest.target
			local status = quest.claimed and " ✅ CLAIMED" or (done and " — TAP TO CLAIM!" or "")
			local text = quest.text .. " (" .. NumberFormat.format(math.min(quest.progress, quest.target)) .. "/" .. NumberFormat.format(quest.target) .. ")" .. status
			rowButton(questsPanel.scroll, text, quest.claimed and Color3.fromRGB(70, 130, 70) or Color3.fromRGB(60, 60, 85), function()
				local _, msg = remotes.ClaimQuest:InvokeServer(quest.id)
				showToast(msg)
				refreshShops()
			end)
		end
	end
	fixCanvas(questsPanel)

	-- step pads (v7)
	clearRows(stepsPanel.scroll)
	local curStep = state.StepIndex or 1
	for i, pad in Config.STEP_PADS do
		if i < curStep then
			rowButton(stepsPanel.scroll, "+" .. NumberFormat.format(pad.amount) .. " ⚡ / step ✅", Color3.fromRGB(70, 110, 70), function() end)
		elseif i == curStep then
			rowButton(stepsPanel.scroll, "▶ +" .. NumberFormat.format(pad.amount) .. " ⚡ / step (ACTIVE)", Color3.fromRGB(40, 140, 70), function() end)
		elseif i == curStep + 1 then
			rowButton(stepsPanel.scroll, "⬆️ +" .. NumberFormat.format(pad.amount) .. " ⚡ / step — 🏆 " .. NumberFormat.format(pad.cost), Color3.fromRGB(60, 60, 85), function()
				local _, msg = remotes.BuyStep:InvokeServer()
				showToast(msg)
				refreshShops()
			end)
		else
			rowButton(stepsPanel.scroll, "🔒 +" .. NumberFormat.format(pad.amount) .. " ⚡ / step — 🏆 " .. NumberFormat.format(pad.cost), Color3.fromRGB(45, 45, 60), function() end)
		end
	end
	fixCanvas(stepsPanel)

	clearRows(tpPanel.scroll)
	rowButton(tpPanel.scroll, "🏠 Lobby", Color3.fromRGB(60, 60, 85), function()
		remotes.Teleport:FireServer("lobby")
		tpPanel.frame.Visible = false
	end)
	rowButton(tpPanel.scroll, "🔒 World 2 — Social Apps (SOON)", Color3.fromRGB(70, 120, 190), function()
		remotes.Teleport:FireServer("world2")
		tpPanel.frame.Visible = false
	end)
	rowButton(tpPanel.scroll, "🚀 My next Stage", Color3.fromRGB(60, 60, 85), function()
		remotes.Teleport:FireServer("stage")
		tpPanel.frame.Visible = false
	end)
	fixCanvas(tpPanel)
end

local function toggle(panel)
	for _, p in panels do
		p.frame.Visible = (p == panel) and not panel.frame.Visible
	end
	if panel.frame.Visible then
		refreshShops()
	end
end
caseBtn.MouseButton1Click:Connect(function() toggle(casesPanel) end)
signalBtn.MouseButton1Click:Connect(function() toggle(signalsPanel) end)
itemBtn.MouseButton1Click:Connect(function() toggle(itemsPanel) end)
trainBtn.MouseButton1Click:Connect(function() toggle(trainPanel) end)
shopBtn.MouseButton1Click:Connect(function() toggle(passPanel) end)
tpBtn.MouseButton1Click:Connect(function() toggle(tpPanel) end)
questBtn.MouseButton1Click:Connect(function() toggle(questsPanel) end)
stepsBtn.MouseButton1Click:Connect(function() toggle(stepsPanel) end)
rebBtn.MouseButton1Click:Connect(function()
	local _, msg = remotes.UpgradePhone:InvokeServer()
	showToast(msg)
	refreshShops()
end)
ascBtn.MouseButton1Click:Connect(function()
	local _, msg = remotes.Ascend:InvokeServer()
	showToast(msg)
	refreshShops()
end)
giftBtn.MouseButton1Click:Connect(function()
	local _, msg = remotes.ClaimGift:InvokeServer()
	showToast(msg)
end)
codeBtn.MouseButton1Click:Connect(function()
	local code = string.upper(capBox.Text)
	if code == "" then
		showToast("Type a code in the cap box first — codes go there too 😉")
		return
	end
	local _, msg = remotes.RedeemCode:InvokeServer(code)
	showToast(msg)
end)

-- ===== stat sync + gate fading + level polling =====
local ls = player:WaitForChild("leaderstats")
local function refreshStats()
	bigSpeed.Text = NumberFormat.format(ls.Charge.Value) .. " ⚡"
	winsLabel.Text = "🏆 " .. NumberFormat.format(ls.Wins.Value)
	-- Gates fade when your LEVEL meets the requirement (v7 level gates).
	local level = ls:FindFirstChild("Level") and ls.Level.Value or 1
	local map = workspace:WaitForChild("PhoneMap")
	local stages = map:FindFirstChild("Stages")
	if stages then
		for _, stageFolder in stages:GetChildren() do
			local gate = stageFolder:FindFirstChild("Gate")
			if gate then
				local req = gate:GetAttribute("Requirement")
				if req then
					gate.Transparency = level >= req and 0.5 or 0
				end
			end
		end
	end
end
ls.Charge.Changed:Connect(refreshStats)
ls.Wins.Changed:Connect(refreshStats)
ls.Stage.Changed:Connect(refreshStats)
if ls:FindFirstChild("Level") then
	ls.Level.Changed:Connect(refreshStats)
end
refreshStats()

-- Pop sound on speed gains (v6)
ls.Charge.Changed:Connect(function()
	if soundOn and os.clock() - lastPop > 0.12 then
		lastPop = os.clock()
		popSound.PlaybackSpeed = 0.95 + math.random() * 0.15
		popSound:Play()
	end
end)

-- Objective + boost banner refresh (v6)
task.spawn(function()
	while true do
		local okState, st = pcall(function()
			return remotes.GetState:InvokeServer()
		end)
		if okState and st and st.Level then
			local stageNow = ls.Stage.Value
			local text
			local boostLeft = (st.BoostUntil or 0) - os.time()
			if stageNow < #Config.STAGE_LEVEL_REQS then
				local nxt = stageNow + 1
				text = "🎯 Next: Stage " .. nxt .. " — needs Level " .. Config.STAGE_LEVEL_REQS[nxt] .. " (you are " .. (st.Level or 1) .. ")"
			else
				text = "🏆 WORLD 1 BEATEN! 📱 Upgrade your phone / 🔄 OS Update to grow stronger"
			end
			if boostLeft > 0 then
				text = "🔥 BOOST x" .. (st.BoostMult or 1) .. " (" .. math.floor(boostLeft / 60) .. "m " .. (boostLeft % 60) .. "s)  •  " .. text
			end
			objective.Text = text
			if st.Battery then
				batteryFrame.Visible = true
				batteryFill.Size = UDim2.new(math.clamp(st.Battery / 100, 0, 1), 0, 1, 0)
				batteryFill.BackgroundColor3 = st.Battery > 50 and Color3.fromRGB(90, 255, 120) or (st.Battery > 25 and Color3.fromRGB(255, 200, 60) or Color3.fromRGB(255, 80, 60))
				batteryText.Text = "🔋 " .. st.Battery .. "%"
			else
				batteryFrame.Visible = false
			end
		end
		task.wait(2)
	end
end)

task.spawn(function()
	while true do
		refreshShops()
		applyEffects() -- keep "hide others' effects" true for players who joined later
		task.wait(4)
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="19">
