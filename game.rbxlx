      <Properties>
        <string name="Name">PhoneMap</string>
      </Properties>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Lobby</string>
        </Properties>
        <Item class="Part" referent="22">
          <Properties>
            <string name="Name">UnderSlab</string>
            <bool name="Anchored">true</bool>
            <CoordinateFrame name="CFrame">
              <X>0</X>
              <Y>-0.7</Y>
              <Z>34</Z>
              <R00>1</R00>
              <R01>0</R01>
              <R02>0</R02>
              <R10>0</R10>
              <R11>1</R11>
              <R12>0</R12>
              <R20>0</R20>
